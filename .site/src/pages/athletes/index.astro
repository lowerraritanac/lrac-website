---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { athletes } from "../../../data/athletes.js";
---

<BaseLayout
  title="Athletes | LRAC"
  description="Athletes of Lower Raritan Athletic Club."
>
  <section class="page-hero">
    <div class="section-inner">
      <p class="eyebrow">LOWER RARITAN ATHLETIC CLUB</p>

      <div class="hero-row">
        <h1>Athletes</h1>
        <span>{String(athletes.length).padStart(2, "0")}</span>
      </div>
    </div>
  </section>

  <section class="athletes-section">
    <div class="section-inner">
      <div class="athlete-grid">
        {
          athletes.map((athlete) => (
            <a class="athlete-card" href={`/athletes/${athlete.slug}`}>
              <div class="athlete-image">
                <img src={athlete.image} alt={athlete.name} />
              </div>

              <div class="athlete-info">
                <p class="sport">{athlete.sport}</p>

                <h2>{athlete.name}</h2>

                <p class="location">{athlete.location}</p>

                <p class="background">{athlete.background}</p>

                <div class="pr-preview">
                  {athlete.prs.slice(0, 3).map(([event, time]) => (
                    <p>
                      <strong>{time}</strong>
                      <span>{event}</span>
                    </p>
                  ))}
                </div>

                <span class="view-profile">View profile →</span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 40px;
  }

  .hero-row span {
    font-size: 14px;
    font-weight: 900;
    letter-spacing: 2px;
  }

  .athletes-section {
    padding: 90px 0 110px;
  }

  .athlete-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  .athlete-card {
    color: var(--black);
    text-decoration: none;
  }

  .athlete-image {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border: 1px solid var(--black);
    background: var(--black);
  }

  .athlete-image img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    filter: saturate(0.85) contrast(1.05);
    transition: transform 0.25s ease;
  }

  .athlete-card:hover .athlete-image img {
    transform: scale(1.02);
  }

  .athlete-info {
    padding-top: 16px;
  }

  .sport {
    margin: 0 0 7px;
    color: var(--mint-dark);
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .athlete-info h2 {
    margin: 0;
    font-size: 34px;
    line-height: 1;
    letter-spacing: -1.7px;
    text-transform: uppercase;
  }

  .location {
    margin: 8px 0 0;
    color: var(--gray);
    font-size: 13px;
  }

  .background {
    margin: 18px 0 0;
    padding-top: 15px;
    border-top: 1px solid var(--black);
    font-size: 14px;
    line-height: 1.5;
  }

  .pr-preview {
    margin-top: 16px;
  }

  .pr-preview p {
    margin: 5px 0;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    font-size: 13px;
  }

  .pr-preview span {
    color: var(--gray);
  }

  .view-profile {
    display: block;
    margin-top: 22px;
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }

  @media (max-width: 850px) {
    .hero-row {
      align-items: flex-end;
    }

    .athlete-grid {
      grid-template-columns: 1fr;
    }

    .athlete-info h2 {
      font-size: 30px;
    }
  }
</style>