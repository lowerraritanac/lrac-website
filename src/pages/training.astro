---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { weeklyMileage as liamWeekly, latestWeek as liamLatest } from "../../data/training.js";
import { weeklyMileage as aaronWeekly, latestWeek as aaronLatest } from "../../data/training-aaron.js";

import { weeklyMileage as gavinWeekly, latestWeek as gavinLatest } from "../../data/training-gavin.js";
import { weeklyMileage as maanWeekly, latestWeek as maanLatest } from "../../data/training-maan.js";
const addedAthletes = [
  { name: "Gavin Rossi", slug: "gavin-rossi", weekly: gavinWeekly, latest: gavinLatest },
  { name: "Maan Patel", slug: "maan-patel", weekly: maanWeekly, latest: maanLatest },
];
const posts = await getCollection("training");
const sortedPosts = [...posts]
  .filter((post) => post.data.visibility !== "athlete-only")
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const writing = sortedPosts.filter((post) => post.data.category === "Writing");
const trainingReports = sortedPosts.filter((post) => post.data.category === "Training Report");
const raceReports = sortedPosts.filter((post) => post.data.category === "Race Report");
const liamRolling4Miles = liamWeekly.slice(-4).reduce((sum, week) => sum + week.miles, 0) / 4;
const aaronRolling4Miles = aaronWeekly.slice(-4).reduce((sum, week) => sum + week.miles, 0) / 4;
---

<BaseLayout title="Training | LRAC" description="Writing, training reports, and athlete training data from Lower Raritan Athletic Club.">
  <section class="journal-intro">
    <div class="section-inner intro-grid">
      <div>
        <p class="eyebrow">LRAC Journal</p>
        <h1>Writing & Training</h1>
      </div>
    </div>
  </section>

  <section class="analytics-section">
    <div class="section-inner analytics-grid">
      <div class="analytics-heading">
        <h2>Athlete Training</h2>
      </div>

      <div class="athlete-training-list">
        <a class="athlete-training" href="/training/liam-tilton">
          <div class="athlete-name"><h3>Liam Tilton</h3></div>
          <div class="athlete-stats">
            <div><strong>{liamLatest.totalMiles}</strong><span>Latest miles</span></div>

            <div><strong>{liamRolling4Miles.toFixed(1)}</strong><span>4-week mi avg</span></div>

          </div>
          <span class="arrow">→</span>
        </a>

        <a class="athlete-training" href="/training/aaron-wysocki">
          <div class="athlete-name"><h3>Aaron Wysocki</h3></div>
          <div class="athlete-stats">
            <div><strong>{aaronLatest.totalMiles}</strong><span>Latest miles</span></div>

            <div><strong>{aaronRolling4Miles.toFixed(1)}</strong><span>4-week mi avg</span></div>

          </div>
          <span class="arrow">→</span>
        </a>
        {addedAthletes.map((athlete) => (
          <a class="athlete-training" href={`/training/${athlete.slug}`}>
            <div class="athlete-name"><h3>{athlete.name}</h3></div>
            <div class="athlete-stats">
              <div><strong>{athlete.latest.totalMiles}</strong><span>Latest miles</span></div>
              <div><strong>{(athlete.weekly.slice(-4).reduce((sum, week) => sum + week.miles, 0) / 4).toFixed(1)}</strong><span>4-week mi avg</span></div>

            </div>
            <span class="arrow">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {trainingReports.length > 0 && (
    <section class="index-section alt">
      <div class="section-inner index-grid">
        <div class="index-heading"><p class="section-label">Training Reports</p><h2>Reports</h2></div>
        <div class="entries">
          {trainingReports.map((post) => (
            <a class="entry" href={`/training/${post.id}`}>
              <div class="entry-date">{post.data.date.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}</div>
              <div><h3>{post.data.title}</h3>{post.data.description && <p>{post.data.description}</p>}</div>
              <span>→</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {writing.length > 0 && (
    <section class="index-section">
      <div class="section-inner index-grid">
        <div class="index-heading"><p class="section-label">Writing</p><h2>Essays</h2></div>
        <div class="entries">
          {writing.map((post) => (
            <a class="entry" href={`/training/${post.id}`}>
              <div class="entry-date">{post.data.date.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}</div>
              <div><h3>{post.data.title}</h3>{post.data.description && <p>{post.data.description}</p>}</div>
              <span>→</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {raceReports.length > 0 && (
    <section class="index-section dark">
      <div class="section-inner index-grid">
        <div class="index-heading"><p class="section-label">Race Reports</p><h2>Races</h2></div>
        <div class="entries">
          {raceReports.map((post) => (
            <a class="entry" href={`/training/${post.id}`}>
              <div class="entry-date">{post.data.date.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}</div>
              <div><h3>{post.data.title}</h3>{post.data.description && <p>{post.data.description}</p>}</div>
              <span>→</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .journal-intro { padding: 30px 0; border-bottom: 1px solid var(--ink); }
  .intro-grid { display: grid; grid-template-columns: 1fr; }
  .journal-intro h1 { margin: 10px 0 0; font-size: clamp(36px, 5vw, 60px); line-height: 1; letter-spacing: -.035em; }
  .analytics-section { padding: 28px 0 32px; background: var(--paper); border-bottom: 1px solid var(--ink); }
  .analytics-grid { display: grid; grid-template-columns: 1fr; gap: 16px; }
  .analytics-heading h2 { margin: 0; font-size: 26px; line-height: 1.1; letter-spacing: -.025em; }
  .athlete-training-list { border-top: 1px solid var(--ink); }
  .athlete-training { display: grid; grid-template-columns: minmax(150px, .8fr) minmax(0, 2fr) 20px; gap: 20px; align-items: center; padding: 18px 0; border-bottom: 1px solid var(--ink); color: var(--ink); text-decoration: none; }
  .athlete-name { min-width: 0; }
  .athlete-name h3 { margin: 0; font-size: 24px; line-height: 1.15; }
  .athlete-stats { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .athlete-stats > div { min-width: 0; }
  .athlete-stats strong, .athlete-stats span { display: block; font-family: var(--mono); }
  .athlete-stats strong { font-size: 19px; line-height: 1.2; }
  .athlete-stats span { margin-top: 4px; color: var(--gray); font-size: 9px; line-height: 1.4; text-transform: uppercase; }
  .arrow { font-family: var(--mono); font-size: 16px; text-align: right; }
  .athlete-training:hover h3, .athlete-training:hover .arrow { color: var(--mint-dark); }
  .index-section { padding: 32px 0 40px; border-top: 1px solid var(--ink); }
  .index-section.alt { background: var(--beige); }
  .index-section.dark { background: var(--ink); color: var(--white); }
  .index-grid { display: grid; grid-template-columns: 180px 1fr; gap: 32px; }
  .index-heading h2 { margin: 10px 0 0; font-size: 36px; line-height: .95; letter-spacing: -.035em; }
  .entries { border-top: 1px solid currentColor; }
  .entry { display: grid; grid-template-columns: 150px 1fr auto; gap: 26px; align-items: start; padding: 18px 0; border-bottom: 1px solid currentColor; color: inherit; text-decoration: none; }
  .entry-date { font-family: var(--mono); font-size: 9px; text-transform: uppercase; }
  .entry h3 { margin: 0; font-size: clamp(24px, 2.5vw, 32px); line-height: 1; letter-spacing: -.025em; }
  .entry p { max-width: 610px; margin: 8px 0 0; color: var(--gray); font-size: 15px; line-height: 1.45; }
  .dark .entry p { color: #aaa; }
  .entry > span { font-family: var(--mono); }
  .entry:hover h3 { color: var(--mint-dark); }
  .dark .entry:hover h3 { color: var(--mint); }
  @media (max-width: 850px) {
    .index-grid { grid-template-columns: 1fr; gap: 20px; }
    .entry { grid-template-columns: 1fr auto; gap: 10px; }
    .entry-date { grid-column: 1 / -1; }
  }
  @media (max-width: 600px) {
    .journal-intro { padding: 24px 0; }
    .analytics-section, .index-section { padding: 24px 0; }
    .athlete-training { grid-template-columns: 1fr 20px; gap: 12px; padding: 16px 0; }
    .athlete-name h3 { font-size: 23px; }
    .athlete-stats { grid-row: 2; grid-column: 1 / -1; gap: 8px; }
    .athlete-stats strong { font-size: 18px; }
    .athlete-stats span { font-size: 8px; }
    .arrow { grid-row: 1; grid-column: 2; }
  }
</style>
