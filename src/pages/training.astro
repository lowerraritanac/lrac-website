---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { getStravaMileage } from "../lib/strava.js";

const posts = await getCollection("training");
const sortedPosts = [...posts].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const writing = sortedPosts.filter((post) => post.data.category === "Writing");
const trainingReports = sortedPosts.filter((post) => post.data.category === "Training Report");
const raceReports = sortedPosts.filter((post) => post.data.category === "Race Report");
const strava = await getStravaMileage({ weeks: 16 });
---

<BaseLayout title="Training | LRAC" description="Writing, training reports, and race reports from Lower Raritan Athletic Club.">
  <section class="journal-intro">
    <div class="section-inner intro-grid">
      <div>
        <p class="eyebrow">LRAC Journal</p>
        <h1>Writing & Training</h1>
      </div>
    </div>
  </section>

  {strava && (
    <section class="analytics-section">
      <div class="section-inner analytics-grid">
        <div class="analytics-heading">
          <p class="section-label">Training Analytics</p>
          <h2>Mileage</h2>
          <p class="source">{strava.athleteName} · Source: Strava</p>
        </div>

        <div class="analytics-main">
          <div class="analytics-stats">
            <div><strong>{strava.rolling4}</strong><span>4-week avg</span></div>
            <div><strong>{strava.twelveWeekMiles}</strong><span>12-week miles</span></div>
            <div><strong>{strava.highWeek.miles}</strong><span>High week · {strava.highWeek.label}</span></div>
          </div>

          <div class="mileage-chart" aria-label="Weekly running mileage from Strava">
            {strava.weekly.map((week) => (
              <div class="chart-column" title={`${week.label}: ${week.miles} miles`}>
                <div class="bar-space">
                  <div class="bar" style={`height: ${(week.miles / strava.maxMiles) * 100}%`}></div>
                </div>
                <strong>{week.miles}</strong>
                <span>{week.label}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}

  {writing.length > 0 && (
    <section class="index-section">
      <div class="section-inner index-grid">
        <div class="index-heading"><p class="section-label">01 / Writing</p><h2>Essays</h2></div>
        <div class="entries">
          {writing.map((post) => (
            <a class="entry" href={`/training/${post.id}`}>
              <div class="entry-date">{post.data.date.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}</div>
              <div><h3>{post.data.title}</h3>{post.data.description && <p>{post.data.description}</p>}</div>
              <span>→</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {trainingReports.length > 0 && (
    <section class="index-section alt">
      <div class="section-inner index-grid">
        <div class="index-heading"><p class="section-label">02 / Training Reports</p><h2>Training Reports</h2></div>
        <div class="entries">
          {trainingReports.map((post) => (
            <a class="entry" href={`/training/${post.id}`}>
              <div class="entry-date">{post.data.date.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}</div>
              <div><h3>{post.data.title}</h3>{post.data.description && <p>{post.data.description}</p>}</div>
              <span>→</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {raceReports.length > 0 && (
    <section class="index-section dark">
      <div class="section-inner index-grid">
        <div class="index-heading"><p class="section-label">03 / Race Reports</p><h2>Race Reports</h2></div>
        <div class="entries">
          {raceReports.map((post) => (
            <a class="entry" href={`/training/${post.id}`}>
              <div class="entry-date">{post.data.date.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}</div>
              <div><h3>{post.data.title}</h3>{post.data.description && <p>{post.data.description}</p>}</div>
              <span>→</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .journal-intro { padding: 62px 0 54px; border-bottom: 1px solid var(--ink); }
  .intro-grid { display: grid; grid-template-columns: 1fr; }
  .journal-intro h1 { margin: 16px 0 0; max-width: 820px; font-size: clamp(54px, 7vw, 96px); line-height: .92; letter-spacing: -.045em; }

  .analytics-section { padding: 66px 0 74px; background: var(--paper); border-bottom: 1px solid var(--ink); }
  .analytics-grid { display: grid; grid-template-columns: 260px 1fr; gap: 58px; }
  .analytics-heading h2 { margin: 18px 0 10px; font-size: clamp(44px, 5vw, 66px); line-height: .95; letter-spacing: -.035em; }
  .source { margin: 0; color: var(--gray); font-family: var(--mono); font-size: 9px; line-height: 1.5; text-transform: uppercase; }
  .analytics-stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--ink); border-bottom: 1px solid var(--ink); }
  .analytics-stats > div { padding: 18px 18px 16px 0; }
  .analytics-stats > div + div { padding-left: 18px; border-left: 1px solid var(--ink); }
  .analytics-stats strong, .analytics-stats span { display: block; }
  .analytics-stats strong { font-family: var(--mono); font-size: clamp(24px, 3vw, 36px); line-height: 1; }
  .analytics-stats span { margin-top: 7px; color: var(--gray); font-family: var(--mono); font-size: 8px; line-height: 1.35; text-transform: uppercase; }

  .mileage-chart { display: grid; grid-template-columns: repeat(16, minmax(0, 1fr)); gap: 6px; margin-top: 30px; align-items: end; overflow-x: auto; padding-bottom: 4px; }
  .chart-column { min-width: 34px; text-align: center; }
  .bar-space { display: flex; align-items: flex-end; height: 190px; border-bottom: 1px solid var(--ink); }
  .bar { width: 100%; min-height: 2px; background: var(--mint-dark); }
  .chart-column strong { display: block; margin-top: 7px; font-family: var(--mono); font-size: 8px; font-weight: 600; }
  .chart-column span { display: block; margin-top: 4px; color: var(--gray); font-family: var(--mono); font-size: 7px; line-height: 1.2; text-transform: uppercase; }

  .index-section { padding: 66px 0 78px; }
  .index-section.alt { background: var(--beige); border-top: 1px solid var(--ink); }
  .index-section.dark { background: var(--ink); color: var(--white); }
  .index-grid { display: grid; grid-template-columns: 260px 1fr; gap: 58px; }
  .index-heading h2 { margin: 18px 0 0; font-size: clamp(44px, 5vw, 66px); line-height: .95; letter-spacing: -.035em; }
  .entries { border-top: 1px solid currentColor; }
  .entry { display: grid; grid-template-columns: 150px 1fr auto; gap: 26px; align-items: start; padding: 23px 0; border-bottom: 1px solid currentColor; color: inherit; text-decoration: none; }
  .entry-date { font-family: var(--mono); font-size: 9px; text-transform: uppercase; }
  .entry h3 { margin: 0; font-size: clamp(28px, 3.2vw, 42px); line-height: 1; letter-spacing: -.025em; }
  .entry p { max-width: 610px; margin: 8px 0 0; color: var(--gray); font-size: 15px; line-height: 1.45; }
  .dark .entry p { color: #aaa; }
  .entry > span { font-family: var(--mono); }
  .entry:hover h3 { color: var(--mint-dark); }
  .dark .entry:hover h3 { color: var(--mint); }

  @media (max-width: 850px) {
    .journal-intro { padding: 44px 0 42px; }
    .analytics-grid, .index-grid { grid-template-columns: 1fr; gap: 30px; }
    .journal-intro h1 { font-size: clamp(46px, 13vw, 64px); }
    .analytics-section, .index-section { padding: 52px 0 60px; }
    .analytics-stats { grid-template-columns: 1fr; }
    .analytics-stats > div, .analytics-stats > div + div { padding: 14px 0; border-left: 0; border-bottom: 1px solid var(--ink); }
    .analytics-stats > div:last-child { border-bottom: 0; }
    .mileage-chart { grid-template-columns: repeat(16, 38px); gap: 7px; }
    .bar-space { height: 150px; }
    .entry { grid-template-columns: 1fr auto; gap: 16px; }
    .entry-date { grid-column: 1 / -1; }
  }
</style>
