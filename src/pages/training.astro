---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("training");

const sortedPosts = [...posts].sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const writing = sortedPosts.filter(
  (post) => post.data.category === "Writing"
);

const trainingReports = sortedPosts.filter(
  (post) => post.data.category === "Training Report"
);

const raceReports = sortedPosts.filter(
  (post) => post.data.category === "Race Report"
);
---

<BaseLayout
  title="Training | LRAC"
  description="Training, writing, and race reports from Lower Raritan Athletic Club."
>
  <section class="page-hero">
    <div class="section-inner">
      <p class="eyebrow">LOWER RARITAN ATHLETIC CLUB</p>
      <h1>Training</h1>
    </div>
  </section>

  <section class="training-section">
    <div class="section-inner">
      <div class="section-heading">
        <p class="section-label">WRITING</p>
        <h2>Ideas & Notes</h2>
      </div>

      <div class="post-list">
        {writing.map((post) => (
          <a class="post-row" href={`/training/${post.id}`}>
            <div>
              <p class="meta">
                {post.data.athlete} · {post.data.date.toLocaleDateString("en-US", { month: "long", year: "numeric" })}
              </p>
              <h3>{post.data.title}</h3>
              <p class="description">{post.data.description}</p>
            </div>
            <span class="arrow">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="training-section alt">
    <div class="section-inner">
      <div class="section-heading">
        <p class="section-label">TRAINING REPORTS</p>
        <h2>The Work</h2>
      </div>

      <div class="post-list">
        {trainingReports.map((post) => (
          <a class="post-row" href={`/training/${post.id}`}>
            <div>
              <p class="meta">
                {post.data.athlete} · {post.data.date.toLocaleDateString("en-US", { month: "long", year: "numeric" })}
              </p>
              <h3>{post.data.title}</h3>
              <p class="description">{post.data.description}</p>
            </div>
            <span class="arrow">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="training-section dark">
    <div class="section-inner">
      <div class="section-heading">
        <p class="section-label">RACE REPORTS</p>
        <h2>Competition</h2>
      </div>

      <div class="post-list">
        {raceReports.map((post) => (
          <a class="post-row" href={`/training/${post.id}`}>
            <div>
              <p class="meta">
                {post.data.athlete} · {post.data.date.toLocaleDateString("en-US", { month: "long", year: "numeric" })}
              </p>
              <h3>{post.data.title}</h3>
              <p class="description">{post.data.description}</p>
            </div>
            <span class="arrow">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .training-section { padding: 90px 0 110px; }
  .training-section.alt { background: var(--beige-light); border-top: 1px solid var(--black); }
  .training-section.dark { background: var(--black); color: var(--white); }
  .section-heading { margin-bottom: 42px; }
  .section-heading h2 { margin: 10px 0 0; font-size: clamp(48px, 7vw, 86px); line-height: 0.9; letter-spacing: -4px; text-transform: uppercase; }
  .post-list { border-top: 1px solid currentColor; }
  .post-row { display: grid; grid-template-columns: 1fr auto; gap: 40px; align-items: center; padding: 30px 0; border-bottom: 1px solid currentColor; color: inherit; text-decoration: none; }
  .meta { margin: 0 0 8px; font-size: 10px; font-weight: 900; letter-spacing: 1.7px; text-transform: uppercase; }
  .post-row h3 { margin: 0; font-size: clamp(28px, 4vw, 46px); line-height: 1; letter-spacing: -2px; text-transform: uppercase; }
  .description { max-width: 700px; margin: 12px 0 0; color: var(--gray); font-size: 14px; line-height: 1.5; }
  .dark .description { color: #aaa; }
  .arrow { font-size: 30px; }
  .post-row:hover { opacity: 0.55; }
  @media (max-width: 850px) {
    .training-section { padding: 70px 0 80px; }
    .section-heading h2 { font-size: 52px; letter-spacing: -3px; }
    .post-row { gap: 18px; }
    .post-row h3 { font-size: 30px; letter-spacing: -1.5px; }
  }
</style>
