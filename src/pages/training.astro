---
import BaseLayout from "../layouts/BaseLayout.astro";
import { trainingPosts } from "../../data/training.js";
---

<BaseLayout
  title="Training | LRAC"
  description="Training notes and sessions from Lower Raritan Athletic Club."
>
  <section class="page-hero">
    <div class="section-inner">
      <p class="eyebrow">FROM THE CLUB</p>
      <h1>Training</h1>
    </div>
  </section>

  <section class="training-section">
    <div class="section-inner">
      <div class="training-grid">
        {
          trainingPosts.map((post) => (
            <article class="training-card">
              <p class="type">{post.type}</p>

              <h2>{post.title}</h2>

              <p class="description">
                {post.description}
              </p>

              <a href={`/training/${post.slug}`}>
                Read →
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .training-section {
    padding: 90px 0 110px;
  }

  .training-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  .training-card {
    min-height: 420px;
    padding: 28px;
    background: var(--white);
    border: 1px solid var(--black);
    display: flex;
    flex-direction: column;
  }

  .type {
    margin: 0;
    color: var(--mint-dark);
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .training-card h2 {
    margin: 50px 0 18px;
    font-size: 40px;
    line-height: 0.98;
    letter-spacing: -2px;
    text-transform: uppercase;
  }

  .description {
    margin: 0;
    color: var(--gray);
    font-size: 16px;
    line-height: 1.6;
  }

  .training-card a {
    margin-top: auto;
    text-decoration: none;
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 1.4px;
    text-transform: uppercase;
  }

  .training-card a:hover {
    opacity: 0.5;
  }

  @media (max-width: 850px) {
    .training-grid {
      grid-template-columns: 1fr;
    }
  }
</style>