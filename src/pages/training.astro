---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("training");
const sortedPosts = [...posts].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const writing = sortedPosts.filter((post) => post.data.category === "Writing");
const trainingReports = sortedPosts.filter((post) => post.data.category === "Training Report");
const raceReports = sortedPosts.filter((post) => post.data.category === "Race Report");
---

<BaseLayout title="Training | LRAC" description="Writing, training reports, and race reports from Lower Raritan Athletic Club.">
  <section class="page-hero training-hero">
    <div class="section-inner hero-grid">
      <div>
        <p class="eyebrow">LOWER RARITAN ATHLETIC CLUB</p>
        <h1>Training</h1>
      </div>
      <p class="hero-copy">Athlete-written notes on training, race preparation, weekly work, and what we are learning from the process.</p>
    </div>
  </section>

  <section class="writing-section">
    <div class="section-inner">
      <div class="section-heading"><p class="section-label">01 · WRITING</p><h2>Long Form</h2></div>
      <div class="feature-list">
        {writing.map((post) => (
          <a class="feature-post" href={`/training/${post.id}`}>
            <div class="feature-meta"><span>{post.data.athlete}</span><span>{post.data.date.toLocaleDateString("en-US", { month: "long", year: "numeric" })}</span></div>
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
            <span class="read">Read article →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="reports-section">
    <div class="section-inner">
      <div class="section-heading"><p class="section-label">02 · TRAINING REPORTS</p><h2>The Work</h2></div>
      <div class="post-list">
        {trainingReports.map((post) => (
          <a class="post-row" href={`/training/${post.id}`}>
            <div><p class="meta">{post.data.athlete} · {post.data.date.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" })}</p><h3>{post.data.title}</h3><p class="description">{post.data.description}</p></div>
            <span class="arrow">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="race-report-section">
    <div class="section-inner">
      <div class="section-heading"><p class="section-label">03 · RACE REPORTS</p><h2>Competition</h2></div>
      <div class="post-list">
        {raceReports.map((post) => (
          <a class="post-row" href={`/training/${post.id}`}>
            <div><p class="meta">{post.data.athlete} · {post.data.date.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" })}</p><h3>{post.data.title}</h3><p class="description">{post.data.description}</p></div>
            <span class="arrow">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .training-hero { padding-bottom: 68px; }
  .hero-grid { display: grid; grid-template-columns: 1.4fr .6fr; gap: 70px; align-items: end; }
  .hero-copy { margin: 0; padding-top: 18px; border-top: 1px solid var(--black); font-size: 15px; line-height: 1.55; }
  .writing-section, .reports-section, .race-report-section { padding: 86px 0 104px; }
  .writing-section { background: var(--beige-light); }
  .reports-section { background: var(--beige); border-top: 1px solid var(--black); }
  .race-report-section { background: var(--black); color: var(--white); }
  .section-heading { margin-bottom: 36px; }
  .section-heading h2 { margin: 8px 0 0; font-size: clamp(58px, 8vw, 104px); line-height: .8; letter-spacing: -4px; text-transform: uppercase; }
  .feature-list { border-top: 1px solid var(--black); }
  .feature-post { display: block; padding: 34px 0 42px; border-bottom: 1px solid var(--black); color: var(--black); text-decoration: none; }
  .feature-meta { display: flex; justify-content: space-between; gap: 20px; font-size: 9px; font-weight: 900; letter-spacing: 1.3px; text-transform: uppercase; }
  .feature-post h3 { max-width: 980px; margin: 42px 0 16px; font-size: clamp(54px, 7vw, 94px); line-height: .84; letter-spacing: -4px; text-transform: uppercase; }
  .feature-post p { max-width: 720px; margin: 0; color: var(--gray); font-size: 16px; line-height: 1.6; }
  .read { display: inline-block; margin-top: 30px; font-size: 10px; font-weight: 900; letter-spacing: 1.2px; text-transform: uppercase; }
  .feature-post:hover { background: var(--mint); }
  .post-list { border-top: 1px solid currentColor; }
  .post-row { display: grid; grid-template-columns: 1fr auto; gap: 40px; align-items: center; padding: 26px 0; border-bottom: 1px solid currentColor; color: inherit; text-decoration: none; }
  .meta { margin: 0 0 6px; font-size: 9px; font-weight: 900; letter-spacing: 1.5px; text-transform: uppercase; }
  .post-row h3 { margin: 0; font-size: clamp(30px, 4vw, 48px); line-height: .92; letter-spacing: -2px; text-transform: uppercase; }
  .description { max-width: 720px; margin: 10px 0 0; color: var(--gray); font-size: 13px; line-height: 1.5; }
  .race-report-section .description { color: #aaa; }
  .arrow { font-size: 28px; }
  .post-row:hover { opacity: .55; }
  @media (max-width: 850px) {
    .hero-grid { grid-template-columns: 1fr; gap: 28px; }
    .writing-section, .reports-section, .race-report-section { padding: 64px 0 76px; }
    .section-heading h2 { font-size: 56px; letter-spacing: -2.5px; }
    .feature-post h3 { margin-top: 28px; font-size: 52px; letter-spacing: -2.5px; }
    .feature-meta { flex-direction: column; gap: 5px; }
  }
</style>
