---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { weeklyMileage as liamWeekly, latestWeek as liamLatest } from "../../data/training.js";
import { weeklyMileage as aaronWeekly, latestWeek as aaronLatest } from "../../data/training-aaron.js";

const posts = await getCollection("training");
const sortedPosts = [...posts].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const writing = sortedPosts.filter((post) => post.data.category === "Writing");
const trainingReports = sortedPosts.filter((post) => post.data.category === "Training Report");
const raceReports = sortedPosts.filter((post) => post.data.category === "Race Report");
const liamRolling4Miles = liamWeekly.slice(-4).reduce((sum, week) => sum + week.miles, 0) / 4;
const liamRolling4Hours = liamWeekly.slice(-4).reduce((sum, week) => sum + week.hours, 0) / 4;
const aaronRolling4Miles = aaronWeekly.slice(-4).reduce((sum, week) => sum + week.miles, 0) / 4;
const aaronRolling4Hours = aaronWeekly.slice(-4).reduce((sum, week) => sum + week.hours, 0) / 4;
---

<BaseLayout title="Training | LRAC" description="Writing, training reports, and athlete training data from Lower Raritan Athletic Club.">
  <section class="journal-intro">
    <div class="section-inner intro-grid">
      <div>
        <p class="eyebrow">LRAC Journal</p>
        <h1>Writing & Training</h1>
      </div>
    </div>
  </section>

  <section class="analytics-section">
    <div class="section-inner analytics-grid">
      <div class="analytics-heading">
        <p class="section-label">Training Analytics</p>
        <h2>Volume</h2>
      </div>

      <div class="athlete-training-list">
        <a class="athlete-training" href="/training/liam-tilton">
          <div class="athlete-number">01</div>
          <div class="athlete-name">
            <h3>Liam Tilton</h3>
            <span>Distance Running</span>
          </div>
          <div class="athlete-stats">
            <div><strong>{liamLatest.totalMiles}</strong><span>Latest miles</span></div>
            <div><strong>{liamLatest.totalHours.toFixed(1)}</strong><span>Latest hours</span></div>
            <div><strong>{liamRolling4Miles.toFixed(1)}</strong><span>4-week mi avg</span></div>
            <div><strong>{liamRolling4Hours.toFixed(1)}</strong><span>4-week hr avg</span></div>
          </div>
          <span class="arrow">→</span>
        </a>

        <a class="athlete-training" href="/training/aaron-wysocki">
          <div class="athlete-number">02</div>
          <div class="athlete-name">
            <h3>Aaron Wysocki</h3>
            <span>Distance Running</span>
          </div>
          <div class="athlete-stats">
            <div><strong>{aaronLatest.totalMiles}</strong><span>Latest miles</span></div>
            <div><strong>{aaronLatest.totalHours.toFixed(1)}</strong><span>Latest hours</span></div>
            <div><strong>{aaronRolling4Miles.toFixed(1)}</strong><span>4-week mi avg</span></div>
            <div><strong>{aaronRolling4Hours.toFixed(1)}</strong><span>4-week hr avg</span></div>
          </div>
          <span class="arrow">→</span>
        </a>
      </div>
    </div>
  </section>

  {writing.length > 0 && (
    <section class="index-section">
      <div class="section-inner index-grid">
        <div class="index-heading"><p class="section-label">01 / Writing</p><h2>Essays</h2></div>
        <div class="entries">
          {writing.map((post) => (
            <a class="entry" href={`/training/${post.id}`}>
              <div class="entry-date">{post.data.date.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}</div>
              <div><h3>{post.data.title}</h3>{post.data.description && <p>{post.data.description}</p>}</div>
              <span>→</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {trainingReports.length > 0 && (
    <section class="index-section alt">
      <div class="section-inner index-grid">
        <div class="index-heading"><p class="section-label">02 / Training Reports</p><h2>Training Reports</h2></div>
        <div class="entries">
          {trainingReports.map((post) => (
            <a class="entry" href={`/training/${post.id}`}>
              <div class="entry-date">{post.data.date.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}</div>
              <div><h3>{post.data.title}</h3>{post.data.description && <p>{post.data.description}</p>}</div>
              <span>→</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {raceReports.length > 0 && (
    <section class="index-section dark">
      <div class="section-inner index-grid">
        <div class="index-heading"><p class="section-label">03 / Race Reports</p><h2>Race Reports</h2></div>
        <div class="entries">
          {raceReports.map((post) => (
            <a class="entry" href={`/training/${post.id}`}>
              <div class="entry-date">{post.data.date.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}</div>
              <div><h3>{post.data.title}</h3>{post.data.description && <p>{post.data.description}</p>}</div>
              <span>→</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .journal-intro { padding: 62px 0 54px; border-bottom: 1px solid var(--ink); }
  .intro-grid { display: grid; grid-template-columns: 1fr; }
  .journal-intro h1 { margin: 16px 0 0; max-width: 820px; font-size: clamp(54px, 7vw, 96px); line-height: .92; letter-spacing: -.045em; }
  .analytics-section { padding: 56px 0 62px; background: var(--paper); border-bottom: 1px solid var(--ink); }
  .analytics-grid { display: grid; grid-template-columns: 260px 1fr; gap: 58px; }
  .analytics-heading h2 { margin: 18px 0 0; font-size: clamp(44px, 5vw, 66px); line-height: .95; letter-spacing: -.035em; }
  .athlete-training-list { border-top: 1px solid var(--ink); }
  .athlete-training { display: grid; grid-template-columns: 44px 220px 1fr auto; gap: 24px; align-items: center; padding: 22px 0; border-bottom: 1px solid var(--ink); color: var(--ink); text-decoration: none; }
  .athlete-number, .athlete-name span, .arrow { font-family: var(--mono); font-size: 8px; text-transform: uppercase; }
  .athlete-name h3 { margin: 0 0 5px; font-size: clamp(27px, 2.8vw, 38px); line-height: 1; }
  .athlete-name span { color: var(--gray); }
  .athlete-stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .athlete-stats > div { padding: 0 16px; border-left: 1px solid var(--ink); }
  .athlete-stats strong, .athlete-stats span { display: block; font-family: var(--mono); }
  .athlete-stats strong { font-size: 18px; line-height: 1; }
  .athlete-stats span { margin-top: 5px; color: var(--gray); font-size: 7px; text-transform: uppercase; }
  .athlete-training:hover h3 { color: var(--mint-dark); }
  .index-section { padding: 66px 0 78px; }
  .index-section.alt { background: var(--beige); border-top: 1px solid var(--ink); }
  .index-section.dark { background: var(--ink); color: var(--white); }
  .index-grid { display: grid; grid-template-columns: 260px 1fr; gap: 58px; }
  .index-heading h2 { margin: 18px 0 0; font-size: clamp(44px, 5vw, 66px); line-height: .95; letter-spacing: -.035em; }
  .entries { border-top: 1px solid currentColor; }
  .entry { display: grid; grid-template-columns: 150px 1fr auto; gap: 26px; align-items: start; padding: 23px 0; border-bottom: 1px solid currentColor; color: inherit; text-decoration: none; }
  .entry-date { font-family: var(--mono); font-size: 9px; text-transform: uppercase; }
  .entry h3 { margin: 0; font-size: clamp(28px, 3.2vw, 42px); line-height: 1; letter-spacing: -.025em; }
  .entry p { max-width: 610px; margin: 8px 0 0; color: var(--gray); font-size: 15px; line-height: 1.45; }
  .dark .entry p { color: #aaa; }
  .entry > span { font-family: var(--mono); }
  .entry:hover h3 { color: var(--mint-dark); }
  .dark .entry:hover h3 { color: var(--mint); }
  @media (max-width: 850px) {
    .journal-intro { padding: 44px 0 42px; }
    .analytics-grid, .index-grid { grid-template-columns: 1fr; gap: 30px; }
    .journal-intro h1 { font-size: clamp(46px, 13vw, 64px); }
    .analytics-section, .index-section { padding: 52px 0 60px; }
    .athlete-training { grid-template-columns: 34px 1fr auto; gap: 14px; align-items: start; }
    .athlete-stats { grid-column: 2 / -1; grid-template-columns: repeat(2, 1fr); gap: 14px 0; }
    .athlete-stats > div:nth-child(odd) { border-left: 0; padding-left: 0; }
    .entry { grid-template-columns: 1fr auto; gap: 16px; }
    .entry-date { grid-column: 1 / -1; }
  }
</style>
