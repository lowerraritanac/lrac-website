---
import BaseLayout from "../layouts/BaseLayout.astro";
import { athletes } from "../../data/athletes.js";
---

<BaseLayout
  title="About | LRAC"
  description="About Lower Raritan Athletic Club."
>
  <section class="page-hero">
    <div class="section-inner">
      <p class="eyebrow">LOWER RARITAN ATHLETIC CLUB</p>
      <h1>About</h1>
    </div>
  </section>

  <section class="intro-section">
    <div class="section-inner intro-grid">

      <div>
        <p class="section-label">THE CLUB</p>
      </div>

      <div>
        <p class="intro-copy">
          Lower Raritan Athletic Club is an independent endurance club
          built by athletes continuing to train and compete beyond
          collegiate sport.
        </p>
      </div>

    </div>
  </section>

  <section class="story-section">
    <div class="section-inner story-grid">

      <div>
        <p class="section-label">ORIGIN</p>
        <h2>New Jersey Roots</h2>
      </div>

      <div class="story-copy">
        <p>
          LRAC started in New Jersey around athletes who wanted to keep
          pursuing competitive sport after college without giving up the
          independence of training on their own terms.
        </p>

        <p>
          The club currently includes athletes in distance running and
          rowing, with members training and competing in different parts
          of the country.
        </p>

        <p>
          The goal is simple: keep training seriously, race at a high
          level, and document the process along the way.
        </p>
      </div>

    </div>
  </section>

  <section class="numbers-section">
    <div class="section-inner">

      <div class="numbers-grid">

        <div class="number-block">
          <strong>{athletes.length}</strong>
          <span>Athletes</span>
        </div>

        <div class="number-block">
          <strong>02</strong>
          <span>Sports</span>
        </div>

        <div class="number-block">
          <strong>2026</strong>
          <span>Founded</span>
        </div>

        <div class="number-block">
          <strong>NJ</strong>
          <span>Roots</span>
        </div>

      </div>

    </div>
  </section>

  <section class="disciplines-section">
    <div class="section-inner">

      <div class="section-heading">
        <p class="section-label">DISCIPLINES</p>
        <h2>What We Do</h2>
      </div>

      <div class="discipline-grid">

        <div class="discipline-card">
          <span>01</span>

          <h3>Running</h3>

          <p>
            Track, road racing, cross country, half marathon,
            and marathon competition.
          </p>
        </div>

        <div class="discipline-card">
          <span>02</span>

          <h3>Rowing</h3>

          <p>
            Competitive rowing and erg development across
            collegiate and post-collegiate training environments.
          </p>
        </div>

      </div>

    </div>
  </section>

  <section class="athletes-section">
    <div class="section-inner">

      <div class="section-heading athletes-heading">
        <div>
          <p class="section-label">CURRENT MEMBERS</p>
          <h2>The Club</h2>
        </div>

        <a class="text-link" href="/athletes">
          View athletes →
        </a>
      </div>

      <div class="member-list">
        {
          athletes.map((athlete) => (
            <a
              class="member-row"
              href={`/athletes/${athlete.slug}`}
            >
              <div>
                <p>{athlete.sport}</p>
                <h3>{athlete.name}</h3>
              </div>

              <span>{athlete.location}</span>
            </a>
          ))
        }
      </div>

    </div>
  </section>

</BaseLayout>

<style>

  .intro-section {
    padding: 100px 0 120px;
  }

  .intro-grid {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 80px;
  }

  .intro-copy {
    max-width: 950px;
    margin: 0;

    font-size: clamp(36px, 5.5vw, 70px);
    line-height: 1;
    letter-spacing: -4px;
  }


  .story-section {
    padding: 100px 0 120px;

    background: var(--beige-light);

    border-top: 1px solid var(--black);
    border-bottom: 1px solid var(--black);
  }

  .story-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 100px;
  }

  .story-section h2 {
    margin: 16px 0 0;

    font-size: clamp(55px, 7vw, 95px);
    line-height: 0.88;
    letter-spacing: -5px;

    text-transform: uppercase;
  }

  .story-copy {
    max-width: 620px;
  }

  .story-copy p {
    margin: 0 0 28px;

    font-size: 19px;
    line-height: 1.6;
  }


  .numbers-section {
    background: var(--mint);
    border-bottom: 1px solid var(--black);
  }

  .numbers-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  .number-block {
    padding: 45px 0;

    border-right: 1px solid var(--black);
  }

  .number-block:not(:first-child) {
    padding-left: 30px;
  }

  .number-block:last-child {
    border-right: none;
  }

  .number-block strong {
    display: block;

    font-size: 48px;
    letter-spacing: -3px;
  }

  .number-block span {
    display: block;
    margin-top: 8px;

    font-size: 10px;
    font-weight: 900;
    letter-spacing: 1.5px;

    text-transform: uppercase;
  }


  .disciplines-section {
    padding: 100px 0 120px;
  }

  .section-heading {
    margin-bottom: 45px;
  }

  .section-heading h2 {
    margin: 10px 0 0;

    font-size: clamp(55px, 8vw, 105px);
    line-height: 0.85;
    letter-spacing: -5px;

    text-transform: uppercase;
  }

  .discipline-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;

    border-top: 1px solid var(--black);
    border-left: 1px solid var(--black);
  }

  .discipline-card {
    min-height: 340px;
    padding: 32px;

    border-right: 1px solid var(--black);
    border-bottom: 1px solid var(--black);
  }

  .discipline-card > span {
    font-size: 11px;
    font-weight: 900;
  }

  .discipline-card h3 {
    margin: 90px 0 20px;

    font-size: clamp(45px, 6vw, 76px);
    line-height: 0.9;
    letter-spacing: -4px;

    text-transform: uppercase;
  }

  .discipline-card p {
    max-width: 430px;
    margin: 0;

    color: var(--gray);

    font-size: 15px;
    line-height: 1.5;
  }


  .athletes-section {
    padding: 100px 0 120px;

    background: var(--black);
    color: var(--white);
  }

  .athletes-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 40px;
  }

  .athletes-section .text-link {
    color: var(--white);
    border-color: var(--white);
  }

  .member-list {
    border-top: 1px solid rgba(255,255,255,0.45);
  }

  .member-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;

    padding: 30px 0;

    border-bottom: 1px solid rgba(255,255,255,0.35);

    color: var(--white);
    text-decoration: none;
  }

  .member-row p {
    margin: 0 0 8px;

    color: var(--mint);

    font-size: 10px;
    font-weight: 900;
    letter-spacing: 1.5px;

    text-transform: uppercase;
  }

  .member-row h3 {
    margin: 0;

    font-size: 34px;
    line-height: 1;

    text-transform: uppercase;
  }

  .member-row > span {
    color: #aaa;
    font-size: 13px;
  }

  .member-row:hover {
    opacity: 0.55;
  }


  @media (max-width: 850px) {

    .intro-section,
    .story-section,
    .disciplines-section,
    .athletes-section {
      padding: 75px 0 85px;
    }

    .intro-grid,
    .story-grid {
      grid-template-columns: 1fr;
      gap: 35px;
    }

    .intro-copy {
      font-size: 38px;
      letter-spacing: -2px;
    }

    .story-section h2 {
      font-size: 58px;
      letter-spacing: -3px;
    }

    .story-copy p {
      font-size: 16px;
    }


    .numbers-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .number-block {
      padding: 28px 0;
      border-bottom: 1px solid var(--black);
    }

    .number-block:nth-child(even) {
      padding-left: 20px;
      border-right: none;
    }

    .number-block:nth-child(3),
    .number-block:nth-child(4) {
      border-bottom: none;
    }


    .section-heading h2 {
      font-size: 58px;
      letter-spacing: -3px;
    }

    .discipline-grid {
      grid-template-columns: 1fr;
    }

    .discipline-card {
      min-height: 280px;
    }

    .discipline-card h3 {
      margin-top: 65px;
      font-size: 50px;
    }


    .athletes-heading {
      display: block;
    }

    .athletes-heading .text-link {
      margin-top: 25px;
    }

    .member-row {
      align-items: flex-start;
      flex-direction: column;
      gap: 12px;
    }

    .member-row h3 {
      font-size: 29px;
    }

  }

</style>
