---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="About | LRAC"
  description="About Lower Raritan Athletic Club."
>
  <section class="page-hero">
    <div class="section-inner">
      <p class="eyebrow">LOWER RARITAN ATHLETIC CLUB</p>
      <h1>About</h1>
    </div>
  </section>

  <section class="about-section">
    <div class="section-inner about-grid">
      <p class="section-label">THE CLUB</p>

      <div class="about-copy">
        <h2>
          An independent endurance club with roots in New Jersey.
        </h2>

        <p>
          Lower Raritan Athletic Club was formed in 2026 by athletes with
          backgrounds in Rutgers athletics and a continued interest in
          high-level endurance competition.
        </p>

        <p>
          The club currently includes athletes in distance running and rowing,
          with training and competition taking place in New Jersey, California,
          and beyond.
        </p>

        <p>
          LRAC serves as a home for athlete profiles, race schedules, training
          notes, and the ongoing development of the club.
        </p>
      </div>
    </div>
  </section>

  <section class="details-section">
    <div class="section-inner details-grid">
      <div class="detail">
        <p class="detail-label">FOUNDED</p>
        <p class="detail-value">2026</p>
      </div>

      <div class="detail">
        <p class="detail-label">BASE</p>
        <p class="detail-value">New Jersey</p>
      </div>

      <div class="detail">
        <p class="detail-label">DISCIPLINES</p>
        <p class="detail-value">Running / Rowing</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    background: #a8e6cf;
    border-bottom: 1px solid #111;
    padding: 90px 0 70px;
  }

  .eyebrow,
  .section-label,
  .detail-label {
    margin: 0;
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 2.4px;
    text-transform: uppercase;
  }

  h1 {
    margin: 32px 0 0;
    font-size: clamp(80px, 12vw, 170px);
    line-height: 0.8;
    letter-spacing: -8px;
    text-transform: uppercase;
  }

  .about-section {
    padding: 110px 0;
    background: #111;
    color: #fff;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 70px;
  }

  .about-copy h2 {
    max-width: 900px;
    margin: 0 0 40px;
    font-size: clamp(46px, 6vw, 82px);
    line-height: 0.95;
    letter-spacing: -4px;
    text-transform: uppercase;
  }

  .about-copy p {
    max-width: 740px;
    margin: 0 0 24px;
    color: #d4d4d4;
    font-size: 18px;
    line-height: 1.7;
  }

  .details-section {
    padding: 90px 0 110px;
    background: #eee8dc;
  }

  .details-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid #111;
  }

  .detail {
    padding: 28px 20px 28px 0;
    border-bottom: 1px solid #111;
  }

  .detail-value {
    margin: 18px 0 0;
    font-size: 34px;
    font-weight: 900;
    letter-spacing: -1.5px;
    text-transform: uppercase;
  }

  @media (max-width: 850px) {
    h1 {
      letter-spacing: -5px;
    }

    .about-grid,
    .details-grid {
      grid-template-columns: 1fr;
    }

    .about-grid {
      gap: 35px;
    }
  }
</style>