---
import BaseLayout from "../layouts/BaseLayout.astro";
import { athletes } from "../../data/athletes.js";
import { site } from "../../data/site.js";
---

<BaseLayout title="About | LRAC" description="Work in progress.">
  <section class="page-hero">
    <div class="section-inner">
      <p class="eyebrow">{site.name}</p>
      <h1>About</h1>
    </div>
  </section>

  <section class="statement-section">
    <div class="section-inner statement-grid">
      <p class="section-label">THE CLUB</p>
      <p class="statement">Work in progress.</p>
    </div>
  </section>

  <section class="facts-section">
    <div class="section-inner facts-grid">
      <div><strong>{String(athletes.length).padStart(2, "0")}</strong><span>Athletes</span></div>
      <div><strong>{site.founded}</strong><span>Founded</span></div>
      <div><strong>NJ</strong><span>Roots</span></div>
    </div>
  </section>

  <section class="members-section">
    <div class="section-inner">
      <div class="section-heading">
        <p class="section-label">CURRENT MEMBERS</p>
        <h2>The Club</h2>
      </div>

      <div class="member-list">
        {athletes.map((athlete) => (
          <a class="member-row" href={`/athletes/${athlete.slug}`}>
            <span class="sport">{athlete.sport}</span>
            <strong>{athlete.name}</strong>
            <span>{athlete.location}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .statement-section { padding: 92px 0 110px; background: var(--beige-light); }
  .statement-grid { display: grid; grid-template-columns: 180px 1fr; gap: 72px; }
  .statement { margin: 0; font-family: var(--display-font); font-size: clamp(48px, 7vw, 92px); line-height: .9; letter-spacing: -3px; text-transform: uppercase; }

  .facts-section { background: var(--mint); border-top: 1px solid var(--black); border-bottom: 1px solid var(--black); }
  .facts-grid { display: grid; grid-template-columns: repeat(3, 1fr); }
  .facts-grid > div { padding: 34px 0; border-right: 1px solid var(--black); }
  .facts-grid > div:not(:first-child) { padding-left: 24px; }
  .facts-grid > div:last-child { border-right: 0; }
  .facts-grid strong { display: block; font-family: var(--display-font); font-size: 44px; line-height: 1; }
  .facts-grid span { display: block; margin-top: 5px; font-size: 9px; font-weight: 900; letter-spacing: 1.4px; text-transform: uppercase; }

  .members-section { padding: 88px 0 104px; background: var(--beige); }
  .section-heading { margin-bottom: 34px; }
  .section-heading h2 { margin: 7px 0 0; font-size: clamp(58px, 7vw, 96px); line-height: .8; letter-spacing: -4px; text-transform: uppercase; }
  .member-list { border-top: 1px solid var(--black); }
  .member-row { display: grid; grid-template-columns: 180px 1fr 220px; gap: 24px; align-items: center; padding: 24px 0; border-bottom: 1px solid var(--black); color: var(--black); text-decoration: none; }
  .member-row .sport, .member-row > span:last-child { font-size: 9px; font-weight: 900; letter-spacing: 1.2px; text-transform: uppercase; }
  .member-row strong { font-family: var(--display-font); font-size: 34px; line-height: .9; text-transform: uppercase; }
  .member-row:hover strong { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 5px; }

  @media (max-width: 850px) {
    .statement-section, .members-section { padding: 64px 0 74px; }
    .statement-grid { grid-template-columns: 1fr; gap: 28px; }
    .facts-grid { grid-template-columns: 1fr; }
    .facts-grid > div, .facts-grid > div:not(:first-child) { padding: 22px 0; border-right: 0; border-bottom: 1px solid var(--black); }
    .facts-grid > div:last-child { border-bottom: 0; }
    .member-row { grid-template-columns: 1fr; gap: 7px; }
    .member-row strong { font-size: 30px; }
  }
</style>
