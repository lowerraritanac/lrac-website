---
import BaseLayout from "../layouts/BaseLayout.astro";
import { athletes } from "../../data/athletes.js";
import { site } from "../../data/site.js";
---

<BaseLayout title="About | LRAC" description="Work in progress.">
  <section class="page-hero">
    <div class="section-inner">
      <p class="eyebrow">{site.name}</p>
      <h1>About</h1>
    </div>
  </section>

  <section class="statement-section">
    <div class="section-inner statement-grid">
      <p class="section-label">The Club</p>
      <p class="statement">Work in progress.</p>
    </div>
  </section>

  <section class="identity-strip">
    <div class="section-inner identity-line">
      <span>{site.location}</span>
      <span>Est. {site.founded}</span>
      <a href={`mailto:${site.email}`}>{site.email} ↗</a>
    </div>
  </section>

  <section class="members-section">
    <div class="section-inner members-grid">
      <div class="members-heading">
        <p class="section-label">Current Members</p>
        <h2>Athletes</h2>
      </div>

      <div class="member-list">
        {athletes.map((athlete) => (
          <a class="member-row" href={`/athletes/${athlete.slug}`}>
            <span class="sport">{athlete.sport}</span>
            <strong>{athlete.name}</strong>
            <span>{athlete.location}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .statement-section { padding: 72px 0 82px; background: var(--paper); }
  .statement-grid { display: grid; grid-template-columns: 180px 1fr; gap: 58px; }
  .statement { margin: 0; max-width: 760px; color: var(--gray); font-family: var(--editorial); font-size: clamp(28px, 3.8vw, 48px); line-height: 1.08; letter-spacing: -.025em; }

  .identity-strip { background: var(--beige); border-top: 1px solid var(--ink); border-bottom: 1px solid var(--ink); }
  .identity-line { display: flex; justify-content: space-between; gap: 24px; padding-top: 16px; padding-bottom: 16px; }
  .identity-line span, .identity-line a { font-family: var(--mono); font-size: 9px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; }
  .identity-line a { text-decoration: none; border-bottom: 1px solid currentColor; padding-bottom: 2px; }

  .members-section { padding: 72px 0 86px; background: var(--paper); }
  .members-grid { display: grid; grid-template-columns: 220px 1fr; gap: 58px; }
  .members-heading h2 { margin: 16px 0 0; font-size: clamp(48px, 5.5vw, 72px); line-height: .95; letter-spacing: -.035em; }
  .member-list { border-top: 1px solid var(--ink); }
  .member-row { display: grid; grid-template-columns: 150px 1fr 180px; gap: 22px; align-items: center; padding: 20px 0; border-bottom: 1px solid var(--ink); color: var(--ink); text-decoration: none; }
  .member-row .sport, .member-row > span:last-child { font-family: var(--mono); font-size: 9px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; }
  .member-row strong { font-family: var(--editorial); font-size: 30px; font-weight: 600; line-height: 1; }
  .member-row:hover strong { color: var(--mint-dark); }

  @media (max-width: 850px) {
    .statement-section, .members-section { padding: 54px 0 62px; }
    .statement-grid, .members-grid { grid-template-columns: 1fr; gap: 26px; }
    .identity-line { align-items: flex-start; flex-direction: column; gap: 7px; }
    .member-row { grid-template-columns: 1fr; gap: 6px; }
    .member-row strong { font-size: 28px; }
  }
</style>
