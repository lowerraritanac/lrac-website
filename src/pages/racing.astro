---
import BaseLayout from "../layouts/BaseLayout.astro";
import { races } from "../../data/schedule.js";
import { raceDate } from "../lib/race-date.js";
const upcomingRaces = races.filter(r => r.status === "Upcoming" || r.status === "Tentative").sort((a,b) => raceDate(a) - raceDate(b));
const completedRaces = races.filter(r => r.status === "Completed").sort((a,b) => raceDate(b) - raceDate(a));
---
<BaseLayout title="Race Calendar & Results | LRAC" description="See the Lower Raritan race schedule and explore the team's latest race results.">
<section class="race-intro"><div class="section-inner"><p class="eyebrow">Lower Raritan Athletic Club / Racing</p><h1>Race Calendar<br/>&amp; Results.</h1><div class="intro-bottom"><p>Where we're headed.<br/>What we've put on the clock.</p><nav class="race-jumps" aria-label="Race page sections"><a href="#schedule">Race schedule <span>{upcomingRaces.length}</span> ↓</a><a href="#results">Race results <span>{completedRaces.length}</span> ↓</a></nav></div></div></section>
<section class="race-section" id="schedule" aria-labelledby="schedule-heading"><div class="section-inner"><div class="section-heading"><div><p class="eyebrow">01 / On the calendar</p><h2 id="schedule-heading">Upcoming races</h2></div><p>Next on the start line.</p></div>
<div class="schedule-list">{upcomingRaces.length ? upcomingRaces.map(race => <article class="schedule-race"><div class="date-block"><span>{race.date.split(' ')[0]}</span><strong>{race.date.split(' ')[1]}</strong><span>{race.year}</span></div><div class="race-info"><p class="discipline">{race.discipline}</p><h3>{race.event}</h3><p class="location">{race.location}</p><div class="athlete-links"><span>Racing</span>{race.athletes.map((name,i)=><a href={`/athletes/${race.athleteSlugs[i]}`}>{name} ↗</a>)}</div></div><span class="race-status">{race.status}</span></article>) : <p class="empty-state">No upcoming races are listed yet. Check back for the next start line.</p>}</div></div></section>
<section class="race-section results-section" id="results" aria-labelledby="results-heading"><div class="section-inner"><div class="section-heading"><div><p class="eyebrow">02 / Across the line</p><h2 id="results-heading">Race results</h2></div><p>Latest finishes first.</p></div>
<div class="results-list">{completedRaces.length ? completedRaces.map(race => <article class="result-race"><div class="result-event"><p class="result-date">{race.date} · {race.year}</p><p class="discipline">{race.discipline}</p><h3>{race.event}</h3><p class="location">{race.location}</p></div><div class="performances">{race.results?.length ? <><div class="performance-labels"><span>Athlete</span><span>Time</span><span>Place</span></div>{race.results.map(result => <div class="performance"><a href={`/athletes/${result.athleteSlug}`}>{race.athletes[race.athleteSlugs.indexOf(result.athleteSlug)]} ↗</a><strong>{result.time}</strong><span>{result.place}</span></div>)}</> : <div class="single-performance"><span class="result-label">Recorded result</span><strong>{race.result}</strong><div class="athlete-links">{race.athletes.map((name,i)=><a href={`/athletes/${race.athleteSlugs[i]}`}>{name} ↗</a>)}</div></div>}</div></article>) : <p class="empty-state">Race results will appear here after the team competes.</p>}</div>
<div class="training-footer"><div><p class="eyebrow">Behind the results</p><h3>Follow the training.</h3><p>Training logs, race reports, and writing from the team.</p></div><a href="/training">Explore training &amp; writing <span aria-hidden="true">→</span></a></div>
</div></section>
</BaseLayout>
<style>
.race-intro,.race-section{color:#233d2b;font-family:'DM Sans',Arial,sans-serif}.race-intro{padding:52px 0 36px;background:#f2f3e9;border-bottom:1px solid #bdc5b8}.race-intro h1{font:400 clamp(48px,6.8vw,88px)/1.02 Georgia,serif;letter-spacing:-.045em;margin:24px 0 30px}.intro-bottom{display:flex;justify-content:space-between;align-items:end;gap:25px}.intro-bottom>p{font-size:17px;line-height:1.6;margin:0}.race-jumps{display:flex;gap:12px;flex-wrap:wrap}.race-jumps a{background:#233d2b;color:#f2f3e9;text-decoration:none;min-height:50px;padding:14px 20px;display:flex;align-items:center;gap:12px;font-size:14px;font-weight:600}.race-jumps a:nth-child(2){background:#a8e6cf;color:#233d2b}.race-jumps span{opacity:.8}.race-jumps a:hover{box-shadow:inset 0 -3px currentColor}.race-section{padding:52px 0;background:#f2f3e9;scroll-margin-top:100px}.section-heading{display:flex;align-items:end;justify-content:space-between;gap:24px;margin-bottom:25px}.section-heading h2{font:400 clamp(32px,4vw,48px)/1.1 Georgia,serif;margin:14px 0 0;letter-spacing:-.035em}.section-heading>p{margin:0;font-size:14px}.schedule-list{border-top:2px solid #233d2b}.schedule-race{display:grid;grid-template-columns:95px 1fr auto;gap:28px;padding:28px 0;border-bottom:1px solid #bdc5b8;align-items:start}.date-block{display:grid;text-align:center;background:#a8e6cf;padding:14px 10px;gap:4px}.date-block span{font-size:12px;font-weight:600;letter-spacing:.06em}.date-block strong{font-size:38px;line-height:1.1}.discipline{font-size:11px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;margin:0 0 10px}.race-info h3,.result-event h3{font:500 clamp(23px,2.5vw,32px)/1.15 'DM Sans',Arial,sans-serif;letter-spacing:-.03em;margin:0}.location{font-size:14px;line-height:1.5;color:#536451;margin:10px 0}.athlete-links{display:flex;flex-wrap:wrap;align-items:center;gap:10px 18px;margin-top:18px;font-size:14px}.athlete-links>span{font-size:11px;text-transform:uppercase;letter-spacing:.07em;color:#536451}.athlete-links a,.performance a{text-underline-offset:4px;line-height:1.6}.race-status{padding:9px 12px;border:1px solid #8fa38b;font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.06em}.results-section{background:#e7eddf;border-top:1px solid #bdc5b8}.results-list{border-top:2px solid #233d2b}.result-race{display:grid;grid-template-columns:1fr 1fr;gap:50px;padding:30px 0;border-bottom:1px solid #acb9a5;align-items:center}.result-date{font-size:12px;margin:0 0 16px;letter-spacing:.06em}.performances{min-width:0}.performance-labels,.performance{display:grid;grid-template-columns:minmax(0,1fr) 100px 55px;gap:14px;align-items:center}.performance-labels{font-size:10px;text-transform:uppercase;letter-spacing:.08em;padding-bottom:10px}.performance{padding:14px 0;border-top:1px solid #bdc5b8;font-size:14px}.performance strong{font-size:20px;font-variant-numeric:tabular-nums}.single-performance{border-left:3px solid #7aa58e;padding-left:24px;display:grid;gap:12px}.result-label{font-size:10px;letter-spacing:.09em;text-transform:uppercase}.single-performance>strong{font-size:clamp(23px,2.5vw,32px);line-height:1.25;letter-spacing:-.025em;font-variant-numeric:tabular-nums}.single-performance .athlete-links{margin:0}.training-footer{display:flex;align-items:center;justify-content:space-between;gap:30px;padding-top:42px}.training-footer h3{font:400 30px/1.1 Georgia,serif;margin:12px 0}.training-footer p:not(.eyebrow){font-size:14px;line-height:1.6;margin:0}.training-footer>a{display:flex;gap:24px;align-items:center;background:#233d2b;color:#fff;padding:18px 22px;font-size:13px;font-weight:600;text-decoration:none}.training-footer>a:hover{background:#315944}.empty-state{font-size:16px;line-height:1.7;padding:20px 0}.race-section a:focus-visible,.race-intro a:focus-visible{outline:3px solid #315944;outline-offset:4px}
@media(max-width:760px){.race-intro{padding:35px 0 28px}.intro-bottom{display:block}.race-jumps{margin-top:24px}.race-jumps a{flex:1;justify-content:center;padding:12px;font-size:12px}.race-section{padding:34px 0;scroll-margin-top:90px}.section-heading{display:block}.section-heading>p{margin-top:14px}.schedule-race{grid-template-columns:68px minmax(0,1fr);gap:18px}.date-block{padding:12px 6px}.date-block strong{font-size:30px}.race-status{grid-column:2;justify-self:start}.result-race{grid-template-columns:1fr;gap:22px;padding:26px 0}.performance-labels,.performance{grid-template-columns:minmax(0,1fr) 85px 45px;gap:8px}.performance{font-size:12px}.performance strong{font-size:18px}.single-performance{padding-left:16px}.training-footer{display:block}.training-footer>a{margin-top:24px;justify-content:space-between}.athlete-links{font-size:13px}}
</style>
