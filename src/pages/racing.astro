---
import BaseLayout from "../layouts/BaseLayout.astro";
import { races } from "../../data/schedule.js";

const upcomingRaces = races.filter(
  (race) => race.status === "Upcoming" || race.status === "Tentative"
);

const completedRaces = races.filter(
  (race) => race.status === "Completed"
);

const years = [...new Set(completedRaces.map((race) => race.year))];
---

<BaseLayout
  title="Racing | LRAC"
  description="Upcoming races and competition results from Lower Raritan Athletic Club."
>
  <section class="page-hero">
    <div class="section-inner">
      <p class="eyebrow">LOWER RARITAN ATHLETIC CLUB</p>
      <h1>Racing</h1>
    </div>
  </section>

  <section class="racing-section">
    <div class="section-inner">
      <div class="section-heading">
        <p class="section-label">UPCOMING</p>
        <h2>Next Races</h2>
      </div>

      <div class="race-list">
        {
          upcomingRaces.map((race) => (
            <article class="race-row">
              <div class="date">
                <strong>{race.date}</strong>
                <span>{race.year}</span>
              </div>

              <div class="event">
                <p class="discipline">{race.discipline}</p>
                <h3>{race.event}</h3>
                <p class="location">{race.location}</p>
              </div>

              <div class="athlete">
                {race.athletes.join(" · ")}
              </div>

              <div class="status">
                {race.status}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="results-break">
    <div class="section-inner">
      <div class="break-line"></div>

      <div class="results-intro">
        <p class="section-label">PREVIOUS RACES</p>
        <h2>Results</h2>
      </div>
    </div>
  </section>

  <section class="results-section">
    <div class="section-inner">
      <div class="race-list">
        {
          completedRaces.map((race) => (
            <article class="race-row">
              <div class="date">
                <strong>{race.date}</strong>
                <span>{race.year}</span>
              </div>

              <div class="event">
                <p class="discipline">{race.discipline}</p>
                <h3>{race.event}</h3>
                <p class="location">{race.location}</p>
              </div>

              <div class="athlete">
                {race.athletes.join(" · ")}
              </div>

              <div class="result">
                {race.result}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="archive-section">
    <div class="section-inner">
      <div class="section-heading">
        <p class="section-label">ARCHIVE</p>
        <h2>Seasons</h2>
      </div>

      <div class="archive-list">
        {
          years.map((year) => (
            <div class="archive-row">
              <span>{year}</span>
              <span>
                {
                  completedRaces.filter(
                    (race) => race.year === year
                  ).length
                } races
              </span>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .racing-section {
    padding: 90px 0 120px;
  }

  .section-heading {
    margin-bottom: 40px;
  }

  .section-heading h2 {
    margin: 10px 0 0;
    font-size: clamp(48px, 7vw, 86px);
    line-height: 0.9;
    letter-spacing: -4px;
    text-transform: uppercase;
  }

  .race-list {
    border-top: 1px solid var(--black);
  }

  .race-row {
    display: grid;
    grid-template-columns: 140px 1fr 220px 160px;
    gap: 28px;
    align-items: center;

    padding: 28px 0;

    border-bottom: 1px solid var(--black);
  }

  .date strong {
    display: block;
    font-size: 17px;
  }

  .date span {
    display: block;
    margin-top: 4px;
    color: var(--gray);
    font-size: 12px;
  }

  .discipline {
    margin: 0 0 6px;
    color: var(--mint-dark);
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .event h3 {
    margin: 0;
    font-size: 27px;
    line-height: 1;
    letter-spacing: -1.2px;
    text-transform: uppercase;
  }

  .location {
    margin: 7px 0 0;
    color: var(--gray);
    font-size: 13px;
  }

  .athlete,
  .status,
  .result {
    font-size: 13px;
    font-weight: 700;
  }

  .results-break {
    padding: 120px 0 45px;
    background: var(--black);
    color: var(--white);
  }

  .break-line {
    width: 100%;
    height: 1px;
    margin-bottom: 40px;
    background: rgba(255, 255, 255, 0.4);
  }

  .results-intro h2 {
    margin: 12px 0 0;

    font-size: clamp(58px, 9vw, 120px);
    line-height: 0.86;
    letter-spacing: -5px;

    text-transform: uppercase;
  }

  .results-section {
    padding: 0 0 110px;
    background: var(--black);
    color: var(--white);
  }

  .results-section .race-list {
    border-top: 1px solid rgba(255, 255, 255, 0.45);
  }

  .results-section .race-row {
    border-bottom: 1px solid rgba(255, 255, 255, 0.35);
  }

  .results-section .date span,
  .results-section .location {
    color: #aaaaaa;
  }

  .results-section .discipline {
    color: var(--mint);
  }

  .archive-section {
    padding: 90px 0 110px;
    background: var(--beige-light);
  }

  .archive-list {
    border-top: 1px solid var(--black);
  }

  .archive-row {
    display: flex;
    justify-content: space-between;

    padding: 24px 0;

    border-bottom: 1px solid var(--black);

    font-size: 20px;
    font-weight: 800;
  }

  @media (max-width: 850px) {
    .racing-section {
      padding: 70px 0 80px;
    }

    .race-row {
      grid-template-columns: 90px 1fr;
      gap: 20px;
    }

    .athlete,
    .status,
    .result {
      grid-column: 2;
    }

    .section-heading h2 {
      font-size: 52px;
      letter-spacing: -3px;
    }

    .results-break {
      padding: 80px 0 35px;
    }

    .results-intro h2 {
      font-size: 58px;
      letter-spacing: -3px;
    }

    .archive-section {
      padding: 70px 0 80px;
    }
  }
</style>
