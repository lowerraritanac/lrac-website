---
import BaseLayout from "../layouts/BaseLayout.astro";
import { races } from "../../data/schedule.js";

const upcomingRaces = races.filter((race) => race.status === "Upcoming" || race.status === "Tentative");
const completedRaces = races.filter((race) => race.status === "Completed");
const years = [...new Set(completedRaces.map((race) => race.year))];
---

<BaseLayout title="Racing | LRAC" description="Upcoming races and competition results from Lower Raritan Athletic Club.">
  <section class="page-hero">
    <div class="section-inner hero-row">
      <div><p class="eyebrow">Lower Raritan Athletic Club</p><h1>Racing</h1></div>
      <div class="hero-count"><span>{String(upcomingRaces.length).padStart(2, "0")}</span><small>Upcoming</small></div>
    </div>
  </section>

  {upcomingRaces.length > 0 && (
    <section class="racing-section">
      <div class="section-inner">
        <div class="section-heading"><p class="section-label">Upcoming</p><h2>Next Races</h2></div>
        <div class="race-list">
          {upcomingRaces.map((race) => (
            <article class="race-row">
              <div class="date"><strong>{race.date}</strong><span>{race.year}</span></div>
              <div class="event"><p class="discipline">{race.discipline}</p><h3>{race.event}</h3><p class="location">{race.location}</p></div>
              <div class="athletes">
                {race.athletes.map((name, index) => (
                  <>
                    <a href={`/athletes/${race.athleteSlugs[index]}`}>{name}</a>{index < race.athletes.length - 1 && <span> · </span>}
                  </>
                ))}
              </div>
              <div class:list={["status", race.status === "Tentative" && "tentative"]}>{race.status}</div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {completedRaces.length > 0 && (
    <section class="results-section">
      <div class="section-inner">
        <div class="results-head"><p class="section-label">Previous Races</p><h2>Results</h2></div>
        <div class="race-list result-list">
          {completedRaces.map((race) => (
            <article class="result-row">
              <div class="date"><strong>{race.date}</strong><span>{race.year}</span></div>
              <div class="event"><p class="discipline">{race.discipline}</p><h3>{race.event}</h3><p class="location">{race.location}</p></div>
              <div class="result-athletes">
                {race.athletes.map((name, index) => (
                  <>
                    <a href={`/athletes/${race.athleteSlugs[index]}`}>{name}</a>{index < race.athletes.length - 1 && <span> · </span>}
                  </>
                ))}
              </div>
              <div class="result-mark">{race.result}</div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {years.length > 1 && (
    <section class="archive-section">
      <div class="section-inner">
        <div class="section-heading"><p class="section-label">Archive</p><h2>Seasons</h2></div>
        <div class="archive-list">
          {years.map((year) => (
            <div class="archive-row"><span>{year}</span><span>{completedRaces.filter((race) => race.year === year).length} races</span></div>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .hero-row { display: flex; justify-content: space-between; gap: 40px; align-items: flex-end; }
  .hero-count { display: flex; flex-direction: column; align-items: flex-end; gap: 4px; padding-bottom: 6px; font-family: var(--mono); text-transform: uppercase; }
  .hero-count span { font-size: 20px; font-weight: 700; }
  .hero-count small { color: var(--gray); font-size: 8px; }
  .racing-section, .archive-section { padding: 76px 0 90px; }
  .section-heading { display: flex; justify-content: space-between; gap: 30px; align-items: end; margin-bottom: 30px; }
  .section-heading h2, .results-head h2 { margin: 8px 0 0; font-size: clamp(52px, 7vw, 92px); line-height: .88; letter-spacing: -.04em; }
  .race-list { border-top: 1px solid var(--ink); }
  .race-row { display: grid; grid-template-columns: 120px minmax(0, 1fr) 210px 110px; gap: 24px; align-items: center; padding: 24px 0; border-bottom: 1px solid var(--ink); }
  .date strong { display: block; font-family: var(--mono); font-size: 16px; }
  .date span { display: block; margin-top: 4px; color: var(--gray); font-family: var(--mono); font-size: 9px; }
  .discipline { margin: 0 0 5px; color: var(--mint-dark); font-family: var(--mono); font-size: 9px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  .event h3 { margin: 0; font-size: clamp(26px, 2.6vw, 36px); line-height: .98; letter-spacing: -.025em; }
  .location { margin: 6px 0 0; color: var(--gray); font-family: var(--mono); font-size: 9px; }
  .athletes, .status, .result-athletes { font-family: var(--mono); font-size: 10px; font-weight: 600; }
  .athletes a, .result-athletes a { color: inherit; text-decoration: none; border-bottom: 1px solid transparent; }
  .athletes a:hover, .result-athletes a:hover { border-color: currentColor; }
  .status { text-align: right; text-transform: uppercase; }
  .status.tentative { color: var(--gray); }

  .results-section { padding: 82px 0 94px; background: var(--ink); color: var(--white); }
  .results-head { margin-bottom: 34px; }
  .result-list { border-color: rgba(255,255,255,.42); }
  .result-row { display: grid; grid-template-columns: 120px minmax(0, 1fr) 190px 190px; gap: 24px; align-items: center; padding: 26px 0; border-bottom: 1px solid rgba(255,255,255,.28); }
  .results-section .date span, .results-section .location { color: #999; }
  .results-section .discipline { color: var(--mint); }
  .result-mark { font-family: var(--mono); font-size: clamp(20px, 2vw, 27px); font-weight: 700; line-height: 1.25; text-align: right; text-transform: uppercase; }

  .archive-section { background: var(--paper); }
  .archive-list { border-top: 1px solid var(--ink); }
  .archive-row { display: flex; justify-content: space-between; padding: 20px 0; border-bottom: 1px solid var(--ink); font-family: var(--mono); font-size: 14px; text-transform: uppercase; }

  @media (max-width: 850px) {
    .hero-row { align-items: flex-end; }
    .hero-count { padding-bottom: 2px; }
    .hero-count span { font-size: 16px; }
    .hero-count small { font-size: 7px; }
    .racing-section, .archive-section, .results-section { padding: 40px 0 52px; }
    .section-heading { display: block; margin-bottom: 18px; }
    .section-heading h2, .results-head h2 { margin-top: 8px; font-size: 42px; line-height: .92; }
    .race-row, .result-row { grid-template-columns: 62px minmax(0, 1fr); gap: 12px 14px; align-items: start; padding: 20px 0; }
    .date strong { font-size: 14px; }
    .date span { font-size: 8px; }
    .discipline { font-size: 7px; }
    .event h3 { font-size: 25px; line-height: .96; }
    .location { font-size: 8px; }
    .athletes, .status, .result-athletes { grid-column: 2; font-size: 8px; }
    .status, .result-mark { text-align: left; }
    .result-mark { grid-column: 2; font-size: 19px; }
    .results-head { margin-bottom: 20px; }
  }
</style>