---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("training");
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const isTrainingReport = post.data.category === "Training Report";
---

<BaseLayout title={`${post.data.title} | LRAC`} description={post.data.description}>
  <article class:list={{ "training-report": isTrainingReport }}>
    <section class="article-hero">
      <div class="section-inner article-head-grid">
        <div class="article-index">
          <p class="category">{post.data.category}</p>
          <p>{post.data.athlete}</p>
          <p>{post.data.date.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" })}</p>
        </div>
        <div class="article-title-wrap">
          <h1>{post.data.title}</h1>
          {post.data.description && <p class="dek">{post.data.description}</p>}
        </div>
      </div>
    </section>

    <section class="article-body">
      <div class="article-layout">
        <aside><span>LRAC / Journal</span></aside>
        <div class="article-inner"><Content /></div>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .article-hero { padding: 72px 0 64px; background: var(--paper); border-bottom: 1px solid var(--ink); }
  .article-head-grid { display: grid; grid-template-columns: 190px minmax(0, 900px); gap: 58px; align-items: start; }
  .article-index { padding-top: 8px; font-family: var(--mono); font-size: 9px; line-height: 1.6; text-transform: uppercase; }
  .article-index p { margin: 0 0 7px; }
  .category { color: var(--mint-dark); font-weight: 700; }
  .article-title-wrap { min-width: 0; }
  .article-hero h1 { max-width: 900px; margin: 0; font-family: var(--editorial); font-size: clamp(56px, 7vw, 96px); font-weight: 600; line-height: .92; letter-spacing: -.04em; }
  .dek { max-width: 760px; margin: 26px 0 0; padding-top: 16px; border-top: 1px solid var(--ink); color: var(--gray); font-family: var(--mono); font-size: 10px; line-height: 1.6; }
  .article-body { padding: 76px 0 108px; background: var(--paper); }
  .article-layout { width: calc(100% - 68px); max-width: var(--max-width); margin: 0 auto; display: grid; grid-template-columns: 190px minmax(0, 760px) 1fr; gap: 58px; }
  aside { padding-top: 9px; border-top: 1px solid var(--ink); font-family: var(--mono); font-size: 8px; text-transform: uppercase; }
  .article-inner { min-width: 0; }
  .article-inner :global(p) { margin: 0 0 26px; font-family: var(--editorial); font-size: 20px; line-height: 1.68; }
  .training-report .article-inner :global(p:first-child) { margin-bottom: 38px; padding: 15px 0; border-top: 1px solid var(--ink); border-bottom: 1px solid var(--ink); font-family: var(--mono); font-size: 10px; font-weight: 600; line-height: 1.65; }
  .article-inner :global(h2) { margin: 64px 0 22px; padding-top: 18px; border-top: 1px solid var(--ink); font-family: var(--editorial); font-size: 38px; font-weight: 600; line-height: 1; letter-spacing: -.025em; }
  .article-inner :global(h3) { margin: 44px 0 15px; font-family: var(--mono); font-size: 15px; line-height: 1.25; text-transform: uppercase; }
  .article-inner :global(hr) { margin: 50px 0; border: 0; border-top: 1px solid var(--ink); }
  .article-inner :global(strong) { font-weight: 700; }
  .training-report .article-inner :global(h2 + p),
  .training-report .article-inner :global(h2 + p + p) { margin-bottom: 12px; font-family: var(--mono); font-size: 10px; line-height: 1.65; }
  .article-inner :global(blockquote) { margin: 38px 0 42px; padding: 18px 20px 19px; border: 1px solid var(--ink); border-left: 5px solid var(--mint-dark); background: var(--beige); }
  .article-inner :global(blockquote p) { margin: 0; font-family: var(--mono); font-size: 12px; font-weight: 600; line-height: 1.65; }

  @media (max-width: 850px) {
    .article-hero { padding: 46px 0 42px; }
    .article-head-grid { grid-template-columns: 1fr; gap: 22px; }
    .article-index { display: flex; flex-wrap: wrap; gap: 5px 14px; padding-top: 0; font-size: 8px; }
    .article-index p { margin: 0; }
    .article-hero h1 { font-size: clamp(44px, 12vw, 64px); }
    .dek { margin-top: 20px; font-size: 9px; }
    .article-body { padding: 46px 0 72px; }
    .article-layout { width: calc(100% - 40px); grid-template-columns: 1fr; gap: 24px; }
    aside { max-width: 120px; }
    .article-inner :global(p) { margin-bottom: 22px; font-size: 18px; line-height: 1.64; }
    .training-report .article-inner :global(p:first-child),
    .training-report .article-inner :global(h2 + p),
    .training-report .article-inner :global(h2 + p + p) { font-size: 9px; }
    .article-inner :global(h2) { margin-top: 50px; font-size: 32px; }
    .article-inner :global(blockquote) { margin: 30px 0 34px; padding: 15px 16px; }
    .article-inner :global(blockquote p) { font-size: 10px; }
  }
</style>
