---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("training");

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout
  title={`${post.data.title} | LRAC`}
  description={post.data.description}
>
  <article>
    <section class="article-hero">
      <div class="section-inner">
        <p class="category">{post.data.category}</p>
        <h1>{post.data.title}</h1>
        <div class="article-meta">
          <span>{post.data.athlete}</span>
          <span>
            {post.data.date.toLocaleDateString("en-US", {
              month: "long",
              day: "numeric",
              year: "numeric",
            })}
          </span>
        </div>
      </div>
    </section>

    <section class="article-body">
      <div class="article-inner">
        <Content />
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .article-hero { padding: 100px 0 80px; background: var(--mint); border-bottom: 1px solid var(--black); }
  .category { margin: 0; font-size: 11px; font-weight: 900; letter-spacing: 2px; text-transform: uppercase; }
  .article-hero h1 { max-width: 1100px; margin: 25px 0 40px; font-size: clamp(60px, 9vw, 125px); line-height: 0.88; letter-spacing: -6px; text-transform: uppercase; }
  .article-meta { display: flex; gap: 30px; font-size: 11px; font-weight: 900; letter-spacing: 1px; text-transform: uppercase; }
  .article-body { padding: 90px 0 130px; background: var(--beige-light); }
  .article-inner { width: calc(100% - 40px); max-width: 760px; margin: 0 auto; }
  .article-inner :global(p) { margin: 0 0 28px; font-size: 18px; line-height: 1.7; }
  .article-inner :global(h2) { margin: 70px 0 24px; font-size: 42px; line-height: 1; letter-spacing: -2px; text-transform: uppercase; }
  .article-inner :global(h3) { margin: 50px 0 18px; font-size: 27px; }
  .article-inner :global(hr) { margin: 60px 0; border: 0; border-top: 1px solid var(--black); }
  .article-inner :global(strong) { font-weight: 900; }
  @media (max-width: 850px) {
    .article-hero { padding: 70px 0 60px; }
    .article-hero h1 { font-size: 58px; letter-spacing: -4px; }
    .article-meta { flex-direction: column; gap: 8px; }
    .article-body { padding: 65px 0 90px; }
    .article-inner :global(p) { font-size: 17px; }
    .article-inner :global(h2) { font-size: 34px; }
  }
</style>
