---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TrainingDeepDive from "../../components/TrainingDeepDive.astro";
import { weeklyMileage, latestWeek, trainingDataSource } from "../../../data/training-aaron.js";
import { races } from "../../../data/schedule.js";

const athleteRaces = races.filter((race) => race.athleteSlugs.includes("aaron-wysocki"));
---

<BaseLayout title="Aaron Wysocki Training | LRAC" description="Training volume and running hours for Aaron Wysocki.">
  <TrainingDeepDive
    athleteName="Aaron Wysocki"
    athleteSlug="aaron-wysocki"
    {weeklyMileage}
    {latestWeek}
    {trainingDataSource}
    races={athleteRaces}
  />
</BaseLayout>
