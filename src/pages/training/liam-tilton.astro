---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TrainingDeepDive from "../../components/TrainingDeepDive.astro";
import { weeklyMileage, latestWeek, trainingDataSource } from "../../../data/training.js";
import { races } from "../../../data/schedule.js";

const athleteRaces = races.filter((race) => race.athleteSlugs.includes("liam-tilton"));
---

<BaseLayout title="Liam Tilton Training | LRAC" description="Training volume and running hours for Liam Tilton.">
  <TrainingDeepDive
    athleteName="Liam Tilton"
    athleteSlug="liam-tilton"
    {weeklyMileage}
    {latestWeek}
    {trainingDataSource}
    races={athleteRaces}
  />
</BaseLayout>
