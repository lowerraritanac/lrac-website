---


import { site } from "../../data/site.js";


const {
  title = "Lower Raritan Athletic Club | New Jersey",
  description = site.description,
  image = "/images/hero.jpg",
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, "https://lowerraritanac.com");
const socialImage = new URL(image, "https://lowerraritanac.com");
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "SportsOrganization",
  name: site.name,
  alternateName: site.shortName,
  url: "https://lowerraritanac.com",
  description: site.description,
  foundingDate: site.founded,
  areaServed: site.location,
  email: site.email,
  sameAs: [site.social.instagram, site.social.strava],
};

import { athletes } from "../../data/athletes.js";
const featuredAthletes = athletes.filter((athlete) => athlete.currentMember !== false && athlete.featuredOnHomepage !== false).slice(0,3);
---
<!doctype html>
<html lang="en"><head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <meta name="theme-color" content="#f4f1e7" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/jpeg" href="/images/hero.jpg" />
    <link rel="apple-touch-icon" href="/images/hero.jpg" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={site.name} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
  
<style is:global>
@import url('https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=DM+Sans:wght@400;500;600;700&display=swap');
:root{--paper:#f4f1e7;--ink:#20382e;--mint:#c4ddc3;--line:#adb5a5}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font-family:'DM Sans',Arial,sans-serif}a{color:inherit;text-decoration:none}a:hover{text-decoration:underline}a:focus-visible,button:focus-visible{outline:3px solid #d0783b;outline-offset:5px}.wrap{max-width:1480px;margin:auto;padding:0 5%}header{display:flex;justify-content:space-between;align-items:center;gap:24px;padding:23px 0;border-bottom:1px solid var(--ink)}.brand{display:flex;align-items:center;gap:12px;font-size:11px;font-weight:700;letter-spacing:.04em;line-height:1.3}.brand img{height:46px;width:37px;object-fit:contain}nav{display:flex;align-items:center;gap:28px;font-size:12px}.button{display:inline-flex;align-items:center;justify-content:center;min-height:46px;padding:13px 22px;background:var(--ink);color:var(--paper);font-size:12px;font-weight:600}.button:hover{background:#315944;text-decoration:none}.button.light{background:var(--mint);color:var(--ink)}.eyebrow{font-size:10px;text-transform:uppercase;font-weight:600;letter-spacing:.14em}.hero{display:grid;grid-template-columns:1.2fr 1fr;gap:6%;padding:42px 0 32px;align-items:center}.hero h1{font-family:'Barlow Condensed','Arial Narrow',Impact,sans-serif;font-size:clamp(65px,9.5vw,146px);line-height:.85;letter-spacing:-.025em;text-transform:uppercase;margin:25px 0 32px;font-weight:700}.hero h1 .club{font-family:Georgia,serif;text-transform:none;font-style:italic;font-weight:400;font-size:.59em;letter-spacing:-.055em;display:block;margin-top:13px}.hero-actions{display:flex;align-items:center;gap:24px;font-size:12px}.photo{position:relative;margin:0}.photo>img{display:block;width:100%;height:490px;object-fit:cover;object-position:center 56%;filter:saturate(.8)}.photo figcaption{display:flex;justify-content:space-between;gap:10px;font-size:10px;margin-top:12px}.photo .stamp{position:absolute;bottom:40px;right:20px;width:70px;height:90px;object-fit:contain;filter:none}.divider{display:flex;justify-content:space-between;gap:20px;padding:18px 0;border-top:1px solid var(--ink);font-size:10px;letter-spacing:.11em;text-transform:uppercase}.coaching{background:var(--mint);margin-top:0;padding:47px 0 50px}.coaching-grid{display:grid;grid-template-columns:1fr 1.4fr 1.15fr;gap:5%;align-items:start}.coaching h2{font-family:Georgia,serif;font-size:clamp(34px,4.5vw,62px);font-weight:400;letter-spacing:-.045em;line-height:1.04;margin:0}.coaching .intro{font-size:15px;line-height:1.65;margin:0 0 23px}.coaching .eyebrow{margin:5px 0 20px}.coaching .number{display:block;font-family:'Barlow Condensed',Impact,sans-serif;font-size:66px;line-height:1;margin-top:36px;color:#55735c}.section{padding:58px 0}.section-top{display:flex;justify-content:space-between;align-items:baseline;border-bottom:1px solid var(--line);padding-bottom:15px;margin-bottom:25px}.section-top h2{margin:0;font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:.1em}.section-top a{font-size:12px;text-decoration:underline}.athletes{display:grid;grid-template-columns:repeat(3,1fr);gap:25px}.athletes img{display:block;width:100%;height:300px;object-fit:cover;object-position:center 45%;filter:saturate(.7)}.athletes h3{font-size:25px;letter-spacing:-.04em;margin:15px 0 5px;font-weight:500}.athletes p{font-size:11px;margin:0}.journal{display:grid;grid-template-columns:1fr 2fr;gap:7%;padding-bottom:60px}.journal h2{font-family:Georgia,serif;font-size:45px;line-height:1.06;font-weight:400;letter-spacing:-.04em;margin:15px 0}.journal a{display:block;border-top:1px solid var(--line);padding:20px 0}.journal a span{font-size:10px;text-transform:uppercase;letter-spacing:.1em}.journal h3{font-size:21px;font-weight:500;margin:10px 0 0}footer{background:var(--ink);color:var(--paper);padding:35px 0}.footer-inner{display:flex;align-items:center;justify-content:space-between;gap:20px}.footer-inner p{font-family:Georgia,serif;font-size:24px;margin:0}.footer-inner a{font-size:12px;text-decoration:underline}
@media(min-width:1450px){.photo>img{height:550px}}@media(max-width:760px){.wrap{padding:0 6%}header{padding:18px 0;gap:10px}.brand{font-size:9px}.brand img{height:35px;width:28px}nav{gap:0}nav>a:not(.button){display:none}nav .button{font-size:11px;padding:10px 14px;min-height:42px}.hero{grid-template-columns:1fr;padding-top:28px;gap:27px}.hero h1{font-size:clamp(76px,17vw,125px);margin:20px 0 28px}.photo>img{height:360px;object-position:center 53%}.photo .stamp{height:65px;width:50px}.hero-actions{gap:20px}.divider{font-size:9px;flex-wrap:wrap}.coaching-grid{grid-template-columns:1fr;gap:22px}.coaching{padding:30px 0}.coaching .number{display:none}.coaching .eyebrow{margin:0}.coaching h2{font-size:46px}.coaching .intro{max-width:480px}.athletes{gap:15px;grid-template-columns:1fr 1fr}.athletes>a:last-child{grid-column:1/-1;max-width:calc(50% - 7px)}.athletes img{height:230px}.athletes h3{font-size:21px}.section{padding:35px 0}.journal{grid-template-columns:1fr;gap:15px;padding-bottom:35px}.journal h2{font-size:36px}.footer-inner{align-items:flex-start;flex-direction:column}.photo figcaption{font-size:9px}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}

.instagram-section{border-top:1px solid var(--line);padding:50px 0 60px}.instagram-grid{display:grid;grid-template-columns:1fr 1.3fr;gap:7%;align-items:start}.instagram-heading h2{font-family:Georgia,serif;font-weight:400;font-size:clamp(36px,4.5vw,62px);letter-spacing:-.04em;margin:20px 0}.instagram-handle{display:block;font-size:18px;overflow-wrap:anywhere;margin:0 0 25px}.instagram-content{min-width:0}.instagram-media{margin:0!important;width:100%!important;min-width:0!important;max-width:540px!important}.instagram-content>blockquote{padding:24px;border:1px solid var(--line);line-height:1.6}.photo .stamp{bottom:20px}.hero-actions{flex-wrap:wrap}@media(max-width:760px){.instagram-grid{grid-template-columns:1fr;gap:28px}.instagram-section{padding:35px 0}.instagram-heading h2{margin:12px 0}.instagram-handle{font-size:16px}.section-top{gap:15px}}

.hero{display:block;padding:48px 0 42px}.hero h1{font-size:clamp(76px,11.5vw,166px)}.hero h1 br{display:none}.hero h1 .club{margin-top:20px}.about-section{border-top:1px solid var(--line);padding:55px 0 65px}.about-grid{display:grid;grid-template-columns:1fr 2fr;gap:7%}.about-section h2{font-family:Georgia,serif;font-size:45px;font-weight:400;letter-spacing:-.04em;margin:15px 0}.about-copy p{font-size:20px;line-height:1.6;margin:0 0 22px;max-width:740px}.about-copy .button{margin-top:5px}@media(max-width:760px){.hero{padding:32px 0}.hero h1{font-size:clamp(70px,16vw,120px)}.hero h1 br{display:block}.about-section{padding:35px 0}.about-grid{grid-template-columns:1fr;gap:12px}.about-section h2{font-size:36px}.about-copy p{font-size:17px}}

.writing-subsection{margin-top:24px;padding-top:24px;border-top:1px solid var(--line)}.writing-subsection>h3{margin:0 0 18px;font-size:21px}.writing-subsection a{padding:16px 0}.writing-subsection h4{font-size:18px;font-weight:500;margin:8px 0 0}

.brand-strip{height:12px;background:#a8e6cf}@media(max-width:760px){header{flex-wrap:wrap}nav{width:100%;gap:8px 16px;flex-wrap:wrap}nav>a:not(.button){display:inline-flex;align-items:center;min-height:44px}nav .button{margin-left:auto}}
</style></head><body>
<div class="brand-strip" aria-hidden="true"></div>
<div class="wrap"><header><a class="brand" href="#" aria-label="Lower Raritan Athletic Club home"><img src="/images/lr-charcoal.png" alt=""><span>LOWER RARITAN<br>ATHLETIC CLUB</span></a><nav aria-label="Main navigation"><a href="#athletes">Athletes</a><a href="#racing">Racing &amp; Results</a><a href="#about">About</a><a class="button" href="#coaching">Coaching</a></nav></header></div><main><div class="wrap">
<section class="hero"><div><p class="eyebrow">New Jersey · Established 2026</p><h1>Lower<br> Raritan<span class="club">Athletic Club.</span></h1><div class="hero-actions"><a class="button" href="#athletes">Athletes</a><a href="/athletes#join-lrac">Join LRAC</a><a href="#coaching">Coaching</a></div></div></section><div class="divider"><span>Distance running · Rowing · Triathlon</span><span>Rooted in New Jersey</span></div></div>

<div class="wrap"><section class="section" id="athletes"><div class="section-top"><h2>01 / Athletes</h2><a href="/athletes">Full roster</a></div><div class="athletes">{featuredAthletes.map((athlete) => (<a href={`/athletes/${athlete.slug}`}><img src={athlete.image} alt={athlete.name} loading="lazy" /><h3>{athlete.name}</h3><p>{athlete.sport} · {athlete.location}</p></a>))}</div></section><section class="journal" id="racing"><div><p class="eyebrow">02</p><h2>Racing &amp; Results</h2></div><div><a href="/racing"><h3>Race Calendar &amp; Results</h3></a><a id="journal" href="/training"><h3>Training logs, reports &amp; writing</h3></a></div></section></div>
<section class="coaching" id="coaching"><div class="wrap coaching-grid"><div><p class="eyebrow">03 / Coaching</p><span class="number" aria-hidden="true">LRAC</span></div><h2>Coaching</h2><div><p class="intro">Tell us where you are now and where you want to go. Start a conversation about coaching with Lower Raritan.</p><a class="button" href="/coaching">Coaching inquiries</a></div></div></section>
<section class="about-section" id="about"><div class="wrap about-grid"><div><p class="eyebrow">04</p><h2>About</h2></div><div class="about-copy"><p>Lower Raritan Athletic Club was founded in Central Jersey in 2026. Our name comes from the watershed that encompasses the place we call home.</p><p>The idea is simple: keep the benefits of a team while taking on the responsibilities that come with age. We just want to train really hard and go fast.</p><a class="button" href="/about">About LRAC</a></div></div></section>
<section class="instagram-section" id="instagram"><div class="wrap instagram-grid"><div class="instagram-heading"><p class="eyebrow">05 / Instagram</p><h2>Instagram</h2><a class="instagram-handle" href="https://www.instagram.com/lowerraritanathletics/" target="_blank" rel="noopener noreferrer">@lowerraritanathletics</a><a class="button" href="https://www.instagram.com/lowerraritanathletics/" target="_blank" rel="noopener noreferrer">View on Instagram</a></div><div class="instagram-content"><blockquote class="instagram-media" data-instgrm-permalink="https://www.instagram.com/lowerraritanathletics/" data-instgrm-version="14"><a href="https://www.instagram.com/lowerraritanathletics/" target="_blank" rel="noopener noreferrer">View @lowerraritanathletics on Instagram</a></blockquote></div></div></section>

</main><footer><div class="wrap footer-inner"><p>Lower Raritan Athletic Club.</p><a href="/athletes#join-lrac">Join the club</a><a href="mailto:lowerraritanac@gmail.com">Get in touch</a></div></footer>

<script is:inline async src="https://www.instagram.com/embed.js"></script>
</body></html>
