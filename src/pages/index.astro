---


import InstagramGallery from "../components/InstagramGallery.astro";
import ClubActivity from "../components/ClubActivity.astro";
import Header from "../components/Header.astro";
import { races } from "../../data/schedule.js";
import { raceDate } from "../lib/race-date.js";
const nextRace = races.filter(r => r.status === "Upcoming" || r.status === "Tentative").sort((a,b) => raceDate(a) - raceDate(b))[0];
const latestResult = races.filter(r => r.status === "Completed").sort((a,b) => raceDate(b) - raceDate(a))[0];
import { site } from "../../data/site.js";


const {
  title = "Lower Raritan Athletic Club | New Jersey",
  description = site.description,
  image = "/images/hero.jpg",
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, "https://lowerraritanac.com");
const socialImage = new URL(image, "https://lowerraritanac.com");
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "SportsOrganization",
  name: site.name,
  alternateName: site.shortName,
  url: "https://lowerraritanac.com",
  description: site.description,
  foundingDate: site.founded,
  areaServed: site.location,
  email: site.email,
  sameAs: [site.social.instagram, site.social.strava],
};

import { athletes } from "../../data/athletes.js";
const featuredAthletes = athletes.filter((athlete) => athlete.currentMember !== false && athlete.featuredOnHomepage !== false).slice(0,3);
---
<!doctype html>
<html lang="en"><head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <meta name="theme-color" content="#f4f1e7" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/jpeg" href="/images/hero.jpg" />
    <link rel="apple-touch-icon" href="/images/hero.jpg" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={site.name} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
  
<style is:global>
@import url('https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=DM+Sans:wght@400;500;600;700&display=swap');
:root{--paper:#f4f1e7;--ink:#20382e;--mint:#c4ddc3;--line:#adb5a5}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font-family:'DM Sans',Arial,sans-serif}a{color:inherit;text-decoration:none}a:hover{text-decoration:underline}a:focus-visible,button:focus-visible{outline:3px solid #d0783b;outline-offset:5px}.wrap{max-width:1480px;margin:auto;padding:0 5%}.legacy-header{display:flex;justify-content:space-between;align-items:center;gap:24px;padding:23px 0;border-bottom:1px solid var(--ink)}.brand{display:flex;align-items:center;gap:12px;font-size:11px;font-weight:700;letter-spacing:.04em;line-height:1.3}.brand img{height:46px;width:37px;object-fit:contain}.legacy-nav{display:flex;align-items:center;gap:28px;font-size:12px}.button{display:inline-flex;align-items:center;justify-content:center;min-height:46px;padding:13px 22px;background:var(--ink);color:var(--paper);font-size:12px;font-weight:600}.button:hover{background:#315944;text-decoration:none}.button.light{background:var(--mint);color:var(--ink)}.eyebrow{font-size:10px;text-transform:uppercase;font-weight:600;letter-spacing:.14em}.hero{display:grid;grid-template-columns:1.2fr 1fr;gap:6%;padding:42px 0 32px;align-items:center}.hero h1{font-family:'Barlow Condensed','Arial Narrow',Impact,sans-serif;font-size:clamp(65px,9.5vw,146px);line-height:.85;letter-spacing:-.025em;text-transform:uppercase;margin:25px 0 32px;font-weight:700}.hero h1 .club{font-family:Georgia,serif;text-transform:none;font-style:italic;font-weight:400;font-size:.59em;letter-spacing:-.055em;display:block;margin-top:13px}.hero-actions{display:flex;align-items:center;gap:24px;font-size:12px}.photo{position:relative;margin:0}.photo>img{display:block;width:100%;height:490px;object-fit:cover;object-position:center 56%;filter:saturate(.8)}.photo figcaption{display:flex;justify-content:space-between;gap:10px;font-size:10px;margin-top:12px}.photo .stamp{position:absolute;bottom:40px;right:20px;width:70px;height:90px;object-fit:contain;filter:none}.divider{display:flex;justify-content:space-between;gap:20px;padding:18px 0;border-top:1px solid var(--ink);font-size:10px;letter-spacing:.11em;text-transform:uppercase}.coaching{background:var(--mint);margin-top:0;padding:47px 0 50px}.coaching-grid{display:grid;grid-template-columns:1fr 1.4fr 1.15fr;gap:5%;align-items:start}.coaching h2{font-family:Georgia,serif;font-size:clamp(34px,4.5vw,62px);font-weight:400;letter-spacing:-.045em;line-height:1.04;margin:0}.coaching .intro{font-size:15px;line-height:1.65;margin:0 0 23px}.coaching .eyebrow{margin:5px 0 20px}.coaching .number{display:block;font-family:'Barlow Condensed',Impact,sans-serif;font-size:66px;line-height:1;margin-top:36px;color:#55735c}.section{padding:58px 0}.section-top{display:flex;justify-content:space-between;align-items:baseline;border-bottom:1px solid var(--line);padding-bottom:15px;margin-bottom:25px}.section-top h2{margin:0;font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:.1em}.section-top a{font-size:12px;text-decoration:underline}.athletes{display:grid;grid-template-columns:repeat(3,1fr);gap:25px}.athletes img{display:block;width:100%;height:300px;object-fit:cover;object-position:center 45%;filter:saturate(.7)}.athletes h3{font-size:25px;letter-spacing:-.04em;margin:15px 0 5px;font-weight:500}.athletes p{font-size:11px;margin:0}.journal{display:grid;grid-template-columns:1fr 2fr;gap:7%;padding-bottom:60px}.journal h2{font-family:Georgia,serif;font-size:45px;line-height:1.06;font-weight:400;letter-spacing:-.04em;margin:15px 0}.journal a{display:block;border-top:1px solid var(--line);padding:20px 0}.journal a span{font-size:10px;text-transform:uppercase;letter-spacing:.1em}.journal h3{font-size:21px;font-weight:500;margin:10px 0 0}footer{background:var(--ink);color:var(--paper);padding:35px 0}.footer-inner{display:flex;align-items:center;justify-content:space-between;gap:20px}.footer-inner p{font-family:Georgia,serif;font-size:24px;margin:0}.footer-inner a{font-size:12px;text-decoration:underline}
@media(min-width:1450px){.photo>img{height:550px}}@media(max-width:760px){.wrap{padding:0 6%}.legacy-header{padding:18px 0;gap:10px}.brand{font-size:9px}.brand img{height:35px;width:28px}.legacy-nav{gap:0}.legacy-nav>a:not(.button){display:none}.legacy-nav .button{font-size:11px;padding:10px 14px;min-height:42px}.hero{grid-template-columns:1fr;padding-top:28px;gap:27px}.hero h1{font-size:clamp(76px,17vw,125px);margin:20px 0 28px}.photo>img{height:360px;object-position:center 53%}.photo .stamp{height:65px;width:50px}.hero-actions{gap:20px}.divider{font-size:9px;flex-wrap:wrap}.coaching-grid{grid-template-columns:1fr;gap:22px}.coaching{padding:30px 0}.coaching .number{display:none}.coaching .eyebrow{margin:0}.coaching h2{font-size:46px}.coaching .intro{max-width:480px}.athletes{gap:15px;grid-template-columns:1fr 1fr}.athletes>a:last-child{grid-column:1/-1;max-width:calc(50% - 7px)}.athletes img{height:230px}.athletes h3{font-size:21px}.section{padding:35px 0}.journal{grid-template-columns:1fr;gap:15px;padding-bottom:35px}.journal h2{font-size:36px}.footer-inner{align-items:flex-start;flex-direction:column}.photo figcaption{font-size:9px}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}

.instagram-section{border-top:1px solid var(--line);padding:50px 0 60px}.instagram-grid{display:grid;grid-template-columns:1fr 1.3fr;gap:7%;align-items:start}.instagram-heading h2{font-family:Georgia,serif;font-weight:400;font-size:clamp(36px,4.5vw,62px);letter-spacing:-.04em;margin:20px 0}.instagram-handle{display:block;font-size:18px;overflow-wrap:anywhere;margin:0 0 25px}.instagram-content{min-width:0}.instagram-media{margin:0!important;width:100%!important;min-width:0!important;max-width:540px!important}.instagram-content>blockquote{padding:24px;border:1px solid var(--line);line-height:1.6}.photo .stamp{bottom:20px}.hero-actions{flex-wrap:wrap}@media(max-width:760px){.instagram-grid{grid-template-columns:1fr;gap:28px}.instagram-section{padding:35px 0}.instagram-heading h2{margin:12px 0}.instagram-handle{font-size:16px}.section-top{gap:15px}}

.hero{display:block;padding:48px 0 42px}.hero h1{font-size:clamp(76px,11.5vw,166px)}.hero h1 br{display:none}.hero h1 .club{margin-top:20px}.about-section{border-top:1px solid var(--line);padding:55px 0 65px}.about-grid{display:grid;grid-template-columns:1fr 2fr;gap:7%}.about-section h2{font-family:Georgia,serif;font-size:45px;font-weight:400;letter-spacing:-.04em;margin:15px 0}.about-copy p{font-size:20px;line-height:1.6;margin:0 0 22px;max-width:740px}.about-copy .button{margin-top:5px}@media(max-width:760px){.hero{padding:32px 0}.hero h1{font-size:clamp(70px,16vw,120px)}.hero h1 br{display:block}.about-section{padding:35px 0}.about-grid{grid-template-columns:1fr;gap:12px}.about-section h2{font-size:36px}.about-copy p{font-size:17px}}

.writing-subsection{margin-top:24px;padding-top:24px;border-top:1px solid var(--line)}.writing-subsection>h3{margin:0 0 18px;font-size:21px}.writing-subsection a{padding:16px 0}.writing-subsection h4{font-size:18px;font-weight:500;margin:8px 0 0}

.brand-strip{height:12px;background:#a8e6cf}@media(max-width:760px){.legacy-header{flex-wrap:wrap}.legacy-nav{width:100%;gap:8px 16px;flex-wrap:wrap}.legacy-nav>a:not(.button){display:inline-flex;align-items:center;min-height:44px}.legacy-nav .button{margin-left:auto}}

.site-.legacy-header{position:sticky;top:0;z-index:20;background:var(--paper);border-bottom:1px solid var(--line)}.site-header .legacy-header{padding:16px 0;border:0}.site-header .legacy-nav{gap:4px;font-size:13px}.site-header nav a{display:inline-flex;align-items:center;justify-content:center;min-height:46px;padding:12px 14px;font-weight:600;border-radius:3px;transition:background .15s ease}.site-header nav a:hover{background:#a8e6cf;text-decoration:none}.site-header nav a.button{margin-left:8px}.site-header nav a.button:hover{background:#315944;color:var(--paper)}.menu-toggle{display:none}section[id],#journal{scroll-margin-top:100px}
@media(max-width:1050px){.site-header .legacy-header{flex-wrap:wrap;gap:14px}.site-header .legacy-nav{width:100%;flex-wrap:wrap}.site-header nav a.button{margin-left:auto}.nav-ready .menu-toggle{display:flex;align-items:center;gap:14px;min-height:46px;padding:10px 16px;border:1px solid var(--ink);background:transparent;color:var(--ink);font:600 13px 'DM Sans',Arial,sans-serif;cursor:pointer}.menu-toggle span{font-size:22px;font-weight:400}.nav-ready #main-navigation{display:none}.nav-ready #main-navigation.is-open{display:grid;grid-template-columns:1fr 1fr;gap:8px;padding:12px 0 4px;border-top:1px solid var(--line)}.site-header nav a{justify-content:flex-start;background:#e6ecdf}.site-header nav a.button{margin:0;background:var(--ink)}section[id],#journal{scroll-margin-top:88px}}
@media(prefers-reduced-motion:reduce){.site-header nav a{transition:none}}

.athletes img.aaron-photo{object-position:38% 12%}
.race-hub{padding:30px 0 65px}.hub-heading{display:flex;justify-content:space-between;gap:35px;align-items:end;margin-bottom:28px;border-top:1px solid var(--line);padding-top:28px}.hub-heading h2{font:400 clamp(34px,4vw,54px)/1.08 Georgia,serif;letter-spacing:-.04em;margin:18px 0 0}.hub-heading>p{max-width:290px;line-height:1.65;font-size:15px;margin:0}.hub-links{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.hub-card{display:flex;flex-direction:column;padding:26px;background:#e2eddf;border:1px solid #7f9480;min-width:0;transition:background .15s}.hub-card:nth-child(2){background:#a8e6cf}.hub-card:nth-child(3){background:#e9e8d9}.hub-card:hover{background:#c1dcc3;text-decoration:none}.hub-card:focus-visible{outline:3px solid var(--ink);outline-offset:4px}.hub-kicker{display:flex;justify-content:space-between;font-size:10px;text-transform:uppercase;letter-spacing:.09em;font-weight:600}.hub-kicker>span{font-size:20px}.hub-card h3{font:500 28px/1.12 'DM Sans',Arial,sans-serif;letter-spacing:-.04em;margin:24px 0 12px}.hub-card>p{font-size:14px;line-height:1.6;margin:0 0 25px}.hub-detail{display:grid;gap:8px;border-top:1px solid #a1b49e;padding:18px 0 26px;margin-top:auto}.hub-detail span{font-size:11px}.hub-detail strong{font-size:16px;line-height:1.4;font-weight:600}.hub-cta{display:flex;justify-content:space-between;gap:8px;font-size:13px;font-weight:700;text-decoration:underline;text-underline-offset:4px;min-height:30px;align-items:center}
@media(max-width:760px){.hub-heading{display:block}.hub-heading>p{margin-top:18px}.hub-links{grid-template-columns:1fr}.hub-card{padding:24px}.hub-card h3{margin-top:12px}.hub-card>p{margin-bottom:12px}.hub-detail{padding:15px 0}.race-hub{padding:18px 0 40px}}
</style></head><body>
<div class="brand-strip" aria-hidden="true"></div>
<Header /><main><div class="wrap">
<section class="hero"><div><p class="eyebrow">New Jersey · Established 2026</p><h1>Lower<br> Raritan<span class="club">Athletic Club.</span></h1><div class="hero-actions"><a class="button" href="#athletes">Athletes</a><a href="/athletes#join-lrac">Join LRAC</a><a href="#coaching">Coaching</a></div></div></section><div class="divider"><span>Distance running · Rowing · Triathlon</span><span>New Jersey</span></div></div>

<div class="wrap"><section class="section" id="athletes"><div class="section-top"><h2>01 / Athletes</h2><a href="/athletes">Full roster</a></div><div class="athletes">{featuredAthletes.map((athlete) => (<a href={`/athletes/${athlete.slug}`}><img class:list={[athlete.slug === "aaron-wysocki" && "aaron-photo"]} src={athlete.image} alt={athlete.name} loading="lazy" /><h3>{athlete.name}</h3><p>{athlete.sport} · {athlete.location}</p></a>))}</div></section><section class="race-hub" id="racing" aria-labelledby="race-hub-title">
<div class="hub-heading"><div><p class="eyebrow">02 / Racing &amp; Results</p><h2 id="race-hub-title">Racing &amp; Results</h2></div></div>
<div class="hub-links">
<a class="hub-card" href="/racing#schedule"><span class="hub-kicker">Schedule <span aria-hidden="true">↗</span></span><h3>Race Calendar</h3><p>Upcoming races and participating athletes.</p>{nextRace && <div class="hub-detail"><span>{nextRace.date} · {nextRace.year}</span><strong>{nextRace.event}</strong></div>}<span class="hub-cta">View race schedule <span aria-hidden="true">→</span></span></a>
<a class="hub-card" href="/racing#results"><span class="hub-kicker">Results <span aria-hidden="true">↗</span></span><h3>Results</h3><p>Race times and places.</p>{latestResult && <div class="hub-detail"><span>{latestResult.event}</span><strong>{latestResult.result}</strong></div>}<span class="hub-cta">View race results <span aria-hidden="true">→</span></span></a>
<a class="hub-card" href="/training"><span class="hub-kicker">Training <span aria-hidden="true">↗</span></span><h3>Training &amp; Writing</h3><p>Training logs, race reports, and writing from our athletes.</p><span class="hub-cta">Read training &amp; writing <span aria-hidden="true">→</span></span></a>
</div></section></div>
<section class="coaching" id="coaching"><div class="wrap coaching-grid"><div><p class="eyebrow">03 / Coaching</p><span class="number" aria-hidden="true">LRAC</span></div><h2>Coaching</h2><div><p class="intro">Contact LRAC about coaching.</p><a class="button" href="/coaching">Coaching inquiries</a></div></div></section>
<section class="about-section" id="about"><div class="wrap about-grid"><div><p class="eyebrow">04</p><h2>About</h2></div><div class="about-copy"><p>Lower Raritan Athletic Club was founded in Central Jersey in 2026. Our name comes from the watershed that encompasses the place we call home.</p><p>The idea is simple: keep the benefits of a team while taking on the responsibilities that come with age. We just want to train really hard and go fast.</p><a class="button" href="/about">About LRAC</a></div></div></section>
<InstagramGallery />

<ClubActivity />
</main><footer><div class="wrap footer-inner"><p>Lower Raritan Athletic Club.</p><a href="/athletes#join-lrac">Join the club</a><a href="mailto:lowerraritanac@gmail.com">Get in touch</a></div></footer>



</body></html>
