---
import BaseLayout from "../layouts/BaseLayout.astro";
import AthleteCard from "../components/AthleteCard.astro";
import { athletes } from "../../data/athletes.js";
import { races } from "../../data/schedule.js";
import { site } from "../../data/site.js";
import { getCollection } from "astro:content";

const upcomingRaces = races
  .filter((race) => race.status === "Upcoming" || race.status === "Tentative")
  .slice(0, 3);

const posts = await getCollection("training");
const featuredPosts = [...posts]
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<BaseLayout title={site.name} description={site.description}>
  <section class="hero">
    <div class="section-inner hero-inner">
      <div class="hero-kicker">
        <span>EST. {site.founded}</span>
        <span>{site.location}</span>
      </div>

      <h1>Lower Raritan Athletic Club</h1>

      <div class="hero-bottom">
        <p>{site.description}</p>
        <div class="hero-links">
          <a href={site.social.instagram} target="_blank" rel="noreferrer">Instagram ↗</a>
          <a href={site.social.strava} target="_blank" rel="noreferrer">Strava ↗</a>
        </div>
      </div>
    </div>
  </section>

  <section class="athletes-section">
    <div class="section-inner">
      <div class="section-header">
        <div>
          <p class="section-label">THE CLUB</p>
          <h2>Athletes</h2>
        </div>
        <a class="text-link desktop-roster-link" href="/athletes">Full roster →</a>
      </div>

      <div class="athlete-grid">
        {athletes.slice(0, 3).map((athlete) => <AthleteCard athlete={athlete} />)}
        <a class="roster-tile" href="/athletes">
          <div class="roster-tile-top">
            <span class="roster-count">03</span>
            <span class="roster-arrow">↗</span>
          </div>
          <div class="roster-tile-bottom">
            <span class="roster-label">View all</span>
            <strong>ATHLETES</strong>
          </div>
        </a>
      </div>
    </div>
  </section>

  <section class="activity-section">
    <div class="section-inner activity-grid">
      <div class="activity-heading">
        <p class="section-label">CLUB ACTIVITY</p>
        <h2>Strava</h2>
        <a class="text-link" href={site.social.strava} target="_blank" rel="noreferrer">Open club ↗</a>
      </div>

      <div class="strava-frame-wrap">
        <iframe
          title="Lower Raritan Athletic Club latest Strava activity"
          allowtransparency="true"
          frameborder="0"
          height="454"
          scrolling="no"
          src={site.social.stravaEmbed}
          width="300"
          loading="lazy"
        ></iframe>
      </div>
    </div>
  </section>

  <section class="racing-section">
    <div class="section-inner">
      <div class="section-header">
        <div>
          <p class="section-label">NEXT ON THE CALENDAR</p>
          <h2>Racing</h2>
        </div>
        <a class="text-link light-link" href="/racing">All racing →</a>
      </div>

      <div class="race-list">
        {upcomingRaces.map((race) => (
          <article class="race-row">
            <div class="race-date"><strong>{race.date}</strong><span>{race.year}</span></div>
            <div class="race-event"><p>{race.discipline}</p><h3>{race.event}</h3><span>{race.location}</span></div>
            <div class="race-athletes">{race.athletes.join(" · ")}</div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="training-section">
    <div class="section-inner">
      <div class="section-header">
        <div>
          <p class="section-label">WRITING & TRAINING</p>
          <h2>From the Club</h2>
        </div>
        <a class="text-link" href="/training">All posts →</a>
      </div>

      <div class="post-list">
        {featuredPosts.map((post) => (
          <a class="post-row" href={`/training/${post.id}`}>
            <div class="post-type">{post.data.category}</div>
            <div class="post-main">
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
            </div>
            <div class="post-meta">
              <span>{post.data.athlete}</span>
              <span>{post.data.date.toLocaleDateString("en-US", { month: "short", year: "numeric" })}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="about-section">
    <div class="section-inner about-grid">
      <p class="section-label">ABOUT LRAC</p>
      <div>
        <p class="about-copy">Work in progress.</p>
        <a class="text-link" href="/about">About the club →</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { background: var(--beige-light); border-bottom: 1px solid var(--black); }
  .hero-inner { padding-top: 74px; padding-bottom: 62px; }
  .hero-kicker { display: flex; justify-content: space-between; gap: 20px; margin-bottom: 30px; font-size: 9px; font-weight: 700; letter-spacing: 1.8px; text-transform: uppercase; }
  .hero h1 { max-width: 900px; margin: 0; font-size: clamp(48px, 5.6vw, 78px); line-height: 1.05; letter-spacing: -2.2px; text-transform: uppercase; }
  .hero-bottom { display: grid; grid-template-columns: 1fr auto; gap: 30px; align-items: end; margin-top: 34px; padding-top: 16px; border-top: 1px solid var(--black); }
  .hero-bottom p { margin: 0; font-size: 14px; }
  .hero-links { display: flex; gap: 18px; flex-wrap: wrap; justify-content: flex-end; }
  .hero-links a { color: var(--black); text-decoration: none; font-size: 9px; font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase; border-bottom: 1px solid currentColor; padding-bottom: 3px; }
  .hero-links a:hover { opacity: .5; }

  .athletes-section, .activity-section, .racing-section, .training-section, .about-section { padding: 86px 0 100px; }
  .section-header { display: flex; align-items: flex-end; justify-content: space-between; gap: 30px; margin-bottom: 34px; }
  .section-header h2, .activity-heading h2 { margin: 7px 0 0; font-size: clamp(54px, 6vw, 84px); line-height: .94; letter-spacing: -2.8px; text-transform: uppercase; }

  .athletes-section { background: var(--beige-light); }
  .athlete-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; }
  .roster-tile { display: none; }

  .activity-section { background: var(--mint); border-top: 1px solid var(--black); border-bottom: 1px solid var(--black); }
  .activity-grid { display: grid; grid-template-columns: 1fr minmax(300px, 430px); gap: 72px; align-items: start; }
  .activity-heading { position: sticky; top: 96px; }
  .activity-heading .text-link { margin-top: 26px; }
  .strava-frame-wrap { justify-self: end; width: 100%; max-width: 430px; padding: 22px; background: var(--beige-light); border: 1px solid var(--black); }
  .strava-frame-wrap iframe { display: block; width: 100%; max-width: 300px; margin: 0 auto; }

  .racing-section { background: var(--black); color: var(--white); }
  .light-link { color: var(--white); }
  .race-list { border-top: 1px solid rgba(255,255,255,.46); }
  .race-row { display: grid; grid-template-columns: 120px 1fr 260px; gap: 28px; align-items: center; padding: 25px 0; border-bottom: 1px solid rgba(255,255,255,.3); }
  .race-date strong { display: block; font-family: var(--display-font); font-size: 23px; letter-spacing: -.4px; }
  .race-date span { display: block; margin-top: 2px; color: #8d8d8d; font-size: 9px; }
  .race-event p { margin: 0 0 5px; color: var(--mint); font-size: 8px; font-weight: 800; letter-spacing: 1.6px; text-transform: uppercase; }
  .race-event h3 { margin: 0; font-size: 28px; line-height: 1; letter-spacing: -.8px; text-transform: uppercase; }
  .race-event span { display: block; margin-top: 5px; color: #aaa; font-size: 11px; }
  .race-athletes { font-size: 11px; font-weight: 700; }

  .training-section { background: var(--beige); }
  .post-list { border-top: 1px solid var(--black); }
  .post-row { display: grid; grid-template-columns: 130px 1fr 180px; gap: 28px; align-items: center; padding: 28px 0; border-bottom: 1px solid var(--black); color: var(--black); text-decoration: none; }
  .post-type, .post-meta { font-size: 9px; font-weight: 800; letter-spacing: 1.25px; text-transform: uppercase; }
  .post-main h3 { margin: 0; font-size: clamp(26px, 3.4vw, 40px); line-height: 1; letter-spacing: -1px; text-transform: uppercase; }
  .post-main p { margin: 9px 0 0; color: var(--gray); font-size: 13px; }
  .post-meta { display: flex; flex-direction: column; gap: 5px; align-items: flex-start; }
  .post-row:hover .post-main h3 { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 5px; }

  .about-section { background: var(--mint); border-top: 1px solid var(--black); }
  .about-grid { display: grid; grid-template-columns: 180px 1fr; gap: 72px; }
  .about-copy { margin: 0 0 30px; font-family: var(--display-font); font-size: clamp(40px, 5vw, 68px); font-weight: 800; line-height: 1; letter-spacing: -1.8px; text-transform: uppercase; }

  @media (max-width: 850px) {
    .hero-inner { padding-top: 42px; padding-bottom: 42px; }
    .hero-kicker { margin-bottom: 22px; }
    .hero h1 { max-width: 100%; font-size: clamp(34px, 9.6vw, 44px); line-height: 1.08; letter-spacing: -1.2px; }
    .hero-bottom { grid-template-columns: 1fr; gap: 14px; margin-top: 24px; }
    .hero-links { justify-content: flex-start; }
    .athletes-section, .activity-section, .racing-section, .training-section, .about-section { padding: 58px 0 68px; }
    .section-header { flex-direction: column; align-items: flex-start; gap: 10px; }
    .section-header h2, .activity-heading h2 { font-size: 42px; line-height: 1; letter-spacing: -1.5px; }
    .desktop-roster-link { display: none; }
    .athlete-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 26px 12px; align-items: start; }
    .athlete-grid > * { min-width: 0; }
    .roster-tile {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      aspect-ratio: 4 / 5;
      min-width: 0;
      padding: 14px;
      border: 1px solid var(--black);
      background: var(--mint);
      color: var(--black);
      text-decoration: none;
      text-transform: uppercase;
    }
    .roster-tile-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; padding-bottom: 12px; border-bottom: 1px solid var(--black); }
    .roster-count, .roster-label { font-size: 8px; font-weight: 700; letter-spacing: 1px; }
    .roster-arrow { font-size: 18px; line-height: 1; }
    .roster-tile-bottom { display: flex; flex-direction: column; gap: 5px; }
    .roster-tile-bottom strong { max-width: 100%; font-size: clamp(18px, 5vw, 24px); line-height: 1; letter-spacing: -.8px; overflow-wrap: anywhere; }
    .activity-grid { grid-template-columns: 1fr; gap: 30px; }
    .activity-heading { position: static; }
    .strava-frame-wrap { justify-self: stretch; max-width: none; padding: 14px; }
    .race-row, .post-row { grid-template-columns: 78px 1fr; gap: 16px; }
    .race-athletes, .post-meta { grid-column: 2; }
    .post-type { align-self: start; }
    .about-grid { grid-template-columns: 1fr; gap: 24px; }
  }
</style>
