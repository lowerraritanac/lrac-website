---
import BaseLayout from "../layouts/BaseLayout.astro";
import AthleteCard from "../components/AthleteCard.astro";
import { athletes } from "../../data/athletes.js";
import { races } from "../../data/schedule.js";
import { site } from "../../data/site.js";
import { getCollection } from "astro:content";

const upcomingRaces = races.filter((race) => race.status === "Upcoming" || race.status === "Tentative").slice(0, 3);
const posts = await getCollection("training");
const sortedPosts = [...posts].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const recentReports = sortedPosts.slice(0, 3);
---

<BaseLayout title={site.name} description={site.description}>
  <section class="hero">
    <div class="section-inner hero-inner">
      <div><p class="eyebrow">EST. {site.founded} · {site.location}</p><h1>{site.name}</h1></div>
      <div class="hero-links"><a href={site.social.instagram} target="_blank" rel="noreferrer">Instagram ↗</a><a href={site.social.strava} target="_blank" rel="noreferrer">Strava ↗</a></div>
    </div>
  </section>

  <section class="athletes-section">
    <div class="section-inner">
      <div class="section-topline"><p class="section-label">The Club / 01</p><a class="text-link desktop-roster-link" href="/athletes">Full roster →</a></div>
      <div class="athlete-grid">
        {athletes.slice(0, 3).map((athlete) => <AthleteCard athlete={athlete} />)}
        <a class="mobile-roster-tile" href="/athletes">
          <span>03 Athletes</span>
          <strong>Full<br />Roster</strong>
          <b>→</b>
        </a>
      </div>
    </div>
  </section>

  <section class="racing-section">
    <div class="section-inner">
      <div class="section-topline light-line"><p class="section-label">Competition / 02</p><a class="text-link light-link" href="/racing">All racing →</a></div>
      <div class="race-list">{upcomingRaces.map((race) => (
        <article class="race-row">
          <div class="race-date"><strong>{race.date}</strong><span>{race.year}</span></div>
          <div class="race-event"><p>{race.discipline}</p><h3>{race.event}</h3><span>{race.location}</span></div>
          <div class="race-athletes">{race.athletes.map((name, index) => (<><a href={`/athletes/${race.athleteSlugs[index]}`}>{name}</a>{index < race.athletes.length - 1 && <span> · </span>}</>))}</div>
        </article>
      ))}</div>
    </div>
  </section>

  <section class="training-gateway">
    <div class="section-inner training-strip">
      <div class="training-title"><span>Training / 03</span><strong>Volume</strong></div>
      <div class="training-actions"><a href="/training/liam-tilton">Liam Tilton →</a><a href="/training/aaron-wysocki">Aaron Wysocki →</a><a href="/training">All training & writing →</a></div>
    </div>
  </section>

  {recentReports.length > 0 && (
    <section class="reports-section"><div class="section-inner reports-grid"><div class="reports-heading"><p class="section-label">Journal / 04</p></div><div class="post-list">{recentReports.map((post) => (<a class="post-row" href={`/training/${post.id}`}><div class="post-meta"><span>{post.data.category}</span><span>{post.data.date.toLocaleDateString("en-US", { month: "short", day: "numeric" })}</span></div><div class="post-main"><h3>{post.data.title}</h3>{post.data.description && <p>{post.data.description}</p>}</div><span class="post-arrow">→</span></a>))}<a class="all-writing" href="/training">All writing & training →</a></div></div></section>
  )}

  <section class="activity-section"><div class="section-inner activity-grid"><div><p class="section-label">Club Activity</p><a class="text-link" href={site.social.strava} target="_blank" rel="noreferrer">View club ↗</a></div><div class="strava-frame-wrap"><iframe title="Lower Raritan Athletic Club latest Strava activity" allowtransparency="true" frameborder="0" height="454" scrolling="no" src={site.social.stravaEmbed} width="300" loading="lazy"></iframe></div></div></section>
  <section class="about-strip"><div class="section-inner about-strip-inner"><p class="section-label">LRAC / New Jersey / 2026</p><a href="/about">About the club →</a></div></section>
</BaseLayout>

<style>
.hero{background:var(--paper);border-bottom:1px solid var(--ink)}.hero-inner{display:flex;justify-content:space-between;gap:48px;align-items:flex-end;padding-top:52px;padding-bottom:46px}.hero h1{margin:12px 0 0;max-width:720px;font-size:clamp(34px,4vw,58px);line-height:1;letter-spacing:-.035em}.hero-links{display:flex;gap:18px;flex-wrap:wrap;justify-content:flex-end}.hero-links a,.training-actions a{font-family:var(--mono);font-size:10px;font-weight:600;letter-spacing:.07em;text-decoration:none;text-transform:uppercase;border-bottom:1px solid currentColor;padding-bottom:3px}.athletes-section,.racing-section,.reports-section{padding:70px 0 82px}.section-topline{display:flex;justify-content:space-between;align-items:baseline;gap:30px;padding-bottom:14px;margin-bottom:30px;border-bottom:1px solid var(--ink)}.athlete-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.mobile-roster-tile{display:none}.racing-section{background:var(--ink);color:var(--white)}.light-line{border-color:rgba(255,255,255,.45)}.light-link{color:var(--white)}.race-list{border-top:1px solid rgba(255,255,255,.32)}.race-row{display:grid;grid-template-columns:112px 1fr 240px;gap:28px;align-items:center;padding:24px 0;border-bottom:1px solid rgba(255,255,255,.28)}.race-date strong{display:block;font-family:var(--mono);font-size:18px}.race-date span{display:block;margin-top:4px;color:#969696;font-family:var(--mono);font-size:9px}.race-event p{margin:0 0 5px;color:var(--mint);font-family:var(--mono);font-size:9px;text-transform:uppercase}.race-event h3{margin:0;font-size:clamp(28px,3.2vw,42px);line-height:.98;letter-spacing:-.025em}.race-event>span{display:block;margin-top:7px;color:#aaa;font-family:var(--mono);font-size:10px}.race-athletes{font-family:var(--mono);font-size:10px}.race-athletes a{color:inherit;text-decoration:none}.training-gateway{padding:26px 0;background:var(--beige);border-bottom:1px solid var(--ink)}.training-strip{display:flex;justify-content:space-between;gap:30px;align-items:center}.training-title{display:flex;align-items:baseline;gap:18px}.training-title span{font-family:var(--mono);font-size:9px;text-transform:uppercase}.training-title strong{font-family:var(--editorial);font-size:30px}.training-actions{display:flex;gap:20px;flex-wrap:wrap;justify-content:flex-end}.reports-section{background:var(--paper)}.reports-grid{display:grid;grid-template-columns:220px 1fr;gap:58px}.post-list{border-top:1px solid var(--ink)}.post-row{display:grid;grid-template-columns:130px 1fr auto;gap:28px;align-items:start;padding:24px 0;border-bottom:1px solid var(--ink);color:var(--ink);text-decoration:none}.post-meta{display:flex;flex-direction:column;gap:6px;font-family:var(--mono);font-size:9px;text-transform:uppercase}.post-main h3{margin:0;font-size:clamp(30px,3.2vw,42px);line-height:1}.post-main p{max-width:620px;margin:8px 0 0;color:var(--gray);font-size:15px;line-height:1.45}.post-arrow{font-family:var(--mono);font-size:18px}.all-writing{display:inline-block;margin-top:22px;font-family:var(--mono);font-size:10px;font-weight:600;text-transform:uppercase;text-decoration:none;border-bottom:1px solid currentColor;padding-bottom:3px}.activity-section{padding:38px 0;background:var(--beige);border-top:1px solid var(--ink)}.activity-grid{display:grid;grid-template-columns:1fr 300px;gap:48px}.strava-frame-wrap{width:300px;overflow:hidden;border:1px solid var(--ink);background:var(--white)}.strava-frame-wrap iframe{display:block;width:300px}.about-strip{padding:24px 0;background:var(--mint);border-top:1px solid var(--ink)}.about-strip-inner{display:flex;justify-content:space-between;gap:24px;align-items:center}.about-strip a{font-family:var(--mono);font-size:10px;font-weight:600;text-transform:uppercase;text-decoration:none}
@media(max-width:850px){.hero-inner{display:block;padding-top:28px;padding-bottom:30px}.hero h1{font-size:clamp(30px,8vw,38px);line-height:1.02}.hero-links{justify-content:flex-start;margin-top:20px}.athletes-section,.racing-section,.reports-section{padding:40px 0 48px}.section-topline{margin-bottom:20px}.desktop-roster-link{display:none}.athlete-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:28px 12px}.mobile-roster-tile{display:flex;position:relative;min-height:0;aspect-ratio:4/5;flex-direction:column;justify-content:space-between;padding:12px;background:var(--mint);border:1px solid var(--ink);color:var(--ink);text-decoration:none}.mobile-roster-tile span,.mobile-roster-tile b{font-family:var(--mono);font-size:7px;text-transform:uppercase}.mobile-roster-tile strong{font-family:var(--editorial);font-size:clamp(24px,7vw,34px);font-weight:600;line-height:.9}.mobile-roster-tile b{font-size:16px;align-self:flex-end}.race-row{grid-template-columns:68px 1fr;gap:12px}.race-athletes{grid-column:2}.training-gateway{padding:20px 0}.training-strip{display:block}.training-title{justify-content:space-between;border-bottom:1px solid var(--ink);padding-bottom:10px}.training-title strong{font-size:26px}.training-actions{justify-content:flex-start;gap:10px 16px;padding-top:12px}.training-actions a{font-size:8px}.reports-grid{grid-template-columns:1fr;gap:20px}.post-row{grid-template-columns:1fr auto;gap:14px}.post-meta{grid-column:1/-1;flex-direction:row;justify-content:space-between}.post-main p{font-size:14px}.activity-grid{grid-template-columns:1fr;gap:18px}.strava-frame-wrap{width:100%;max-width:300px}.about-strip-inner{align-items:flex-start;flex-direction:column}}
</style>