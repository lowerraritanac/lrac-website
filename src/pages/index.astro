---
import BaseLayout from "../layouts/BaseLayout.astro";
import AthleteCard from "../components/AthleteCard.astro";
import { athletes } from "../../data/athletes.js";
import { races } from "../../data/schedule.js";
import { site } from "../../data/site.js";
import { getCollection } from "astro:content";

const upcomingRaces = races.filter((race) => race.status === "Upcoming" || race.status === "Tentative").slice(0, 3);
const posts = await getCollection("training");
const sortedPosts = [...posts]
  .filter((post) => post.data.visibility !== "athlete-only")
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const recentReports = sortedPosts.slice(0, 3);
---

<BaseLayout title="Lower Raritan Athletic Club | New Jersey" description={site.description}>
  <section class="hero">
    <div class="section-inner hero-grid">
      <div class="hero-main">
        <p class="eyebrow">EST. {site.founded} · {site.location}</p>
        <h1>{site.name}</h1>
        <p class="mission">Our mission is to prove to ourselves that growing up doesn’t mean killing your dreams.</p>
        <div class="hero-actions">
          <a class="primary-action" href="/athletes">Meet the athletes →</a>
          <a href="/about">Why LRAC →</a>
          <a href="/athletes#join-lrac">Join LRAC →</a>
        </div>
      </div>

      <aside class="hero-side">
        <p>We’re not sponsored. We’re not creatives. We just want to train really hard and go fast.</p>
        <div class="hero-facts">
          <div><span>Club</span><strong>LRAC</strong></div>
          <div><span>Athletes</span><strong>{String(athletes.length).padStart(2, "0")}</strong></div>
          <div><span>Sports</span><strong>Running · Rowing</strong></div>
        </div>
        <div class="hero-social"><a href={site.social.instagram} target="_blank" rel="noreferrer">Instagram ↗</a><a href={site.social.strava} target="_blank" rel="noreferrer">Strava ↗</a></div>
      </aside>
    </div>
  </section>

  <section class="entry-strip">
    <div class="section-inner entry-grid">
      <span>Start here</span>
      <a href="/athletes"><b>01</b>Athletes <i>→</i></a>
      <a href="/training"><b>02</b>Training & Writing <i>→</i></a>
      <a href="/racing"><b>03</b>Racing <i>→</i></a>
      <a href="/about"><b>04</b>About <i>→</i></a>
    </div>
  </section>

  <section class="athletes-section">
    <div class="section-inner">
      <div class="section-topline"><p class="section-label">The Club / 01</p><a class="text-link desktop-roster-link" href="/athletes">Full roster →</a></div>
      <div class="athlete-grid">
        {athletes.slice(0, 3).map((athlete) => <AthleteCard athlete={athlete} />)}
        <a class="mobile-roster-tile" href="/athletes">
          <span>{String(athletes.length).padStart(2, "0")} Athletes</span>
          <strong>Full<br />Roster</strong>
          <b>→</b>
        </a>
      </div>
    </div>
  </section>

  {recentReports.length > 0 && (
    <section class="reports-section">
      <div class="section-inner reports-grid">
        <div class="reports-heading"><p class="section-label">Journal / 02</p><h2>Latest</h2></div>
        <div class="post-list">
          {recentReports.map((post) => (
            <a class="post-row" href={`/training/${post.id}`}>
              <div class="post-meta"><span>{post.data.category}</span><span>{post.data.date.toLocaleDateString("en-US", { month: "short", day: "numeric" })}</span></div>
              <div class="post-main"><h3>{post.data.title}</h3>{post.data.description && <p>{post.data.description}</p>}</div>
              <span class="post-arrow">→</span>
            </a>
          ))}
          <a class="all-writing" href="/training">All writing & training →</a>
        </div>
      </div>
    </section>
  )}

  <section class="racing-section">
    <div class="section-inner">
      <div class="section-topline light-line"><p class="section-label">Competition / 03</p><a class="text-link light-link" href="/racing">All racing →</a></div>
      <div class="race-list">{upcomingRaces.map((race) => (
        <article class="race-row">
          <div class="race-date"><strong>{race.date}</strong><span>{race.year}</span></div>
          <div class="race-event"><p>{race.discipline}</p><h3>{race.event}</h3><span>{race.location}</span></div>
          <div class="race-athletes">{race.athletes.map((name, index) => (<><a href={`/athletes/${race.athleteSlugs[index]}`}>{name}</a>{index < race.athletes.length - 1 && <span> · </span>}</>))}</div>
        </article>
      ))}</div>
    </div>
  </section>

  <section class="training-gateway">
    <div class="section-inner training-strip">
      <div class="training-title"><span>Training / 04</span><strong>Volume</strong></div>
      <div class="training-actions"><a href="/training/liam-tilton">Liam Tilton →</a><a href="/training/aaron-wysocki">Aaron Wysocki →</a><a href="/training">All training & writing →</a></div>
    </div>
  </section>

  <section class="activity-section">
    <div class="section-inner activity-grid">
      <div class="activity-copy"><p class="section-label">Club Activity</p><h2>Follow along.</h2><div class="activity-links"><a class="text-link" href={site.social.strava} target="_blank" rel="noreferrer">Strava club ↗</a><a class="text-link" href={site.social.instagram} target="_blank" rel="noreferrer">Instagram ↗</a></div></div>
      <div class="strava-frame-wrap"><iframe title="Lower Raritan Athletic Club latest Strava activity" allowtransparency="true" frameborder="0" height="454" scrolling="no" src={site.social.stravaEmbed} width="300" loading="lazy"></iframe></div>
    </div>
  </section>

  <section class="about-strip">
    <div class="section-inner about-strip-inner">
      <p>Hopefully a dream is alive within you.</p>
      <div><a href="/about">About the club →</a><a href="/athletes#join-lrac">Join LRAC →</a></div>
    </div>
  </section>
</BaseLayout>

<style>
.hero{background:var(--paper);border-bottom:1px solid var(--ink)}.hero-grid{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(300px,.75fr);gap:72px;padding-top:64px;padding-bottom:62px;align-items:end}.hero h1{margin:14px 0 0;max-width:850px;font-size:clamp(58px,7.4vw,106px);line-height:.88;letter-spacing:-.05em}.mission{max-width:780px;margin:30px 0 0;font-family:var(--editorial);font-size:clamp(24px,2.6vw,38px);line-height:1.12;letter-spacing:-.02em}.hero-actions{display:flex;align-items:center;gap:10px 18px;flex-wrap:wrap;margin-top:28px}.hero-actions a,.hero-social a,.training-actions a{font-family:var(--mono);font-size:9px;font-weight:600;letter-spacing:.07em;text-decoration:none;text-transform:uppercase;border-bottom:1px solid currentColor;padding-bottom:3px}.hero-actions>a:not(.primary-action){padding-top:10px;padding-bottom:4px}.hero-actions .primary-action{padding:10px 12px;background:var(--ink);color:var(--white);border:1px solid var(--ink)}.hero-actions .primary-action:hover{background:var(--mint);color:var(--ink)}.hero-side{border-top:1px solid var(--ink);padding-top:18px}.hero-side>p{margin:0;font-family:var(--editorial);font-size:19px;line-height:1.38}.hero-facts{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));margin-top:24px;border-top:1px solid var(--ink);border-bottom:1px solid var(--ink)}.hero-facts div{padding:12px 10px 12px 0}.hero-facts div+div{padding-left:10px;border-left:1px solid var(--ink)}.hero-facts span,.hero-facts strong{display:block;font-family:var(--mono)}.hero-facts span{font-size:6px;color:var(--gray);text-transform:uppercase}.hero-facts strong{margin-top:5px;font-size:9px;line-height:1.35;text-transform:uppercase}.hero-social{display:flex;gap:16px;margin-top:16px}.entry-strip{background:var(--mint);border-bottom:1px solid var(--ink)}.entry-grid{display:grid;grid-template-columns:130px repeat(4,1fr);align-items:stretch}.entry-grid>span{padding:15px 16px 15px 0;font-family:var(--mono);font-size:8px;font-weight:600;text-transform:uppercase;display:flex;align-items:center}.entry-grid a{display:grid;grid-template-columns:26px 1fr auto;gap:8px;align-items:center;padding:15px;border-left:1px solid var(--ink);color:var(--ink);text-decoration:none;font-family:var(--mono);font-size:8px;font-weight:600;text-transform:uppercase}.entry-grid a:hover{background:var(--ink);color:var(--white)}.entry-grid b,.entry-grid i{font-style:normal;font-weight:600}.athletes-section,.racing-section,.reports-section{padding:70px 0 82px}.section-topline{display:flex;justify-content:space-between;align-items:baseline;gap:30px;padding-bottom:14px;margin-bottom:30px;border-bottom:1px solid var(--ink)}.athlete-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.mobile-roster-tile{display:none}.reports-section{background:var(--beige);border-top:1px solid var(--ink)}.reports-grid{display:grid;grid-template-columns:220px 1fr;gap:58px}.reports-heading h2{margin:14px 0 0;font-size:clamp(44px,5vw,64px);line-height:.95}.post-list{border-top:1px solid var(--ink)}.post-row{display:grid;grid-template-columns:130px 1fr auto;gap:28px;align-items:start;padding:24px 0;border-bottom:1px solid var(--ink);color:var(--ink);text-decoration:none}.post-row:hover h3,.post-row:hover .post-arrow{color:var(--mint-dark)}.post-meta{display:flex;flex-direction:column;gap:6px;font-family:var(--mono);font-size:9px;text-transform:uppercase}.post-main h3{margin:0;font-size:clamp(30px,3.2vw,42px);line-height:1}.post-main p{max-width:620px;margin:8px 0 0;color:var(--gray);font-size:15px;line-height:1.45}.post-arrow{font-family:var(--mono);font-size:18px}.all-writing{display:inline-block;margin-top:22px;font-family:var(--mono);font-size:10px;font-weight:600;text-transform:uppercase;text-decoration:none;border-bottom:1px solid currentColor;padding-bottom:3px}.racing-section{background:var(--ink);color:var(--white)}.light-line{border-color:rgba(255,255,255,.45)}.light-link{color:var(--white)}.race-list{border-top:1px solid rgba(255,255,255,.32)}.race-row{display:grid;grid-template-columns:112px 1fr 240px;gap:28px;align-items:center;padding:24px 0;border-bottom:1px solid rgba(255,255,255,.28)}.race-date strong{display:block;font-family:var(--mono);font-size:18px}.race-date span{display:block;margin-top:4px;color:#969696;font-family:var(--mono);font-size:9px}.race-event p{margin:0 0 5px;color:var(--mint);font-family:var(--mono);font-size:9px;text-transform:uppercase}.race-event h3{margin:0;font-size:clamp(28px,3.2vw,42px);line-height:.98;letter-spacing:-.025em}.race-event>span{display:block;margin-top:7px;color:#aaa;font-family:var(--mono);font-size:10px}.race-athletes{font-family:var(--mono);font-size:10px}.race-athletes a{color:inherit;text-decoration:none;border-bottom:1px solid transparent}.race-athletes a:hover{border-color:currentColor}.training-gateway{padding:26px 0;background:var(--paper);border-bottom:1px solid var(--ink)}.training-strip{display:flex;justify-content:space-between;gap:30px;align-items:center}.training-title{display:flex;align-items:baseline;gap:18px}.training-title span{font-family:var(--mono);font-size:9px;text-transform:uppercase}.training-title strong{font-family:var(--editorial);font-size:30px}.training-actions{display:flex;gap:20px;flex-wrap:wrap;justify-content:flex-end}.activity-section{padding:48px 0;background:var(--beige);border-top:1px solid var(--ink)}.activity-grid{display:grid;grid-template-columns:1fr 300px;gap:48px;align-items:start}.activity-copy h2{margin:12px 0 22px;font-size:clamp(42px,5vw,64px);line-height:.95}.activity-links{display:flex;gap:18px;flex-wrap:wrap}.strava-frame-wrap{width:300px;overflow:hidden;border:1px solid var(--ink);background:var(--white)}.strava-frame-wrap iframe{display:block;width:300px}.about-strip{padding:34px 0;background:var(--mint);border-top:1px solid var(--ink)}.about-strip-inner{display:flex;justify-content:space-between;gap:34px;align-items:center}.about-strip p{margin:0;font-family:var(--editorial);font-size:clamp(24px,3vw,38px);line-height:1}.about-strip-inner>div{display:flex;gap:18px;flex-wrap:wrap;justify-content:flex-end}.about-strip a{font-family:var(--mono);font-size:9px;font-weight:600;text-transform:uppercase;text-decoration:none;border-bottom:1px solid currentColor;padding-bottom:3px}
@media(max-width:850px){.hero-grid{grid-template-columns:1fr;gap:22px;padding-top:28px;padding-bottom:30px}.hero h1{font-size:clamp(48px,14vw,68px)}.mission{margin-top:18px;font-size:22px;line-height:1.16}.hero-actions{gap:8px 14px;margin-top:18px}.hero-actions>a:not(.primary-action){padding-top:8px}.hero-side{padding-top:12px}.hero-side>p{font-size:16.5px;line-height:1.34}.hero-facts{margin-top:14px}.hero-facts div{padding-top:9px;padding-bottom:9px}.hero-social{margin-top:12px}.entry-grid{grid-template-columns:1fr 1fr}.entry-grid>span{grid-column:1/-1;padding:9px 0;border-bottom:1px solid var(--ink)}.entry-grid a{min-height:46px;padding:10px;border-left:0;border-right:1px solid var(--ink);border-bottom:1px solid var(--ink)}.entry-grid a:nth-of-type(even){border-right:0}.athletes-section,.racing-section,.reports-section{padding:38px 0 46px}.section-topline{margin-bottom:18px}.desktop-roster-link{display:none}.athlete-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:26px 12px}.mobile-roster-tile{display:flex;position:relative;min-height:0;aspect-ratio:4/5;flex-direction:column;justify-content:space-between;padding:12px;background:var(--mint);border:1px solid var(--ink);color:var(--ink);text-decoration:none}.mobile-roster-tile span,.mobile-roster-tile b{font-family:var(--mono);font-size:7px;text-transform:uppercase}.mobile-roster-tile strong{font-family:var(--editorial);font-size:clamp(24px,7vw,34px);font-weight:600;line-height:.9}.mobile-roster-tile b{font-size:16px;align-self:flex-end}.reports-grid{grid-template-columns:1fr;gap:18px}.reports-heading{display:flex;justify-content:space-between;align-items:baseline}.reports-heading h2{margin:0;font-size:36px}.post-row{grid-template-columns:1fr auto;gap:12px;padding:20px 0}.post-meta{grid-column:1/-1;flex-direction:row;justify-content:space-between}.post-main p{font-size:14px}.race-row{grid-template-columns:68px 1fr;gap:12px;padding:21px 0}.race-athletes{grid-column:2}.training-gateway{padding:18px 0}.training-strip{display:block}.training-title{justify-content:space-between;border-bottom:1px solid var(--ink);padding-bottom:9px}.training-title strong{font-size:25px}.training-actions{justify-content:flex-start;gap:9px 15px;padding-top:11px}.training-actions a{font-size:8px}.activity-section{padding:40px 0}.activity-grid{grid-template-columns:1fr;gap:18px}.strava-frame-wrap{width:100%;max-width:300px}.about-strip{padding:28px 0}.about-strip-inner{align-items:flex-start;flex-direction:column;gap:20px}.about-strip-inner>div{justify-content:flex-start}}
</style>
