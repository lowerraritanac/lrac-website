---
import BaseLayout from "../layouts/BaseLayout.astro";

import { athletes } from "../../data/athletes.js";
import { races } from "../../data/schedule.js";
import { trainingPosts } from "../../data/training.js";
---

<BaseLayout
  title="Lower Raritan Athletic Club"
  description="Lower Raritan Athletic Club — independent endurance athletes competing in running and rowing."
  transparentHeader={true}
>
  <section class="hero">
    <img
      class="hero-image"
      src="/images/hero.jpg"
      alt="Lower Raritan Athletic Club"
    />

    <div class="hero-overlay"></div>

    <div class="hero-inner">
      <p class="hero-kicker">LOWER RARITAN ATHLETIC CLUB</p>

      <h1>
        Running.
        <br />
        Rowing.
        <br />
        Racing.
      </h1>

      <div class="hero-bottom">
        <p>
          Independent endurance athletes with roots in New Jersey, training
          and competing across the country.
        </p>

        <div class="hero-meta">
          <span>EST. 2026</span>
          <span>NEW JERSEY</span>
        </div>
      </div>
    </div>
  </section>

  <section class="intro-section">
    <div class="section-inner intro-grid">
      <p class="section-label">ABOUT</p>

      <div>
        <h2>Three athletes. Two disciplines. One club.</h2>

        <p class="intro-copy">
          Lower Raritan Athletic Club brings together athletes with roots in
          Rutgers athletics and a continued interest in high-level endurance
          competition.
        </p>

        <a class="text-link" href="/about">
          About LRAC →
        </a>
      </div>
    </div>
  </section>

  <section class="athletes-section">
    <div class="section-inner">
      <div class="section-header">
        <div>
          <p class="section-label">ATHLETES</p>
          <h2>Roster</h2>
        </div>

        <a class="text-link" href="/athletes">
          All athletes →
        </a>
      </div>

      <div class="athlete-grid">
        {
          athletes.slice(0, 3).map((athlete) => (
            <a
              class="athlete-card"
              href={`/athletes/${athlete.slug}`}
            >
              <div class="athlete-image">
                <img
                  src={athlete.image}
                  alt={athlete.name}
                />
              </div>

              <div class="athlete-meta">
                <p class="athlete-sport">
                  {athlete.sport}
                </p>

                <h3>{athlete.name}</h3>

                <p class="athlete-location">
                  {athlete.location}
                </p>

                <div class="athlete-details">
                  <p>{athlete.background}</p>

                  {athlete.prs.slice(0, 3).map(([event, time]) => (
                    <p>
                      <strong>{time}</strong>
                      <span>{event}</span>
                    </p>
                  ))}
                </div>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="schedule-section">
    <div class="section-inner">
      <div class="section-header">
        <div>
          <p class="section-label">UPCOMING</p>
          <h2>Competition</h2>
        </div>

<a class="text-link" href="/racing">
  All racing →
</a>
      </div>

      <div class="schedule-list">
        {
          races.slice(0, 3).map((race) => (
            <article class="schedule-row">
              <div class="schedule-date">
                {race.date}
              </div>

              <div class="schedule-event">
                <p class="discipline">
                  {race.discipline}
                </p>

                <h3>{race.event}</h3>

                <p class="schedule-location">
                  {race.location}
                </p>
              </div>

              <div class="schedule-athlete">
                {race.athlete}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="training-section">
    <div class="section-inner">
      <div class="section-header">
        <div>
          <p class="section-label">TRAINING</p>
          <h2>Latest</h2>
        </div>

        <a class="text-link" href="/training">
          All training →
        </a>
      </div>

      <div class="training-grid">
        {
          trainingPosts.slice(0, 3).map((post) => (
            <article class="training-card">
              <p class="training-type">
                {post.type}
              </p>

              <h3>{post.title}</h3>

              <p class="training-description">
                {post.description}
              </p>

              <a
                class="training-link"
                href={`/training/${post.slug}`}
              >
                Read →
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    overflow: hidden;
    color: var(--white);
    border-bottom: 1px solid var(--black);
  }

  .hero-image {
    position: absolute;
    inset: 0;

    width: 100%;
    height: 100%;

    object-fit: cover;

    filter: saturate(0.75) contrast(1.08);
  }

  .hero-overlay {
    position: absolute;
    inset: 0;

    background:
      linear-gradient(
        to bottom,
        rgba(0, 0, 0, 0.14),
        rgba(0, 0, 0, 0.6)
      );
  }

  .hero-inner {
    position: relative;
    z-index: 2;

    width: 100%;
    min-height: 100vh;
    max-width: var(--max-width);

    margin: 0 auto;

    padding:
      100px var(--page-padding)
      42px;

    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .hero-kicker {
    margin: 0;

    font-size: 11px;
    font-weight: 900;
    letter-spacing: 2.6px;
    text-transform: uppercase;
  }

  .hero h1 {
    margin: 40px 0 70px;

    font-size: clamp(78px, 12vw, 170px);
    line-height: 0.79;
    letter-spacing: -8px;

    text-transform: uppercase;
  }

  .hero-bottom {
    border-top:
      1px solid rgba(255, 255, 255, 0.7);

    padding-top: 24px;

    display: flex;
    justify-content: space-between;
    gap: 40px;
    align-items: flex-end;
  }

  .hero-bottom > p {
    max-width: 640px;
    margin: 0;

    font-size: 21px;
    line-height: 1.45;
  }

  .hero-meta {
    display: flex;
    gap: 28px;

    font-size: 11px;
    font-weight: 900;
    letter-spacing: 1.7px;
  }

  .intro-section {
    padding: 110px 0;

    background: var(--black);
    color: var(--white);
  }

  .intro-grid {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 70px;
  }

  .intro-grid h2 {
    max-width: 900px;
    margin: 0;

    font-size: clamp(46px, 6vw, 82px);
    line-height: 0.95;
    letter-spacing: -4px;

    text-transform: uppercase;
  }

  .intro-copy {
    max-width: 740px;
    margin: 30px 0;

    color: #d4d4d4;

    font-size: 18px;
    line-height: 1.7;
  }

  .intro-section .text-link {
    color: var(--white);
    border-color: var(--white);
  }

  .athletes-section,
  .schedule-section,
  .training-section {
    padding: 100px 0 110px;
  }

  .athletes-section {
    background: var(--beige-light);
  }

  .schedule-section {
    background: var(--mint);

    border-top: 1px solid var(--black);
    border-bottom: 1px solid var(--black);
  }

  .training-section {
    background: var(--beige);
  }

  .section-header {
    margin-bottom: 45px;

    display: flex;
    justify-content: space-between;
    gap: 30px;
    align-items: flex-end;
  }

  .section-header h2 {
    margin: 10px 0 0;

    font-size: clamp(52px, 7vw, 90px);
    line-height: 0.9;
    letter-spacing: -4px;

    text-transform: uppercase;
  }

  .athlete-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  .athlete-card {
    color: var(--black);
    text-decoration: none;
  }

  .athlete-image {
    aspect-ratio: 4 / 5;

    overflow: hidden;

    background: var(--black);
    border: 1px solid var(--black);
  }

  .athlete-image img {
    width: 100%;
    height: 100%;

    display: block;

    object-fit: cover;

    filter: saturate(0.85) contrast(1.04);

    transition: transform 0.25s ease;
  }

  .athlete-card:hover .athlete-image img {
    transform: scale(1.02);
  }

  .athlete-meta {
    padding-top: 16px;
  }

  .athlete-sport,
  .discipline,
  .training-type {
    margin: 0 0 7px;

    color: var(--mint-dark);

    font-size: 10px;
    font-weight: 900;
    letter-spacing: 2px;

    text-transform: uppercase;
  }

  .athlete-meta h3 {
    margin: 0;

    font-size: 30px;
    line-height: 1;
    letter-spacing: -1.5px;

    text-transform: uppercase;
  }

  .athlete-location {
    margin: 7px 0 0;

    color: var(--gray);

    font-size: 13px;
  }

  .athlete-details {
    margin-top: 16px;
    padding-top: 14px;

    border-top: 1px solid var(--black);
  }

  .athlete-details p {
    margin: 5px 0;

    display: flex;
    justify-content: space-between;
    gap: 16px;

    font-size: 13px;
  }

  .athlete-details span {
    color: var(--gray);
  }

  .schedule-list {
    border-top: 1px solid var(--black);
  }

  .schedule-row {
    display: grid;

    grid-template-columns:
      140px
      1fr
      220px;

    gap: 28px;

    align-items: center;

    padding: 28px 0;

    border-bottom:
      1px solid rgba(17, 17, 17, 0.55);
  }

  .schedule-date,
  .schedule-athlete {
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 1.4px;

    text-transform: uppercase;
  }

  .schedule-event h3 {
    margin: 0;

    font-size: 27px;
    line-height: 1;

    letter-spacing: -1.2px;
    text-transform: uppercase;
  }

  .schedule-location {
    margin: 6px 0 0;

    font-size: 13px;
  }

  .training-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  .training-card {
    min-height: 390px;

    padding: 28px;

    background: var(--white);
    border: 1px solid var(--black);

    display: flex;
    flex-direction: column;
  }

  .training-card h3 {
    margin: 48px 0 0;

    font-size: 40px;
    line-height: 0.98;
    letter-spacing: -2px;

    text-transform: uppercase;
  }

  .training-description {
    margin: 18px 0 0;

    color: var(--gray);

    font-size: 16px;
    line-height: 1.6;
  }

  .training-link {
    margin-top: auto;

    text-decoration: none;
    text-transform: uppercase;

    font-size: 11px;
    font-weight: 900;
    letter-spacing: 1.4px;
  }

  @media (max-width: 850px) {
    .hero {
      min-height: calc(100vh - 70px);
    }

    .hero-inner {
      min-height: calc(100vh - 70px);

      padding:
        48px
        var(--page-padding)
        36px;
    }

    .hero h1 {
      max-width: 100%;

      margin: 30px 0 50px;

      font-size: clamp(56px, 18vw, 78px);
      line-height: 0.84;
      letter-spacing: -4px;
    }

    .hero-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 24px;
    }

    .hero-bottom > p {
      font-size: 18px;
      line-height: 1.45;
    }

    .intro-grid {
      grid-template-columns: 1fr;
      gap: 35px;
    }

    .section-header {
      width: 100%;

      flex-direction: column;
      align-items: flex-start;

      gap: 16px;
    }

    .section-header > div {
      width: 100%;
    }

    .section-header h2 {
      max-width: 100%;

      font-size: clamp(42px, 13vw, 60px);
      line-height: 0.9;
      letter-spacing: -3px;
    }

    .section-header .text-link {
      margin-top: 4px;
      white-space: nowrap;
    }

    .athlete-grid,
    .training-grid {
      grid-template-columns: 1fr;
    }

    .schedule-row {
      grid-template-columns: 100px 1fr;
      gap: 22px;
    }

    .schedule-athlete {
      grid-column: 2;
    }

    .schedule-event h3 {
      font-size: 26px;
    }
  }
</style>
