---
import BaseLayout from "../layouts/BaseLayout.astro";

import { athletes } from "../../data/athletes.js";
import { races } from "../../data/schedule.js";
import { trainingPosts } from "../../data/training.js";

const featuredAthletes = athletes.slice(0, 3);

const upcomingRaces = races
  .filter(
    (race) =>
      race.status === "Upcoming" ||
      race.status === "Tentative"
  )
  .slice(0, 3);

const latestPosts = trainingPosts.slice(0, 3);
---

<BaseLayout
  title="Lower Raritan Athletic Club"
  description="Lower Raritan Athletic Club is an independent endurance club competing in running and rowing."
  transparentHeader={true}
>

  <!-- HERO -->

  <section class="hero">
    <img
      class="hero-image"
      src="/images/hero.jpg"
      alt="Lower Raritan Athletic Club"
    />

    <div class="hero-overlay"></div>

    <div class="section-inner hero-content">
      <p class="eyebrow">LOWER RARITAN ATHLETIC CLUB</p>

      <h1>
        Running.<br />
        Rowing.<br />
        Racing.
      </h1>

      <p class="hero-copy">
        Independent endurance athletes with roots in New Jersey,
        training and competing across the country.
      </p>
    </div>
  </section>


  <!-- CLUB SNAPSHOT -->

  <section class="snapshot">
    <div class="section-inner snapshot-grid">

      <div class="snapshot-item">
        <strong>{athletes.length}</strong>
        <span>Athletes</span>
      </div>

      <div class="snapshot-item">
        <strong>02</strong>
        <span>Sports</span>
      </div>

      <div class="snapshot-item">
        <strong>2026</strong>
        <span>Founded</span>
      </div>

      <div class="snapshot-item">
        <strong>LRAC</strong>
        <span>Lower Raritan</span>
      </div>

    </div>
  </section>


  <!-- ATHLETES -->

  <section class="athletes-section">
    <div class="section-inner">

      <div class="section-top">
        <div>
          <p class="section-label">THE CLUB</p>
          <h2>Athletes</h2>
        </div>

        <a class="text-link" href="/athletes">
          Full roster →
        </a>
      </div>

      <div class="athlete-grid">
        {
          featuredAthletes.map((athlete) => (
            <a
              class="athlete-card"
              href={`/athletes/${athlete.slug}`}
            >
              <img
                src={athlete.image}
                alt={athlete.name}
              />

              <div class="athlete-card-info">
                <p>{athlete.sport}</p>
                <h3>{athlete.name}</h3>
                <span>{athlete.location}</span>
              </div>
            </a>
          ))
        }
      </div>

    </div>
  </section>


  <!-- RACING -->

  <section class="racing-section">
    <div class="section-inner">

      <div class="section-top">
        <div>
          <p class="section-label">UP NEXT</p>
          <h2>Racing</h2>
        </div>

        <a class="text-link light-link" href="/racing">
          All racing →
        </a>
      </div>

      <div class="race-list">
        {
          upcomingRaces.map((race) => (
            <div class="race-row">

              <div class="race-date">
                <strong>{race.date}</strong>
                <span>{race.year}</span>
              </div>

              <div class="race-event">
                <p>{race.discipline}</p>
                <h3>{race.event}</h3>
                <span>{race.location}</span>
              </div>

              <div class="race-athletes">
                {race.athletes.join(" · ")}
              </div>

            </div>
          ))
        }
      </div>

    </div>
  </section>


  <!-- TRAINING -->

  <section class="training-section">
    <div class="section-inner">

      <div class="section-top">
        <div>
          <p class="section-label">FROM THE CLUB</p>
          <h2>Training</h2>
        </div>

        <a class="text-link" href="/training">
          All training →
        </a>
      </div>

      <div class="post-grid">
        {
          latestPosts.map((post) => (
            <a
              class="post-card"
              href={`/training/${post.slug}`}
            >
              <p class="post-category">
                {post.category}
              </p>

              <h3>{post.title}</h3>

              <p class="post-description">
                {post.description}
              </p>

              <div class="post-meta">
                <span>{post.athlete}</span>
                <span>{post.date}</span>
              </div>
            </a>
          ))
        }
      </div>

    </div>
  </section>


  <!-- ABOUT -->

  <section class="about-section">
    <div class="section-inner about-grid">

      <div>
        <p class="section-label">ABOUT LRAC</p>
      </div>

      <div>
        <p class="about-copy">
          Lower Raritan Athletic Club is an independent endurance
          club built around athletes continuing to train, race,
          and improve beyond collegiate competition.
        </p>

        <a class="text-link" href="/about">
          About the club →
        </a>
      </div>

    </div>
  </section>

</BaseLayout>


<style>

  /* HERO */

  .hero {
    position: relative;
    min-height: 780px;
    height: 92vh;
    display: flex;
    align-items: flex-end;

    overflow: hidden;

    background: var(--black);
    color: var(--white);
  }

  .hero-image {
    position: absolute;
    inset: 0;

    width: 100%;
    height: 100%;

    object-fit: cover;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;

    background:
      linear-gradient(
        to top,
        rgba(0,0,0,0.78),
        rgba(0,0,0,0.05) 65%
      );
  }

  .hero-content {
    position: relative;
    z-index: 2;

    padding-bottom: 65px;
  }

  .hero h1 {
    margin: 22px 0 25px;

    font-size: clamp(78px, 11vw, 165px);
    line-height: 0.76;
    letter-spacing: -8px;

    text-transform: uppercase;
  }

  .hero-copy {
    max-width: 570px;
    margin: 0;

    font-size: 17px;
    line-height: 1.5;
  }


  /* SNAPSHOT */

  .snapshot {
    background: var(--mint);
    border-bottom: 1px solid var(--black);
  }

  .snapshot-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  .snapshot-item {
    padding: 35px 0;

    border-right: 1px solid var(--black);
  }

  .snapshot-item:not(:first-child) {
    padding-left: 30px;
  }

  .snapshot-item:last-child {
    border-right: none;
  }

  .snapshot-item strong {
    display: block;

    font-size: 35px;
    letter-spacing: -2px;
  }

  .snapshot-item span {
    display: block;
    margin-top: 6px;

    font-size: 10px;
    font-weight: 900;
    letter-spacing: 1.5px;

    text-transform: uppercase;
  }


  /* SHARED */

  .athletes-section,
  .training-section,
  .about-section {
    padding: 100px 0 120px;
  }

  .section-top {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 40px;

    margin-bottom: 45px;
  }

  .section-top h2 {
    margin: 10px 0 0;

    font-size: clamp(60px, 8vw, 105px);
    line-height: 0.85;
    letter-spacing: -5px;

    text-transform: uppercase;
  }


  /* ATHLETES */

  .athlete-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  .athlete-card {
    color: var(--black);
    text-decoration: none;
  }

  .athlete-card img {
    display: block;

    width: 100%;
    aspect-ratio: 4 / 5;

    object-fit: cover;

    border: 1px solid var(--black);
  }

  .athlete-card-info {
    padding-top: 18px;
  }

  .athlete-card-info p {
    margin: 0 0 8px;

    font-size: 10px;
    font-weight: 900;
    letter-spacing: 1.5px;

    text-transform: uppercase;
  }

  .athlete-card-info h3 {
    margin: 0;

    font-size: 31px;
    line-height: 1;
    letter-spacing: -1.5px;

    text-transform: uppercase;
  }

  .athlete-card-info span {
    display: block;
    margin-top: 7px;

    color: var(--gray);
    font-size: 12px;
  }

  .athlete-card:hover {
    opacity: 0.72;
  }


  /* RACING */

  .racing-section {
    padding: 100px 0 120px;

    background: var(--black);
    color: var(--white);
  }

  .light-link {
    color: var(--white);
    border-color: var(--white);
  }

  .race-list {
    border-top: 1px solid rgba(255,255,255,0.45);
  }

  .race-row {
    display: grid;
    grid-template-columns: 140px 1fr 300px;
    gap: 30px;
    align-items: center;

    padding: 30px 0;

    border-bottom: 1px solid rgba(255,255,255,0.35);
  }

  .race-date strong {
    display: block;
    font-size: 18px;
  }

  .race-date span {
    display: block;
    margin-top: 4px;

    color: #999;
    font-size: 11px;
  }

  .race-event p {
    margin: 0 0 7px;

    color: var(--mint);

    font-size: 10px;
    font-weight: 900;
    letter-spacing: 1.5px;

    text-transform: uppercase;
  }

  .race-event h3 {
    margin: 0;

    font-size: 30px;
    line-height: 1;

    text-transform: uppercase;
  }

  .race-event span {
    display: block;
    margin-top: 7px;

    color: #aaa;
    font-size: 12px;
  }

  .race-athletes {
    font-size: 13px;
    font-weight: 700;
  }


  /* TRAINING */

  .training-section {
    background: var(--beige-light);
  }

  .post-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);

    border-top: 1px solid var(--black);
    border-left: 1px solid var(--black);
  }

  .post-card {
    min-height: 340px;
    padding: 30px;

    display: flex;
    flex-direction: column;

    border-right: 1px solid var(--black);
    border-bottom: 1px solid var(--black);

    color: var(--black);
    text-decoration: none;
  }

  .post-category {
    margin: 0;

    font-size: 10px;
    font-weight: 900;
    letter-spacing: 1.6px;

    text-transform: uppercase;
  }

  .post-card h3 {
    margin: 35px 0 15px;

    font-size: 35px;
    line-height: 0.95;
    letter-spacing: -2px;

    text-transform: uppercase;
  }

  .post-description {
    margin: 0;

    color: var(--gray);
    font-size: 14px;
    line-height: 1.5;
  }

  .post-meta {
    display: flex;
    justify-content: space-between;
    gap: 20px;

    margin-top: auto;
    padding-top: 40px;

    font-size: 10px;
    font-weight: 800;
    text-transform: uppercase;
  }

  .post-card:hover {
    background: var(--mint);
  }


  /* ABOUT */

  .about-section {
    background: var(--mint);
    border-top: 1px solid var(--black);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 80px;
  }

  .about-copy {
    max-width: 900px;
    margin: 0 0 45px;

    font-size: clamp(32px, 5vw, 62px);
    line-height: 1.02;
    letter-spacing: -3px;
  }


  /* MOBILE */

  @media (max-width: 850px) {

    .hero {
      min-height: 680px;
      height: 88vh;
    }

    .hero-content {
      padding-bottom: 40px;
    }

    .hero h1 {
      font-size: 72px;
      line-height: 0.79;
      letter-spacing: -5px;
    }

    .hero-copy {
      max-width: 330px;
      font-size: 14px;
    }


    .snapshot-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .snapshot-item {
      padding: 25px 0;
      border-bottom: 1px solid var(--black);
    }

    .snapshot-item:nth-child(even) {
      padding-left: 20px;
      border-right: none;
    }

    .snapshot-item:nth-child(3),
    .snapshot-item:nth-child(4) {
      border-bottom: none;
    }


    .athletes-section,
    .training-section,
    .about-section,
    .racing-section {
      padding: 75px 0 85px;
    }

    .section-top {
      display: block;
      margin-bottom: 35px;
    }

    .section-top h2 {
      font-size: 58px;
      letter-spacing: -3px;
    }

    .section-top .text-link {
      margin-top: 25px;
    }


    .athlete-grid {
      grid-template-columns: 1fr;
      gap: 45px;
    }

    .athlete-card img {
      max-height: 520px;
    }


    .race-row {
      grid-template-columns: 80px 1fr;
      gap: 20px;
    }

    .race-athletes {
      grid-column: 2;
    }


    .post-grid {
      grid-template-columns: 1fr;
    }

    .post-card {
      min-height: 280px;
    }


    .about-grid {
      grid-template-columns: 1fr;
      gap: 35px;
    }

    .about-copy {
      font-size: 36px;
      letter-spacing: -2px;
    }

  }

</style>
