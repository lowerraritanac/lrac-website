---
import BaseLayout from "../layouts/BaseLayout.astro";
import AthleteCard from "../components/AthleteCard.astro";
import { athletes } from "../../data/athletes.js";
import { races } from "../../data/schedule.js";
import { site } from "../../data/site.js";
import { getCollection } from "astro:content";

const upcomingRaces = races
  .filter((race) => race.status === "Upcoming" || race.status === "Tentative")
  .slice(0, 3);

const posts = await getCollection("training");
const sortedPosts = [...posts].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featuredPosts = [
  ...sortedPosts.filter((post) => post.data.category === "Writing").slice(0, 1),
  ...sortedPosts.filter((post) => post.data.category === "Training Report").slice(0, 1),
  ...sortedPosts.filter((post) => post.data.category === "Race Report").slice(0, 1),
];
---

<BaseLayout title={site.name} description={site.description}>
  <section class="hero">
    <div class="section-inner hero-inner">
      <div class="hero-kicker">
        <span>EST. {site.founded}</span>
        <span>{site.location}</span>
      </div>

      <h1>Lower Raritan<br />Athletic Club</h1>

      <div class="hero-footer">
        <p>{site.description}</p>
        <p class="hero-note">Running · Rowing · Racing</p>
      </div>
    </div>
  </section>

  <div class="mint-band" aria-hidden="true"></div>

  <section class="athletes-section">
    <div class="section-inner">
      <div class="section-header">
        <div>
          <p class="section-label">THE CLUB</p>
          <h2>Athletes</h2>
        </div>
        <a class="text-link" href="/athletes">Full roster →</a>
      </div>

      <div class="athlete-grid">
        {athletes.slice(0, 3).map((athlete) => <AthleteCard athlete={athlete} />)}
      </div>
    </div>
  </section>

  <section class="racing-section">
    <div class="section-inner">
      <div class="section-header">
        <div>
          <p class="section-label">NEXT ON THE CALENDAR</p>
          <h2>Racing</h2>
        </div>
        <a class="text-link light-link" href="/racing">All racing →</a>
      </div>

      <div class="race-list">
        {upcomingRaces.map((race) => (
          <article class="race-row">
            <div class="race-date"><strong>{race.date}</strong><span>{race.year}</span></div>
            <div class="race-event"><p>{race.discipline}</p><h3>{race.event}</h3><span>{race.location}</span></div>
            <div class="race-athletes">{race.athletes.join(" · ")}</div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="training-section">
    <div class="section-inner">
      <div class="section-header">
        <div>
          <p class="section-label">WRITING & TRAINING</p>
          <h2>From the Club</h2>
        </div>
        <a class="text-link" href="/training">All posts →</a>
      </div>

      <div class="content-grid">
        {featuredPosts.map((post, index) => (
          <a class:list={["content-card", { lead: index === 0 }]} href={`/training/${post.id}`}>
            <p class="content-type">{post.data.category}</p>
            <h3>{post.data.title}</h3>
            <p class="content-description">{post.data.description}</p>
            <div class="content-meta">
              <span>{post.data.athlete}</span>
              <span>{post.data.date.toLocaleDateString("en-US", { month: "short", year: "numeric" })}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="about-section">
    <div class="section-inner about-grid">
      <p class="section-label">ABOUT LRAC</p>
      <div>
        <p class="about-copy">A small independent athletic club with New Jersey roots, built around serious training, competition, and the athletes doing the work.</p>
        <a class="text-link" href="/about">About the club →</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    background: var(--beige-light);
    border-bottom: 1px solid var(--black);
  }

  .hero-inner {
    padding-top: 92px;
    padding-bottom: 62px;
  }

  .hero-kicker {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 30px;
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .hero h1 {
    max-width: 1180px;
    margin: 0;
    font-size: clamp(96px, 12vw, 176px);
    line-height: .72;
    letter-spacing: -6px;
    text-transform: uppercase;
  }

  .hero-footer {
    display: grid;
    grid-template-columns: minmax(0, 640px) auto;
    gap: 48px;
    align-items: end;
    margin-top: 42px;
    padding-top: 18px;
    border-top: 1px solid var(--black);
  }

  .hero-footer p {
    margin: 0;
    font-size: 16px;
    line-height: 1.5;
  }

  .hero-note {
    justify-self: end;
    font-size: 10px !important;
    font-weight: 900;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }

  .mint-band {
    height: 16px;
    background: var(--mint);
    border-bottom: 1px solid var(--black);
  }

  .athletes-section, .racing-section, .training-section, .about-section {
    padding: 92px 0 108px;
  }

  .section-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
    margin-bottom: 38px;
  }

  .section-header h2 {
    margin: 8px 0 0;
    font-size: clamp(60px, 7vw, 98px);
    line-height: .8;
    letter-spacing: -4px;
    text-transform: uppercase;
  }

  .athletes-section {
    background: var(--beige-light);
  }

  .athlete-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .racing-section {
    background: var(--black);
    color: var(--white);
  }

  .light-link {
    color: var(--white);
  }

  .race-list {
    border-top: 1px solid rgba(255,255,255,.45);
  }

  .race-row {
    display: grid;
    grid-template-columns: 130px 1fr 280px;
    gap: 28px;
    align-items: center;
    padding: 27px 0;
    border-bottom: 1px solid rgba(255,255,255,.3);
  }

  .race-date strong {
    display: block;
    font-size: 18px;
  }

  .race-date span {
    display: block;
    margin-top: 4px;
    color: #888;
    font-size: 10px;
  }

  .race-event p {
    margin: 0 0 5px;
    color: var(--mint);
    font-size: 9px;
    font-weight: 900;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }

  .race-event h3 {
    margin: 0;
    font-size: 31px;
    line-height: .94;
    letter-spacing: -1px;
    text-transform: uppercase;
  }

  .race-event span {
    display: block;
    margin-top: 6px;
    color: #aaa;
    font-size: 11px;
  }

  .race-athletes {
    font-size: 12px;
    font-weight: 700;
  }

  .training-section {
    background: var(--beige);
  }

  .content-grid {
    display: grid;
    grid-template-columns: 1.35fr .825fr .825fr;
    border-top: 1px solid var(--black);
    border-left: 1px solid var(--black);
  }

  .content-card {
    min-height: 360px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    color: var(--black);
    text-decoration: none;
    border-right: 1px solid var(--black);
    border-bottom: 1px solid var(--black);
    background: var(--beige-light);
  }

  .content-card.lead {
    min-height: 430px;
    background: var(--mint);
  }

  .content-type {
    margin: 0;
    font-size: 9px;
    font-weight: 900;
    letter-spacing: 1.8px;
    text-transform: uppercase;
  }

  .content-card h3 {
    margin: 48px 0 12px;
    font-size: 38px;
    line-height: .92;
    letter-spacing: -1.8px;
    text-transform: uppercase;
  }

  .content-card.lead h3 {
    font-size: clamp(48px, 5vw, 72px);
  }

  .content-description {
    margin: 0;
    max-width: 600px;
    color: var(--gray);
    font-size: 14px;
    line-height: 1.55;
  }

  .content-card.lead .content-description {
    color: var(--black);
  }

  .content-meta {
    margin-top: auto;
    padding-top: 36px;
    display: flex;
    justify-content: space-between;
    gap: 18px;
    font-size: 9px;
    font-weight: 900;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .content-card:hover {
    background: var(--mint);
  }

  .about-section {
    background: var(--mint);
    border-top: 1px solid var(--black);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 72px;
  }

  .about-copy {
    max-width: 960px;
    margin: 0 0 36px;
    font-family: var(--display-font);
    font-size: clamp(38px, 5vw, 66px);
    line-height: .98;
    letter-spacing: -2.5px;
    text-transform: uppercase;
  }

  @media (max-width: 850px) {
    .hero-inner {
      padding-top: 56px;
      padding-bottom: 38px;
    }

    .hero h1 {
      font-size: clamp(62px, 19vw, 90px);
      letter-spacing: -3px;
    }

    .hero-footer {
      grid-template-columns: 1fr;
      gap: 18px;
      margin-top: 30px;
    }

    .hero-note {
      justify-self: start;
    }

    .mint-band {
      height: 12px;
    }

    .athletes-section, .racing-section, .training-section, .about-section {
      padding: 68px 0 78px;
    }

    .section-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 14px;
    }

    .section-header h2 {
      font-size: 58px;
      letter-spacing: -2.5px;
    }

    .athlete-grid, .content-grid {
      grid-template-columns: 1fr;
    }

    .race-row {
      grid-template-columns: 82px 1fr;
      gap: 18px;
    }

    .race-athletes {
      grid-column: 2;
    }

    .about-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .about-copy {
      font-size: 38px;
      letter-spacing: -1.5px;
    }
  }
</style>
