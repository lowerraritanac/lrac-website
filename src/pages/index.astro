---
import BaseLayout from "../layouts/BaseLayout.astro";
import { athletes } from "../../data/athletes.js";
import { races } from "../../data/schedule.js";
import { getCollection } from "astro:content";

const upcomingRaces = races
  .filter((race) => race.status === "Upcoming" || race.status === "Tentative")
  .slice(0, 3);

const posts = await getCollection("training");
const latestPosts = [...posts]
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<BaseLayout
  title="Lower Raritan Athletic Club"
  description="Lower Raritan Athletic Club — independent endurance athletes training and competing beyond collegiate sport."
  transparentHeader={true}
>
  <section class="hero">
    <img class="hero-image" src="/images/hero.jpg" alt="Lower Raritan Athletic Club" />
    <div class="hero-overlay"></div>

    <div class="hero-inner">
      <p class="hero-kicker">EST. 2026 · NEW JERSEY</p>
      <h1>Lower Raritan<br />Athletic Club</h1>
      <div class="hero-bottom">
        <p>Independent endurance athletes training and competing beyond collegiate competition.</p>
      </div>
    </div>
  </section>

  <section class="athletes-section">
    <div class="section-inner">
      <div class="section-header">
        <div>
          <p class="section-label">THE CLUB</p>
          <h2>Athletes</h2>
        </div>
        <a class="text-link" href="/athletes">Full roster →</a>
      </div>

      <div class="athlete-grid">
        {athletes.slice(0, 3).map((athlete) => (
          <a class="athlete-card" href={`/athletes/${athlete.slug}`}>
            <div class="athlete-image">
              <img src={athlete.image} alt={athlete.name} />
            </div>
            <div class="athlete-meta">
              <p class="athlete-sport">{athlete.sport}</p>
              <h3>{athlete.name}</h3>
              <p class="athlete-location">{athlete.location}</p>
              <div class="athlete-details">
                <p>{athlete.background}</p>
                {athlete.prs.slice(0, 3).map(([event, time]) => (
                  <p><strong>{time}</strong><span>{event}</span></p>
                ))}
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="racing-section">
    <div class="section-inner">
      <div class="section-header">
        <div>
          <p class="section-label">UPCOMING</p>
          <h2>Racing</h2>
        </div>
        <a class="text-link light-link" href="/racing">All racing →</a>
      </div>

      <div class="race-list">
        {upcomingRaces.map((race) => (
          <article class="race-row">
            <div class="race-date">
              <strong>{race.date}</strong>
              <span>{race.year}</span>
            </div>
            <div class="race-event">
              <p>{race.discipline}</p>
              <h3>{race.event}</h3>
              <span>{race.location}</span>
            </div>
            <div class="race-athletes">{race.athletes.join(" · ")}</div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="training-section">
    <div class="section-inner">
      <div class="section-header">
        <div>
          <p class="section-label">FROM LRAC</p>
          <h2>Training</h2>
        </div>
        <a class="text-link" href="/training">All training →</a>
      </div>

      <div class="training-grid">
        {latestPosts.map((post) => (
          <article class="training-card">
            <p class="training-type">{post.data.category}</p>
            <h3>{post.data.title}</h3>
            <p class="training-description">{post.data.description}</p>
            <div class="training-meta">
              <span>{post.data.athlete}</span>
              <span>{post.data.date.toLocaleDateString("en-US", { month: "short", year: "numeric" })}</span>
            </div>
            <a class="training-link" href={`/training/${post.id}`}>Read →</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="about-section">
    <div class="section-inner about-grid">
      <div><p class="section-label">ABOUT</p></div>
      <div>
        <p class="about-copy">
          Lower Raritan Athletic Club is an independent endurance club with roots in New Jersey, built around athletes continuing to train, race, and improve beyond collegiate competition.
        </p>
        <a class="text-link" href="/about">About LRAC →</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { position: relative; min-height: 100vh; overflow: hidden; background: var(--black); color: var(--white); border-bottom: 1px solid var(--black); }
  .hero-image { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: saturate(0.78) contrast(1.06); }
  .hero-overlay { position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(0,0,0,0.08), rgba(0,0,0,0.68)); }
  .hero-inner { position: relative; z-index: 2; width: 100%; max-width: var(--max-width); min-height: 100vh; margin: 0 auto; padding: 110px var(--page-padding) 48px; display: flex; flex-direction: column; justify-content: flex-end; }
  .hero-kicker { margin: 0 0 25px; font-size: 11px; font-weight: 900; letter-spacing: 2.4px; text-transform: uppercase; }
  .hero h1 { max-width: 1200px; margin: 0; font-size: clamp(72px, 10vw, 145px); line-height: 0.82; letter-spacing: -7px; text-transform: uppercase; }
  .hero-bottom { max-width: 680px; margin-top: 40px; padding-top: 22px; border-top: 1px solid rgba(255,255,255,0.65); }
  .hero-bottom p { margin: 0; font-size: 19px; line-height: 1.5; }
  .athletes-section, .racing-section, .training-section, .about-section { padding: 100px 0 120px; }
  .section-header { display: flex; align-items: flex-end; justify-content: space-between; gap: 40px; margin-bottom: 45px; }
  .section-header h2 { margin: 10px 0 0; font-size: clamp(58px, 8vw, 100px); line-height: 0.86; letter-spacing: -5px; text-transform: uppercase; }
  .athletes-section { background: var(--beige-light); }
  .athlete-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .athlete-card { color: var(--black); text-decoration: none; }
  .athlete-image { aspect-ratio: 4 / 5; overflow: hidden; border: 1px solid var(--black); background: var(--black); }
  .athlete-image img { display: block; width: 100%; height: 100%; object-fit: cover; filter: saturate(0.85) contrast(1.04); transition: transform 0.25s ease; }
  .athlete-card:hover .athlete-image img { transform: scale(1.02); }
  .athlete-meta { padding-top: 16px; }
  .athlete-sport { margin: 0 0 7px; color: var(--mint-dark); font-size: 10px; font-weight: 900; letter-spacing: 2px; text-transform: uppercase; }
  .athlete-meta h3 { margin: 0; font-size: 30px; line-height: 1; letter-spacing: -1.5px; text-transform: uppercase; }
  .athlete-location { margin: 7px 0 0; color: var(--gray); font-size: 13px; }
  .athlete-details { margin-top: 16px; padding-top: 14px; border-top: 1px solid var(--black); }
  .athlete-details p { display: flex; justify-content: space-between; gap: 16px; margin: 5px 0; font-size: 13px; }
  .athlete-details span { color: var(--gray); }
  .racing-section { background: var(--black); color: var(--white); }
  .light-link { color: var(--white); border-color: var(--white); }
  .race-list { border-top: 1px solid rgba(255,255,255,0.45); }
  .race-row { display: grid; grid-template-columns: 140px 1fr 300px; gap: 30px; align-items: center; padding: 30px 0; border-bottom: 1px solid rgba(255,255,255,0.35); }
  .race-date strong { display: block; font-size: 18px; }
  .race-date span { display: block; margin-top: 4px; color: #999; font-size: 11px; }
  .race-event p { margin: 0 0 7px; color: var(--mint); font-size: 10px; font-weight: 900; letter-spacing: 1.5px; text-transform: uppercase; }
  .race-event h3 { margin: 0; font-size: 30px; line-height: 1; text-transform: uppercase; }
  .race-event span { display: block; margin-top: 7px; color: #aaa; font-size: 12px; }
  .race-athletes { font-size: 13px; font-weight: 700; }
  .training-section { background: var(--beige); }
  .training-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .training-card { min-height: 390px; padding: 28px; background: var(--white); border: 1px solid var(--black); display: flex; flex-direction: column; }
  .training-type { margin: 0; color: var(--mint-dark); font-size: 10px; font-weight: 900; letter-spacing: 2px; text-transform: uppercase; }
  .training-card h3 { margin: 48px 0 0; font-size: 40px; line-height: 0.98; letter-spacing: -2px; text-transform: uppercase; }
  .training-description { margin: 18px 0 0; color: var(--gray); font-size: 16px; line-height: 1.6; }
  .training-meta { display: flex; justify-content: space-between; gap: 20px; margin-top: 28px; font-size: 10px; font-weight: 800; letter-spacing: 1px; text-transform: uppercase; }
  .training-link { margin-top: auto; padding-top: 30px; color: var(--black); text-decoration: none; text-transform: uppercase; font-size: 11px; font-weight: 900; letter-spacing: 1.4px; }
  .training-card:hover { background: var(--mint); }
  .about-section { background: var(--mint); border-top: 1px solid var(--black); }
  .about-grid { display: grid; grid-template-columns: 220px 1fr; gap: 80px; }
  .about-copy { max-width: 950px; margin: 0 0 45px; font-size: clamp(32px, 5vw, 62px); line-height: 1.02; letter-spacing: -3px; }
  @media (max-width: 850px) {
    .hero { min-height: calc(100vh - 70px); }
    .hero-inner { min-height: calc(100vh - 70px); padding: 60px var(--page-padding) 38px; }
    .hero-kicker { margin-bottom: 18px; }
    .hero h1 { font-size: clamp(55px, 16vw, 76px); line-height: 0.85; letter-spacing: -4px; }
    .hero-bottom { margin-top: 30px; }
    .hero-bottom p { font-size: 16px; }
    .athletes-section, .racing-section, .training-section, .about-section { padding: 75px 0 85px; }
    .section-header { flex-direction: column; align-items: flex-start; gap: 16px; }
    .section-header h2 { font-size: 58px; letter-spacing: -3px; }
    .athlete-grid, .training-grid { grid-template-columns: 1fr; }
    .race-row { grid-template-columns: 80px 1fr; gap: 20px; }
    .race-athletes { grid-column: 2; }
    .about-grid { grid-template-columns: 1fr; gap: 35px; }
    .about-copy { font-size: 36px; letter-spacing: -2px; }
  }
</style>
