---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { athletes } from "../../../data/athletes.js";
import { races } from "../../../data/schedule.js";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  return athletes.map((athlete) => ({ params: { slug: athlete.slug }, props: { athlete } }));
}

const { athlete } = Astro.props;
const athleteRaces = races.filter((race) => race.athleteSlugs.includes(athlete.slug)).slice(0, 4);
const trainingPosts = await getCollection("training");
const athletePosts = trainingPosts
  .filter((post) => post.data.athleteSlug === athlete.slug)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);
---

<BaseLayout title={`${athlete.name} | LRAC`} description="Work in progress.">
  <section class="athlete-hero">
    <div class="section-inner athlete-grid">
      <div class="photo-wrap"><img src={athlete.image} alt={athlete.name} /></div>
      <div class="identity">
        <div class="identity-meta"><span>{athlete.sport}</span><span>{athlete.location}</span></div>
        <h1>{athlete.name}</h1>
        <p class="bio">{athlete.bio}</p>
        {athlete.social && (
          <div class="socials">
            <a href={athlete.social.instagram} target="_blank" rel="noreferrer">Instagram ↗</a>
            <a href={athlete.social.strava} target="_blank" rel="noreferrer">Strava ↗</a>
          </div>
        )}
      </div>
    </div>
  </section>

  <section class="marks-section">
    <div class="section-inner section-grid">
      <div><p class="section-label">Performance</p><h2>Marks</h2></div>
      <div class="pr-list">
        {athlete.prs.map(([event, mark]) => (
          <div class="pr-row"><span>{event}</span><strong>{mark}</strong></div>
        ))}
      </div>
    </div>
  </section>

  <section class="details-section">
    <div class="section-inner details-grid">
      <div class="detail-block"><p class="section-label">Current Focus</p><p>{athlete.currentFocus}</p></div>
      {athlete.targetRace && <div class="detail-block"><p class="section-label">Target Race</p><p>{athlete.targetRace}</p></div>}
      <div class="detail-block"><p class="section-label">Selected Accomplishments</p><ul>{athlete.accomplishments.map((item) => <li>{item}</li>)}</ul></div>
    </div>
  </section>

  {athleteRaces.length > 0 && (
    <section class="racing-section">
      <div class="section-inner section-grid">
        <div><p class="section-label">Competition</p><h2>Racing</h2></div>
        <div class="race-list">
          {athleteRaces.map((race) => (
            <div class="race-row">
              <div class="race-date"><strong>{race.date}</strong><span>{race.year}</span></div>
              <div><h3>{race.event}</h3><p>{race.location}</p></div>
              <div class="race-result">{race.result || race.status}</div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {athletePosts.length > 0 && (
    <section class="content-section">
      <div class="section-inner section-grid">
        <div><p class="section-label">Journal</p><h2>Latest</h2></div>
        <div class="post-list">
          {athletePosts.map((post) => (
            <a class="post-row" href={`/training/${post.id}`}>
              <div><p class="post-meta">{post.data.category} · {post.data.date.toLocaleDateString("en-US", { month: "long", year: "numeric" })}</p><h3>{post.data.title}</h3></div>
              <span>→</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .athlete-hero { padding: 62px 0 74px; border-bottom: 1px solid var(--ink); }
  .athlete-grid { display: grid; grid-template-columns: minmax(300px, 40%) 1fr; gap: 62px; align-items: end; }
  .photo-wrap { overflow: hidden; border-bottom: 1px solid var(--ink); }
  .photo-wrap img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; filter: saturate(.76) contrast(1.03); }
  .identity-meta { display: flex; justify-content: space-between; gap: 20px; padding-bottom: 12px; border-bottom: 1px solid var(--ink); font-family: var(--mono); font-size: 9px; text-transform: uppercase; }
  .identity h1 { margin: 18px 0 0; font-size: clamp(68px, 8vw, 112px); line-height: .9; letter-spacing: -.045em; }
  .bio { max-width: 620px; margin: 28px 0 0; color: var(--gray); font-size: 18px; line-height: 1.5; }
  .socials { display: flex; gap: 18px; margin-top: 24px; }
  .socials a { font-family: var(--mono); font-size: 9px; font-weight: 600; text-transform: uppercase; text-decoration: none; border-bottom: 1px solid currentColor; padding-bottom: 3px; }

  .marks-section, .details-section, .racing-section, .content-section { padding: 72px 0 86px; }
  .marks-section { background: var(--beige); }
  .details-section { background: var(--paper); border-top: 1px solid var(--ink); }
  .racing-section { background: var(--ink); color: var(--white); }
  .content-section { background: var(--paper); border-top: 1px solid var(--ink); }
  .section-grid { display: grid; grid-template-columns: 250px 1fr; gap: 68px; }
  .section-grid h2 { margin: 16px 0 0; font-size: clamp(48px, 5.5vw, 72px); line-height: .95; letter-spacing: -.035em; }
  .pr-list, .race-list, .post-list { border-top: 1px solid currentColor; }
  .pr-row { display: grid; grid-template-columns: 1fr auto; align-items: baseline; gap: 24px; padding: 15px 0; border-bottom: 1px solid var(--ink); }
  .pr-row span, .pr-row strong { font-family: var(--mono); }
  .pr-row span { font-size: 10px; text-transform: uppercase; }
  .pr-row strong { font-size: 24px; }
  .details-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 40px; }
  .detail-block { padding-top: 12px; border-top: 1px solid var(--ink); }
  .detail-block > p:last-child, .detail-block li { font-size: 17px; line-height: 1.5; }
  .detail-block > p:last-child { margin: 18px 0 0; }
  .detail-block ul { margin: 18px 0 0; padding-left: 18px; }
  .race-row { display: grid; grid-template-columns: 100px 1fr 180px; gap: 24px; align-items: center; padding: 21px 0; border-bottom: 1px solid rgba(255,255,255,.28); }
  .race-date strong, .race-date span { display: block; font-family: var(--mono); }
  .race-date strong { font-size: 17px; }
  .race-date span { margin-top: 3px; color: #999; font-size: 8px; }
  .race-row h3 { margin: 0; font-size: 30px; line-height: .98; }
  .race-row p { margin: 5px 0 0; color: #aaa; font-family: var(--mono); font-size: 9px; }
  .race-result { font-family: var(--mono); font-size: 10px; }
  .post-row { display: flex; justify-content: space-between; gap: 24px; align-items: center; padding: 21px 0; border-bottom: 1px solid var(--ink); color: var(--ink); text-decoration: none; }
  .post-meta { margin: 0 0 6px; font-family: var(--mono); font-size: 8px; text-transform: uppercase; }
  .post-row h3 { margin: 0; font-size: 30px; line-height: .98; }
  .post-row > span { font-family: var(--mono); }

  @media (max-width: 850px) {
    .athlete-hero { padding: 34px 0 50px; }
    .athlete-grid, .section-grid, .details-grid { grid-template-columns: 1fr; gap: 32px; }
    .photo-wrap { max-width: 520px; }
    .identity h1 { font-size: clamp(48px, 14vw, 72px); }
    .marks-section, .details-section, .racing-section, .content-section { padding: 56px 0 66px; }
    .race-row { grid-template-columns: 72px 1fr; gap: 14px; }
    .race-result { grid-column: 2; }
  }
</style>
