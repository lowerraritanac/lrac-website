---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { athletes } from "../../../data/athletes.js";
import { races } from "../../../data/schedule.js";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  return athletes.map((athlete) => ({
    params: { slug: athlete.slug },
    props: { athlete },
  }));
}

const { athlete } = Astro.props;
const athleteRaces = races.filter((race) => race.athleteSlugs.includes(athlete.slug)).slice(0, 4);
const trainingPosts = await getCollection("training");
const athletePosts = trainingPosts
  .filter((post) => post.data.athleteSlug === athlete.slug)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);
---

<BaseLayout
  title={`${athlete.name} | LRAC`}
  description={`${athlete.name} — ${athlete.sport}, Lower Raritan Athletic Club.`}
>
  <section class="athlete-hero">
    <div class="section-inner athlete-hero-grid">
      <div class="athlete-photo-wrap">
        <img class="athlete-photo" src={athlete.image} alt={athlete.name} />
      </div>

      <div class="athlete-heading">
        <div class="athlete-kicker">
          <span>{athlete.sport}</span>
          <span>{athlete.location}</span>
        </div>
        <h1>{athlete.name}</h1>
        <p class="background">{athlete.background}</p>
        <p class="bio">{athlete.bio}</p>
      </div>
    </div>
  </section>

  <section class="marks-section">
    <div class="section-inner marks-grid">
      <div class="section-heading">
        <p class="section-label">PERSONAL BESTS</p>
        <h2>Marks</h2>
      </div>

      <div class="pr-list">
        {athlete.prs.map(([event, mark]) => (
          <div class="pr-row">
            <span>{event}</span>
            <strong>{mark}</strong>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="details-section">
    <div class="section-inner details-grid">
      <div class="detail-block">
        <p class="section-label">CURRENT FOCUS</p>
        <p>{athlete.currentFocus}</p>
      </div>

      <div class="detail-block">
        <p class="section-label">SELECTED ACCOMPLISHMENTS</p>
        <ul>{athlete.accomplishments.map((item) => <li>{item}</li>)}</ul>
      </div>
    </div>
  </section>

  {athleteRaces.length > 0 && (
    <section class="racing-section">
      <div class="section-inner">
        <div class="section-heading light-heading">
          <p class="section-label">RACING</p>
          <h2>Recent & Upcoming</h2>
        </div>

        <div class="race-list">
          {athleteRaces.map((race) => (
            <div class="race-row">
              <div class="race-date"><strong>{race.date}</strong><span>{race.year}</span></div>
              <div class="race-event"><h3>{race.event}</h3><p>{race.location}</p></div>
              <div class="race-result">{race.result || race.status}</div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {athletePosts.length > 0 && (
    <section class="content-section">
      <div class="section-inner">
        <div class="section-heading">
          <p class="section-label">TRAINING & WRITING</p>
          <h2>Latest</h2>
        </div>

        <div class="post-list">
          {athletePosts.map((post) => (
            <a class="post-row" href={`/training/${post.id}`}>
              <div>
                <p class="post-meta">{post.data.category} · {post.data.date.toLocaleDateString("en-US", { month: "long", year: "numeric" })}</p>
                <h3>{post.data.title}</h3>
              </div>
              <span>→</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .athlete-hero { padding: 64px 0 78px; background: var(--beige-light); border-bottom: 1px solid var(--black); }
  .athlete-hero-grid { display: grid; grid-template-columns: minmax(300px, 38%) 1fr; gap: 64px; align-items: end; }
  .athlete-photo-wrap { overflow: hidden; background: var(--black); }
  .athlete-photo { display: block; width: 100%; aspect-ratio: 4 / 5; object-fit: cover; filter: saturate(.86) contrast(1.02); }
  .athlete-kicker { display: flex; justify-content: space-between; gap: 20px; margin-bottom: 18px; padding-bottom: 12px; border-bottom: 1px solid var(--black); font-size: 9px; font-weight: 900; letter-spacing: 1.4px; text-transform: uppercase; }
  .athlete-heading h1 { margin: 0; font-size: clamp(78px, 9vw, 132px); line-height: .76; letter-spacing: -5px; text-transform: uppercase; }
  .background { margin: 24px 0 0; font-size: 13px; font-weight: 900; letter-spacing: .6px; text-transform: uppercase; }
  .bio { max-width: 690px; margin: 24px 0 0; color: var(--gray); font-size: 18px; line-height: 1.55; }

  .marks-section { padding: 82px 0 96px; background: var(--beige); }
  .marks-grid { display: grid; grid-template-columns: 260px 1fr; gap: 72px; }
  .section-heading h2 { margin: 8px 0 0; font-size: clamp(50px, 6vw, 82px); line-height: .82; letter-spacing: -3px; text-transform: uppercase; }
  .pr-list { border-top: 1px solid var(--black); }
  .pr-row { display: grid; grid-template-columns: 1fr auto; gap: 24px; align-items: baseline; padding: 18px 0; border-bottom: 1px solid var(--black); }
  .pr-row span { font-size: 13px; font-weight: 800; text-transform: uppercase; }
  .pr-row strong { font-family: var(--display-font); font-size: 32px; letter-spacing: -1px; }

  .details-section { padding: 78px 0 92px; background: var(--beige-light); }
  .details-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 72px; }
  .detail-block { padding-top: 14px; border-top: 1px solid var(--black); }
  .detail-block > p:last-child, .detail-block li { font-size: 16px; line-height: 1.6; }
  .detail-block > p:last-child { max-width: 560px; margin: 24px 0 0; }
  .detail-block ul { margin: 24px 0 0; padding-left: 18px; }

  .racing-section { padding: 82px 0 96px; background: var(--black); color: var(--white); }
  .light-heading { margin-bottom: 34px; }
  .race-list { border-top: 1px solid rgba(255,255,255,.42); }
  .race-row { display: grid; grid-template-columns: 120px 1fr 180px; gap: 28px; align-items: center; padding: 24px 0; border-bottom: 1px solid rgba(255,255,255,.3); }
  .race-date strong, .race-date span { display: block; }
  .race-date span { margin-top: 4px; color: #999; font-size: 10px; }
  .race-event h3 { margin: 0; font-size: 26px; line-height: .95; text-transform: uppercase; }
  .race-event p { margin: 6px 0 0; color: #aaa; font-size: 12px; }
  .race-result { font-size: 13px; font-weight: 900; }

  .content-section { padding: 82px 0 96px; background: var(--mint); }
  .post-list { border-top: 1px solid var(--black); }
  .post-row { display: flex; justify-content: space-between; gap: 30px; align-items: center; padding: 24px 0; border-bottom: 1px solid var(--black); color: var(--black); text-decoration: none; }
  .post-meta { margin: 0 0 7px; font-size: 9px; font-weight: 900; letter-spacing: 1.4px; text-transform: uppercase; }
  .post-row h3 { margin: 0; font-size: 30px; line-height: .95; text-transform: uppercase; }
  .post-row > span { font-size: 26px; }
  .post-row:hover { opacity: .55; }

  @media (max-width: 850px) {
    .athlete-hero { padding: 36px 0 54px; }
    .athlete-hero-grid, .marks-grid, .details-grid { grid-template-columns: 1fr; gap: 34px; }
    .athlete-photo-wrap { max-width: 520px; }
    .athlete-heading h1 { font-size: 64px; letter-spacing: -3px; }
    .bio { font-size: 16px; }
    .marks-section, .details-section, .racing-section, .content-section { padding: 64px 0 74px; }
    .race-row { grid-template-columns: 82px 1fr; gap: 18px; }
    .race-result { grid-column: 2; }
    .section-heading h2 { font-size: 52px; }
  }
</style>
