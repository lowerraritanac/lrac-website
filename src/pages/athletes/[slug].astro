---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { athletes } from "../../../data/athletes.js";
import { races } from "../../../data/schedule.js";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  return athletes.map((athlete) => ({
    params: { slug: athlete.slug },
    props: { athlete },
  }));
}

const { athlete } = Astro.props;

const athleteRaces = races
  .filter((race) => race.athleteSlugs.includes(athlete.slug))
  .slice(0, 4);

const trainingPosts = await getCollection("training");

const athletePosts = trainingPosts
  .filter((post) => post.data.athleteSlug === athlete.slug)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);
---

<BaseLayout
  title={`${athlete.name} | LRAC`}
  description={`${athlete.name} — ${athlete.sport}, Lower Raritan Athletic Club.`}
>
  <section class="athlete-hero">
    <div class="section-inner athlete-hero-grid">
      <div class="athlete-photo-wrap">
        <img class="athlete-photo" src={athlete.image} alt={athlete.name} />
      </div>

      <div class="athlete-heading">
        <p class="eyebrow">{athlete.sport}</p>
        <h1>{athlete.name}</h1>
        <p class="location">{athlete.location}</p>
        <p class="background">{athlete.background}</p>
      </div>
    </div>
  </section>

  <section class="profile-section">
    <div class="section-inner profile-grid">
      <div><p class="section-label">PROFILE</p></div>
      <div><p class="bio">{athlete.bio}</p></div>
    </div>
  </section>

  <section class="prs-section">
    <div class="section-inner">
      <div class="section-heading">
        <p class="section-label">PERSONAL BESTS</p>
        <h2>Marks</h2>
      </div>

      <div class="pr-list">
        {athlete.prs.map(([event, mark]) => (
          <div class="pr-row">
            <span>{event}</span>
            <strong>{mark}</strong>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="details-section">
    <div class="section-inner details-grid">
      <div class="detail-block">
        <p class="section-label">SELECTED ACCOMPLISHMENTS</p>
        <ul>
          {athlete.accomplishments.map((item) => <li>{item}</li>)}
        </ul>
      </div>

      <div class="detail-block">
        <p class="section-label">CURRENT FOCUS</p>
        <p>{athlete.currentFocus}</p>
      </div>
    </div>
  </section>

  {athleteRaces.length > 0 && (
    <section class="racing-section">
      <div class="section-inner">
        <div class="section-heading">
          <p class="section-label">RACING</p>
          <h2>Recent & Upcoming</h2>
        </div>

        <div class="race-list">
          {athleteRaces.map((race) => (
            <div class="race-row">
              <div>
                <strong>{race.date}</strong>
                <span>{race.year}</span>
              </div>
              <div>
                <h3>{race.event}</h3>
                <p>{race.location}</p>
              </div>
              <div>{race.result || race.status}</div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {athletePosts.length > 0 && (
    <section class="content-section">
      <div class="section-inner">
        <div class="section-heading">
          <p class="section-label">TRAINING & WRITING</p>
          <h2>Latest</h2>
        </div>

        <div class="post-list">
          {athletePosts.map((post) => (
            <a class="post-row" href={`/training/${post.id}`}>
              <div>
                <p class="post-meta">
                  {post.data.category} · {post.data.date.toLocaleDateString("en-US", { month: "long", year: "numeric" })}
                </p>
                <h3>{post.data.title}</h3>
              </div>
              <span>→</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .athlete-hero { padding: 70px 0 90px; background: var(--mint); border-bottom: 1px solid var(--black); }
  .athlete-hero-grid { display: grid; grid-template-columns: 42% 1fr; gap: 70px; align-items: end; }
  .athlete-photo { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; display: block; border: 1px solid var(--black); }
  .athlete-heading h1 { margin: 24px 0 28px; font-size: clamp(72px, 9vw, 135px); line-height: 0.82; letter-spacing: -6px; text-transform: uppercase; }
  .location { margin: 0 0 8px; font-size: 14px; font-weight: 900; text-transform: uppercase; }
  .background { margin: 0; color: var(--gray); font-size: 14px; }
  .profile-section { padding: 90px 0; }
  .profile-grid { display: grid; grid-template-columns: 200px 1fr; gap: 80px; }
  .bio { margin: 0; max-width: 800px; font-size: clamp(28px, 4vw, 50px); line-height: 1.05; letter-spacing: -2px; }
  .prs-section { padding: 90px 0 110px; background: var(--beige-light); border-top: 1px solid var(--black); border-bottom: 1px solid var(--black); }
  .section-heading { margin-bottom: 40px; }
  .section-heading h2 { margin: 10px 0 0; font-size: clamp(48px, 7vw, 86px); line-height: 0.9; letter-spacing: -4px; text-transform: uppercase; }
  .pr-list { border-top: 1px solid var(--black); }
  .pr-row { display: flex; justify-content: space-between; gap: 30px; padding: 22px 0; border-bottom: 1px solid var(--black); font-size: 20px; }
  .pr-row strong { font-size: 26px; }
  .details-section { padding: 90px 0 110px; }
  .details-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 100px; }
  .detail-block ul { margin: 28px 0 0; padding-left: 20px; }
  .detail-block li, .detail-block > p:last-child { font-size: 18px; line-height: 1.6; }
  .racing-section { padding: 90px 0 110px; background: var(--black); color: var(--white); }
  .race-list { border-top: 1px solid rgba(255,255,255,0.4); }
  .race-row { display: grid; grid-template-columns: 120px 1fr 180px; gap: 30px; align-items: center; padding: 26px 0; border-bottom: 1px solid rgba(255,255,255,0.35); }
  .race-row span { display: block; margin-top: 4px; color: #999; font-size: 11px; }
  .race-row h3 { margin: 0; font-size: 24px; text-transform: uppercase; }
  .race-row p { margin: 5px 0 0; color: #aaa; }
  .content-section { padding: 90px 0 110px; background: var(--mint); }
  .post-list { border-top: 1px solid var(--black); }
  .post-row { display: flex; justify-content: space-between; gap: 30px; align-items: center; padding: 26px 0; border-bottom: 1px solid var(--black); color: var(--black); text-decoration: none; }
  .post-meta { margin: 0 0 7px; font-size: 10px; font-weight: 900; letter-spacing: 1.5px; text-transform: uppercase; }
  .post-row h3 { margin: 0; font-size: 30px; letter-spacing: -1px; text-transform: uppercase; }
  .post-row span { font-size: 28px; }
  .post-row:hover { opacity: 0.55; }
  @media (max-width: 850px) {
    .athlete-hero { padding: 40px 0 60px; }
    .athlete-hero-grid { grid-template-columns: 1fr; gap: 35px; }
    .athlete-photo { max-height: 520px; }
    .athlete-heading h1 { font-size: 62px; letter-spacing: -4px; }
    .profile-grid { grid-template-columns: 1fr; gap: 30px; }
    .bio { font-size: 30px; }
    .details-grid { grid-template-columns: 1fr; gap: 60px; }
    .race-row { grid-template-columns: 80px 1fr; }
    .race-row > div:last-child { grid-column: 2; }
    .section-heading h2 { font-size: 52px; letter-spacing: -3px; }
    .post-row h3 { font-size: 25px; }
  }
</style>
