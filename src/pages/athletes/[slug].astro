---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { athletes } from "../../../data/athletes.js";
import { races } from "../../../data/schedule.js";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  return athletes.map((athlete) => ({
    params: { slug: athlete.slug },
    props: { athlete },
  }));
}

const { athlete } = Astro.props;
const athleteRaces = races.filter((race) => race.athleteSlugs.includes(athlete.slug)).slice(0, 4);
const trainingPosts = await getCollection("training");
const athletePosts = trainingPosts
  .filter((post) => post.data.athleteSlug === athlete.slug)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);
---

<BaseLayout title={`${athlete.name} | LRAC`} description="Work in progress.">
  <section class="athlete-hero">
    <div class="section-inner athlete-hero-grid">
      <div class="athlete-photo-wrap">
        <img class="athlete-photo" src={athlete.image} alt={athlete.name} />
      </div>

      <div class="athlete-heading">
        <div class="athlete-kicker">
          <span>{athlete.sport}</span>
          <span>{athlete.location}</span>
        </div>
        <h1>{athlete.name}</h1>
        <p class="bio">{athlete.bio}</p>

        {athlete.social && (
          <div class="athlete-socials">
            <a href={athlete.social.instagram} target="_blank" rel="noreferrer">Instagram ↗</a>
            <a href={athlete.social.strava} target="_blank" rel="noreferrer">Strava ↗</a>
          </div>
        )}
      </div>
    </div>
  </section>

  <section class="marks-section">
    <div class="section-inner marks-grid">
      <div class="section-heading">
        <p class="section-label">PERSONAL BESTS</p>
        <h2>Marks</h2>
      </div>

      <div class="pr-list">
        {athlete.prs.map(([event, mark]) => (
          <div class="pr-row">
            <span>{event}</span>
            <strong>{mark}</strong>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="details-section">
    <div class="section-inner details-grid">
      <div class="detail-block">
        <p class="section-label">CURRENT FOCUS</p>
        <p>{athlete.currentFocus}</p>
      </div>
      <div class="detail-block">
        <p class="section-label">SELECTED ACCOMPLISHMENTS</p>
        <ul>{athlete.accomplishments.map((item) => <li>{item}</li>)}</ul>
      </div>
    </div>
  </section>

  {athleteRaces.length > 0 && (
    <section class="racing-section">
      <div class="section-inner">
        <div class="section-heading light-heading">
          <p class="section-label">RACING</p>
          <h2>Recent & Upcoming</h2>
        </div>
        <div class="race-list">
          {athleteRaces.map((race) => (
            <div class="race-row">
              <div class="race-date"><strong>{race.date}</strong><span>{race.year}</span></div>
              <div class="race-event"><h3>{race.event}</h3><p>{race.location}</p></div>
              <div class="race-result">{race.result || race.status}</div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {athletePosts.length > 0 && (
    <section class="content-section">
      <div class="section-inner">
        <div class="section-heading">
          <p class="section-label">TRAINING & WRITING</p>
          <h2>Latest</h2>
        </div>
        <div class="post-list">
          {athletePosts.map((post) => (
            <a class="post-row" href={`/training/${post.id}`}>
              <div>
                <p class="post-meta">{post.data.category} · {post.data.date.toLocaleDateString("en-US", { month: "long", year: "numeric" })}</p>
                <h3>{post.data.title}</h3>
              </div>
              <span>→</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .athlete-hero { padding: 56px 0 70px; background: var(--beige-light); border-bottom: 1px solid var(--black); position: relative; }
  .athlete-hero::after { content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 8px; background: var(--mint); border-top: 1px solid var(--black); }
  .athlete-hero-grid { display: grid; grid-template-columns: minmax(320px, 42%) 1fr; gap: 58px; align-items: end; }
  .athlete-photo-wrap { overflow: hidden; background: #d9d4ca; }
  .athlete-photo { display: block; width: 100%; aspect-ratio: 4 / 5; object-fit: cover; filter: saturate(.74) contrast(1.04); }
  .athlete-kicker { display: flex; justify-content: space-between; gap: 20px; margin-bottom: 16px; padding-bottom: 11px; border-bottom: 1px solid var(--black); font-size: 9px; font-weight: 700; letter-spacing: 1.3px; text-transform: uppercase; }
  .athlete-heading h1 { margin: 0; font-size: clamp(64px, 7vw, 104px); line-height: .92; letter-spacing: -2.8px; text-transform: uppercase; }
  .bio { max-width: 620px; margin: 26px 0 0; color: var(--gray); font-size: 15px; line-height: 1.5; }
  .athlete-socials { display: flex; gap: 18px; flex-wrap: wrap; margin-top: 24px; padding-top: 14px; border-top: 1px solid var(--black); }
  .athlete-socials a { color: var(--black); text-decoration: none; font-size: 9px; font-weight: 700; letter-spacing: 1.1px; text-transform: uppercase; border-bottom: 1px solid currentColor; padding-bottom: 3px; }
  .athlete-socials a:hover { opacity: .5; }

  .marks-section { padding: 78px 0 90px; background: var(--beige); }
  .marks-grid { display: grid; grid-template-columns: 250px 1fr; gap: 68px; }
  .section-heading h2 { margin: 7px 0 0; font-size: clamp(46px, 5vw, 72px); line-height: .95; letter-spacing: -2px; text-transform: uppercase; }
  .pr-list { border-top: 1px solid var(--black); }
  .pr-row { display: grid; grid-template-columns: 1fr auto; gap: 24px; align-items: baseline; padding: 16px 0; border-bottom: 1px solid var(--black); }
  .pr-row span { font-size: 11px; font-weight: 700; letter-spacing: .5px; text-transform: uppercase; }
  .pr-row strong { font-family: var(--display-font); font-size: 30px; line-height: 1; letter-spacing: -.7px; }

  .details-section { padding: 72px 0 84px; background: var(--beige-light); }
  .details-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; }
  .detail-block { padding-top: 12px; border-top: 1px solid var(--black); }
  .detail-block > p:last-child, .detail-block li { font-size: 14px; line-height: 1.5; }
  .detail-block > p:last-child { margin: 20px 0 0; }
  .detail-block ul { margin: 20px 0 0; padding-left: 17px; }

  .racing-section { padding: 78px 0 90px; background: var(--black); color: var(--white); }
  .light-heading { margin-bottom: 30px; }
  .race-list { border-top: 1px solid rgba(255,255,255,.42); }
  .race-row { display: grid; grid-template-columns: 110px 1fr 180px; gap: 26px; align-items: center; padding: 22px 0; border-bottom: 1px solid rgba(255,255,255,.3); }
  .race-date strong, .race-date span { display: block; }
  .race-date strong { font-family: var(--display-font); font-size: 21px; }
  .race-date span { margin-top: 2px; color: #999; font-size: 9px; }
  .race-event h3 { margin: 0; font-size: 25px; line-height: .95; text-transform: uppercase; }
  .race-event p { margin: 5px 0 0; color: #aaa; font-size: 11px; }
  .race-result { font-size: 12px; font-weight: 700; }

  .content-section { padding: 78px 0 90px; background: var(--mint); }
  .post-list { border-top: 1px solid var(--black); }
  .post-row { display: flex; justify-content: space-between; gap: 30px; align-items: center; padding: 22px 0; border-bottom: 1px solid var(--black); color: var(--black); text-decoration: none; }
  .post-meta { margin: 0 0 6px; font-size: 8px; font-weight: 700; letter-spacing: 1.4px; text-transform: uppercase; }
  .post-row h3 { margin: 0; font-size: 29px; line-height: .94; text-transform: uppercase; }
  .post-row > span { font-size: 24px; }

  @media (max-width: 850px) {
    .athlete-hero { padding: 34px 0 52px; }
    .athlete-hero-grid, .marks-grid, .details-grid { grid-template-columns: 1fr; gap: 32px; }
    .athlete-photo-wrap { max-width: 520px; }
    .athlete-heading h1 { font-size: clamp(42px, 11vw, 58px); line-height: .98; letter-spacing: -1.5px; }
    .athlete-socials { margin-top: 20px; }
    .marks-section, .details-section, .racing-section, .content-section { padding: 60px 0 70px; }
    .race-row { grid-template-columns: 80px 1fr; gap: 16px; }
    .race-result { grid-column: 2; }
    .section-heading h2 { font-size: 44px; }
  }
</style>
