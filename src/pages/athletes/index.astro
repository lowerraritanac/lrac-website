---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AthleteCard from "../../components/AthleteCard.astro";
import { athletes } from "../../../data/athletes.js";
import { site } from "../../../data/site.js";
---

<BaseLayout title="Athletes | LRAC" description={`Athletes of ${site.name}.`}>
  <section class="page-hero athletes-hero">
    <div class="section-inner">
      <p class="eyebrow">{site.name}</p>
      <div class="hero-row">
        <h1>Athletes</h1>
        <span>{String(athletes.length).padStart(2, "0")}</span>
      </div>
    </div>
  </section>

  <section class="athletes-section">
    <div class="section-inner athlete-grid">
      {athletes.map((athlete) => <AthleteCard athlete={athlete} showBackground={true} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .athletes-hero { background: var(--beige-light); }
  .hero-row { display: flex; justify-content: space-between; align-items: flex-end; gap: 40px; }
  .hero-row span { font-size: 13px; font-weight: 900; letter-spacing: 2px; }
  .athletes-section { padding: 82px 0 110px; background: var(--beige-light); }
  .athlete-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }

  @media (max-width: 850px) {
    .athlete-grid { grid-template-columns: 1fr; gap: 48px; }
  }
</style>
