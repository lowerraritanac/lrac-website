---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AthleteCard from "../../components/AthleteCard.astro";
import { athletes } from "../../../data/athletes.js";
import { races } from "../../../data/schedule.js";
import { site } from "../../../data/site.js";

const lracAthletes = athletes.filter((athlete) => athlete.currentMember !== false);
const collegiateAthletes = athletes.filter((athlete) => athlete.currentMember === false);
const upcomingRaces = races.filter((race) => race.status === "Upcoming" || race.status === "Tentative").slice(0, 4);
const recentResults = races.filter((race) => race.status === "Completed").slice(0, 3);
const trainingSlugs = new Set(["liam-tilton", "aaron-wysocki"]);
const resultHref = (race) => {
  const slug = race.athleteSlugs?.find((athleteSlug) => trainingSlugs.has(athleteSlug));
  return slug ? `/training/${slug}` : "/racing";
};
---

<BaseLayout title="Athletes | LRAC" description="Athletes of Lower Raritan Athletic Club.">
  <section class="page-hero athletes-hero">
    <div class="section-inner">
      <p class="eyebrow">{site.name}</p>
      <div class="hero-row"><h1>Athletes</h1><span>{String(athletes.length).padStart(2, "0")}</span></div>
    </div>
  </section>

  <section class="athletes-section">
    <div class="section-inner">
      <div class="roster-heading">
        <p class="section-label">LRAC Athletes</p>
        <span>{String(lracAthletes.length).padStart(2, "0")}</span>
      </div>
      <div class="athlete-grid">
        {lracAthletes.map((athlete) => (
          <div class="athlete-wrap">
            <AthleteCard athlete={athlete} />
            {trainingSlugs.has(athlete.slug) && <a class="training-link" href={`/training/${athlete.slug}`}>Training data →</a>}
          </div>
        ))}

        <div id="join-lrac" class="mobile-join-card">
          <div class="mobile-join-heading">
            <span>Join LRAC</span>
            <strong>Interested?</strong>
          </div>

          <form id="mobile-join-form" class="mobile-join-form">
            <label>
              <span>Name</span>
              <input type="text" name="name" autocomplete="name" required />
            </label>
            <label>
              <span>Email</span>
              <input type="email" name="email" autocomplete="email" required />
            </label>
            <label class="message-field">
              <span>Message</span>
              <textarea name="message" rows="3" required></textarea>
            </label>
            <button type="submit">Send →</button>
          </form>
        </div>
      </div>

      {collegiateAthletes.length > 0 && (
        <div class="collegiate-block">
          <div class="roster-heading collegiate-heading">
            <p class="section-label">Collegiate Athletes</p>
            <span>{String(collegiateAthletes.length).padStart(2, "0")}</span>
          </div>
          <div class="athlete-grid collegiate-grid">
            {collegiateAthletes.map((athlete) => (
              <div class="athlete-wrap">
                <AthleteCard athlete={athlete} />
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  {upcomingRaces.length > 0 && (
    <section class="upcoming-section">
      <div class="section-inner race-section-grid">
        <div class="race-heading">
          <p class="section-label">Upcoming Races</p>
          <h2>On deck</h2>
          <a class="section-link" href="/racing">All racing →</a>
        </div>
        <div class="upcoming-list">
          {upcomingRaces.map((race) => (
            <a class="upcoming-row" href="/racing">
              <div class="race-date"><strong>{race.date}</strong><span>{race.year}</span></div>
              <div class="race-main"><span>{race.discipline}</span><strong>{race.event}</strong><small>{race.location}</small></div>
              <div class="race-athletes">{race.athletes.join(" · ")}</div>
              <b class="row-arrow">→</b>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {recentResults.length > 0 && (
    <section class="results-section">
      <div class="section-inner results-grid">
        <div><p class="section-label">Recent Results</p><h2>Results</h2><a class="section-link" href="/racing">All results →</a></div>
        <div class="results-list">
          {recentResults.map((race) => (
            <a class="result-row" href={resultHref(race)}>
              <span>{race.date} {race.year}</span>
              <strong>{race.event}</strong>
              <span>{race.athletes.join(" · ")}</span>
              <span>{race.result}</span>
              <b class="result-arrow">→</b>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section id="join-lrac-desktop" class="join-section"><div class="section-inner join-grid"><p class="section-label">Join LRAC</p><a class="join-email" href={`mailto:${site.email}`}>{site.email} ↗</a></div></section>
</BaseLayout>

<script define:vars={{ joinEmail: site.email }}>
  const joinForm = document.getElementById("mobile-join-form");

  joinForm?.addEventListener("submit", (event) => {
    event.preventDefault();
    const data = new FormData(joinForm);
    const name = String(data.get("name") || "");
    const email = String(data.get("email") || "");
    const message = String(data.get("message") || "");
    const subject = `LRAC membership inquiry — ${name}`;
    const body = [`Name: ${name}`, `Email: ${email}`, "", message].join("\n");
    window.location.href = `mailto:${joinEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  });
</script>

<style>
.athletes-hero{background:var(--paper)}.hero-row{display:flex;justify-content:space-between;align-items:flex-end;gap:40px}.hero-row span,.roster-heading>span{padding-bottom:7px;font-family:var(--mono);font-size:11px;font-weight:600;letter-spacing:2px}.athletes-section{padding:68px 0 92px;background:var(--paper)}.roster-heading{display:flex;justify-content:space-between;align-items:flex-end;gap:24px;padding-bottom:14px;margin-bottom:24px;border-bottom:1px solid var(--ink)}.roster-heading>span{padding-bottom:0}.athlete-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px;align-items:start}.athlete-wrap{min-width:0}.collegiate-block{margin-top:76px;padding-top:0}.collegiate-heading{margin-bottom:24px}.training-link,.section-link{display:inline-block;margin-top:12px;font-family:var(--mono);font-size:8px;font-weight:600;text-transform:uppercase;text-decoration:none;border-bottom:1px solid currentColor;padding-bottom:2px}.training-link:hover,.section-link:hover{color:var(--mint-dark)}.mobile-join-card{display:none}
.upcoming-section{padding:62px 0 72px;background:var(--paper);border-top:1px solid var(--ink)}.race-section-grid{display:grid;grid-template-columns:190px 1fr;gap:52px}.race-heading h2{margin:14px 0 0;font-size:clamp(42px,5vw,62px);line-height:.95}.upcoming-list{border-top:1px solid var(--ink)}.upcoming-row{display:grid;grid-template-columns:92px minmax(0,1fr) 180px 22px;gap:20px;align-items:center;padding:18px 0;border-bottom:1px solid var(--ink);color:var(--ink);text-decoration:none;transition:padding .15s ease,color .15s ease}.upcoming-row:hover{padding-left:8px;color:var(--mint-dark)}.race-date strong,.race-date span,.race-main span,.race-main small,.race-athletes,.row-arrow{font-family:var(--mono)}.race-date strong{display:block;font-size:14px}.race-date span{display:block;margin-top:4px;color:var(--gray);font-size:8px}.race-main span{display:block;margin-bottom:5px;color:var(--mint-dark);font-size:8px;font-weight:700;text-transform:uppercase}.race-main strong{display:block;font-family:var(--editorial);font-size:26px;line-height:1}.race-main small{display:block;margin-top:6px;color:var(--gray);font-size:8px}.race-athletes{font-size:9px;text-transform:uppercase}.row-arrow{font-size:15px;text-align:right}
.results-section{padding:58px 0 68px;background:var(--beige);border-top:1px solid var(--ink)}.results-grid{display:grid;grid-template-columns:180px 1fr;gap:52px}.results-grid h2{margin:14px 0 0;font-size:clamp(42px,5vw,62px);line-height:.95}.results-list{border-top:1px solid var(--ink)}.result-row{display:grid;grid-template-columns:110px minmax(0,1fr) 180px 150px 22px;gap:20px;align-items:center;padding:17px 0;border-bottom:1px solid var(--ink);color:var(--ink);text-decoration:none;transition:padding .15s ease,color .15s ease}.result-row:hover{padding-left:8px;color:var(--mint-dark)}.result-row span{font-family:var(--mono);font-size:9px;text-transform:uppercase}.result-row strong{font-family:var(--editorial);font-size:24px;font-weight:600;line-height:1}.result-row span:nth-last-of-type(1){text-align:right;font-weight:700}.result-arrow{font-family:var(--mono);font-size:14px;text-align:right}.join-section{padding:34px 0;background:var(--mint);border-top:1px solid var(--ink)}.join-grid{display:flex;justify-content:space-between;gap:30px;align-items:center}.join-email{font-family:var(--mono);font-size:11px;font-weight:600;text-decoration:none;border-bottom:1px solid currentColor;padding-bottom:3px}
@media(max-width:850px){.athletes-hero{padding-top:34px;padding-bottom:30px}.hero-row{align-items:baseline}.hero-row span{padding-bottom:0}.athletes-section{padding:34px 0 48px}.roster-heading{margin-bottom:16px;padding-bottom:10px}.roster-heading>span{font-size:9px}.athlete-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:28px 12px;align-items:stretch}.athlete-wrap{display:flex;min-width:0;flex-direction:column}.collegiate-block{margin-top:52px}.collegiate-grid{align-items:start}.training-link{display:flex;width:100%;min-height:32px;margin-top:7px;align-items:center;padding:0;border-top:1px solid var(--ink);border-bottom:0;font-size:7px}.mobile-join-card{display:flex;min-width:0;height:100%;min-height:0;flex-direction:column;padding:11px;background:var(--mint);border:1px solid var(--ink);scroll-margin-top:76px}.mobile-join-heading span{display:block;font-family:var(--mono);font-size:7px;font-weight:600;letter-spacing:.08em;text-transform:uppercase}.mobile-join-heading strong{display:block;margin-top:4px;font-family:var(--editorial);font-size:clamp(21px,5.8vw,28px);line-height:.94}.mobile-join-form{display:flex;flex:1;min-height:0;flex-direction:column;margin-top:8px}.mobile-join-form label{display:block;margin-top:6px}.mobile-join-form label span{display:block;margin-bottom:2px;font-family:var(--mono);font-size:6px;font-weight:600;letter-spacing:.06em;text-transform:uppercase}.mobile-join-form input,.mobile-join-form textarea{display:block;width:100%;height:30px;border:0;border-bottom:1px solid var(--ink);border-radius:0;padding:1px 0 3px;background:transparent;color:var(--ink);font-family:var(--editorial);font-size:15px;line-height:1.05;outline:none}.mobile-join-form .message-field{display:flex;min-height:0;flex:1;flex-direction:column}.mobile-join-form textarea{flex:1;height:auto;min-height:34px;resize:none}.mobile-join-form input:focus,.mobile-join-form textarea:focus{border-bottom-width:2px}.mobile-join-form button{width:100%;min-height:34px;margin-top:8px;padding:7px 6px;border:1px solid var(--ink);border-radius:0;background:var(--ink);color:var(--white);font-family:var(--mono);font-size:7px;font-weight:600;letter-spacing:.08em;text-transform:uppercase}.upcoming-section,.results-section{padding:44px 0 50px}.race-section-grid,.results-grid{grid-template-columns:1fr;gap:18px}.race-heading{display:grid;grid-template-columns:1fr auto;align-items:end;gap:6px 16px}.race-heading .section-label,.race-heading h2{grid-column:1}.race-heading .section-link{display:flex;grid-column:2;grid-row:1 / 3;min-height:32px;align-self:end;align-items:center;margin:0}.upcoming-row{grid-template-columns:64px minmax(0,1fr) 18px;gap:12px;padding:14px 0}.race-athletes{grid-column:2;font-size:7px}.row-arrow{grid-column:3;grid-row:1 / 3;align-self:center}.race-main strong{font-size:21px}.result-row{grid-template-columns:1fr auto 18px;gap:7px 12px;align-items:start;padding:15px 0}.result-row strong{grid-column:1/-1;font-size:22px}.result-row span:nth-of-type(2){grid-column:1}.result-row span:nth-last-of-type(1){grid-column:2;grid-row:3;text-align:right}.result-arrow{grid-column:3;grid-row:1/4;align-self:center}.join-section{display:none}}
</style>
