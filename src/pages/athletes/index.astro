---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AthleteCard from "../../components/AthleteCard.astro";
import { athletes } from "../../../data/athletes.js";
import { races } from "../../../data/schedule.js";
import { site } from "../../../data/site.js";

const upcomingRaces = races.filter((race) => race.status === "Upcoming" || race.status === "Tentative").slice(0, 4);
const recentResults = races.filter((race) => race.status === "Completed").slice(0, 3);
const trainingSlugs = new Set(["liam-tilton", "aaron-wysocki"]);
const resultHref = (race) => {
  const slug = race.athleteSlugs?.find((athleteSlug) => trainingSlugs.has(athleteSlug));
  return slug ? `/training/${slug}` : "/racing";
};
---

<BaseLayout title="Athletes | LRAC" description="Athletes of Lower Raritan Athletic Club.">
  <section class="page-hero athletes-hero">
    <div class="section-inner">
      <p class="eyebrow">{site.name}</p>
      <div class="hero-row"><h1>Athletes</h1><span>{String(athletes.length).padStart(2, "0")}</span></div>
    </div>
  </section>

  <section class="athletes-section">
    <div class="section-inner athlete-grid">
      {athletes.map((athlete) => (
        <div class="athlete-wrap">
          <AthleteCard athlete={athlete} />
          {trainingSlugs.has(athlete.slug) && <a class="training-link" href={`/training/${athlete.slug}`}>Training data →</a>}
        </div>
      ))}
    </div>
  </section>

  {upcomingRaces.length > 0 && (
    <section class="upcoming-section">
      <div class="section-inner race-section-grid">
        <div class="race-heading">
          <p class="section-label">Upcoming Races</p>
          <h2>On deck</h2>
          <a class="section-link" href="/racing">All racing →</a>
        </div>
        <div class="upcoming-list">
          {upcomingRaces.map((race) => (
            <a class="upcoming-row" href="/racing">
              <div class="race-date"><strong>{race.date}</strong><span>{race.year}</span></div>
              <div class="race-main"><span>{race.discipline}</span><strong>{race.event}</strong><small>{race.location}</small></div>
              <div class="race-athletes">{race.athletes.join(" · ")}</div>
              <b class="row-arrow">→</b>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {recentResults.length > 0 && (
    <section class="results-section">
      <div class="section-inner results-grid">
        <div><p class="section-label">Recent Results</p><h2>Results</h2><a class="section-link" href="/racing">All results →</a></div>
        <div class="results-list">
          {recentResults.map((race) => (
            <a class="result-row" href={resultHref(race)}>
              <span>{race.date} {race.year}</span>
              <strong>{race.event}</strong>
              <span>{race.athletes.join(" · ")}</span>
              <span>{race.result}</span>
              <b class="result-arrow">→</b>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="join-section"><div class="section-inner join-grid"><p class="section-label">Join LRAC</p><a class="join-email" href={`mailto:${site.email}`}>{site.email} ↗</a></div></section>
</BaseLayout>

<style>
.athletes-hero{background:var(--paper)}.hero-row{display:flex;justify-content:space-between;align-items:flex-end;gap:40px}.hero-row span{padding-bottom:7px;font-family:var(--mono);font-size:11px;font-weight:600;letter-spacing:2px}.athletes-section{padding:68px 0 92px;background:var(--paper)}.athlete-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:22px;align-items:start}.athlete-wrap{min-width:0}.training-link,.section-link{display:inline-block;margin-top:12px;font-family:var(--mono);font-size:8px;font-weight:600;text-transform:uppercase;text-decoration:none;border-bottom:1px solid currentColor;padding-bottom:2px}.training-link:hover,.section-link:hover{color:var(--mint-dark)}
.upcoming-section{padding:62px 0 72px;background:var(--paper);border-top:1px solid var(--ink)}.race-section-grid{display:grid;grid-template-columns:190px 1fr;gap:52px}.race-heading h2{margin:14px 0 0;font-size:clamp(42px,5vw,62px);line-height:.95}.upcoming-list{border-top:1px solid var(--ink)}.upcoming-row{display:grid;grid-template-columns:92px minmax(0,1fr) 180px 22px;gap:20px;align-items:center;padding:18px 0;border-bottom:1px solid var(--ink);color:var(--ink);text-decoration:none;transition:padding .15s ease,color .15s ease}.upcoming-row:hover{padding-left:8px;color:var(--mint-dark)}.race-date strong,.race-date span,.race-main span,.race-main small,.race-athletes,.row-arrow{font-family:var(--mono)}.race-date strong{display:block;font-size:14px}.race-date span{display:block;margin-top:4px;color:var(--gray);font-size:8px}.race-main span{display:block;margin-bottom:5px;color:var(--mint-dark);font-size:8px;font-weight:700;text-transform:uppercase}.race-main strong{display:block;font-family:var(--editorial);font-size:26px;line-height:1}.race-main small{display:block;margin-top:6px;color:var(--gray);font-size:8px}.race-athletes{font-size:9px;text-transform:uppercase}.row-arrow{font-size:15px;text-align:right}
.results-section{padding:58px 0 68px;background:var(--beige);border-top:1px solid var(--ink)}.results-grid{display:grid;grid-template-columns:180px 1fr;gap:52px}.results-grid h2{margin:14px 0 0;font-size:clamp(42px,5vw,62px);line-height:.95}.results-list{border-top:1px solid var(--ink)}.result-row{display:grid;grid-template-columns:110px minmax(0,1fr) 180px 150px 22px;gap:20px;align-items:center;padding:17px 0;border-bottom:1px solid var(--ink);color:var(--ink);text-decoration:none;transition:padding .15s ease,color .15s ease}.result-row:hover{padding-left:8px;color:var(--mint-dark)}.result-row span{font-family:var(--mono);font-size:9px;text-transform:uppercase}.result-row strong{font-family:var(--editorial);font-size:24px;font-weight:600;line-height:1}.result-row span:nth-last-of-type(1){text-align:right;font-weight:700}.result-arrow{font-family:var(--mono);font-size:14px;text-align:right}.join-section{padding:34px 0;background:var(--mint);border-top:1px solid var(--ink)}.join-grid{display:flex;justify-content:space-between;gap:30px;align-items:center}.join-email{font-family:var(--mono);font-size:11px;font-weight:600;text-decoration:none;border-bottom:1px solid currentColor;padding-bottom:3px}
@media(max-width:850px){.athletes-hero{padding-top:38px;padding-bottom:34px}.hero-row{align-items:baseline}.hero-row span{padding-bottom:0}.athletes-section{padding:38px 0 54px}.athlete-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:34px 12px}.training-link{margin-top:8px;font-size:7px}.upcoming-section,.results-section{padding:46px 0 54px}.race-section-grid,.results-grid{grid-template-columns:1fr;gap:20px}.race-heading{display:grid;grid-template-columns:1fr auto;align-items:end;gap:6px 16px}.race-heading .section-label,.race-heading h2{grid-column:1}.race-heading .section-link{grid-column:2;grid-row:1 / 3;align-self:end;margin:0 0 3px}.upcoming-row{grid-template-columns:64px minmax(0,1fr) 18px;gap:12px;padding:15px 0}.race-athletes{grid-column:2;font-size:7px}.row-arrow{grid-column:3;grid-row:1 / 3;align-self:center}.race-main strong{font-size:21px}.result-row{grid-template-columns:1fr auto 18px;gap:7px 12px;align-items:start}.result-row strong{grid-column:1/-1;font-size:22px}.result-row span:nth-of-type(2){grid-column:1}.result-row span:nth-last-of-type(1){grid-column:2;grid-row:3;text-align:right}.result-arrow{grid-column:3;grid-row:1/4;align-self:center}.join-grid{align-items:flex-start;flex-direction:column;gap:12px}.join-email{font-size:9px}}
</style>