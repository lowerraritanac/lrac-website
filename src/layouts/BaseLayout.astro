---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../../data/site.js";
import "../styles/global.css";

const {
  title = "Lower Raritan Athletic Club",
  description = site.description,
  image = "/images/hero.jpg",
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, "https://lowerraritanac.com");
const socialImage = new URL(image, "https://lowerraritanac.com");
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "SportsOrganization",
  name: site.name,
  alternateName: site.shortName,
  url: "https://lowerraritanac.com",
  description: site.description,
  foundingDate: site.founded,
  areaServed: site.location,
  email: site.email,
  sameAs: [site.social.instagram, site.social.strava],
};
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <meta name="theme-color" content="#f3eee4" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/jpeg" href="/images/hero.jpg" />
    <link rel="apple-touch-icon" href="/images/hero.jpg" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={site.name} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
  </head>

  <body>
    <Header />

    <main>
      <slot />
    </main>

    <Footer />
  </body>
</html>
