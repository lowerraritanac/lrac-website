---
const { athleteName, athleteSlug, weeklyMileage, latestWeek, trainingDataSource, races = [] } = Astro.props;
const maxMiles = Math.max(...weeklyMileage.map((week) => week.miles));
const maxHours = Math.max(...weeklyMileage.map((week) => week.hours));
const rolling4Miles = weeklyMileage.slice(-4).reduce((sum, week) => sum + week.miles, 0) / 4;
const rolling4Hours = weeklyMileage.slice(-4).reduce((sum, week) => sum + week.hours, 0) / 4;
const highMileageWeek = weeklyMileage.reduce((best, week) => week.miles > best.miles ? week : best, weeklyMileage[0]);
const highHoursWeek = weeklyMileage.reduce((best, week) => week.hours > best.hours ? week : best, weeklyMileage[0]);
const daysRun = latestWeek.dailyMiles.filter(([, miles]) => miles > 0).length;
const longestDay = latestWeek.dailyMiles.reduce((best, day) => day[1] > best[1] ? day : best, latestWeek.dailyMiles[0]);
const monthMap = { JAN:0,FEB:1,MAR:2,APR:3,MAY:4,JUN:5,JUL:6,AUG:7,SEP:8,OCT:9,NOV:10,DEC:11 };
const raceDate = (race) => { const [m,d] = race.date.split(" "); return new Date(Number(race.year), monthMap[m], Number(d), 12); };
const weekForDate = (date) => { const result = new Date(date); result.setDate(result.getDate() + (7 - result.getDay()) % 7); return result.toISOString().slice(0,10); };
const raceByWeek = new Map();
for (const race of races.filter((race) => race.status === "Completed")) { const key = weekForDate(raceDate(race)); if (!raceByWeek.has(key)) raceByWeek.set(key, []); raceByWeek.get(key).push(race); }
const formatWeek = (d) => new Date(`${d}T12:00:00`).toLocaleDateString("en-US",{month:"short",day:"numeric"});
const formatLongDate = (d) => new Date(`${d}T12:00:00`).toLocaleDateString("en-US",{month:"short",day:"numeric",year:"numeric"});
---
<section class="analytics-hero"><div class="section-inner hero-grid"><div><p class="eyebrow">Training / {athleteName}</p><h1>{athleteName}</h1></div><div class="hero-meta"><span>{trainingDataSource.name}</span><span>{formatWeek(weeklyMileage[0].weekEnding)} — {formatLongDate(trainingDataSource.through)}</span><a href={`/athletes/${athleteSlug}`}>Athlete profile →</a></div></div></section>
<section class="summary-section"><div class="section-inner summary-grid"><div class="summary-label"><p class="section-label">Volume</p><h2>{weeklyMileage.length} weeks</h2></div><div class="stat-grid"><div class="stat primary"><strong>{latestWeek.totalMiles}</strong><span>Miles · latest week</span></div><div class="stat primary"><strong>{latestWeek.totalHours.toFixed(1)}</strong><span>Hours · latest week</span></div><div class="stat"><strong>{rolling4Miles.toFixed(1)}</strong><span>Miles · 4-week avg</span></div><div class="stat"><strong>{rolling4Hours.toFixed(1)}</strong><span>Hours · 4-week avg</span></div></div></div></section>
<section class="chart-section"><div class="section-inner chart-grid"><div class="chart-heading"><p class="section-label">Weekly Mileage</p><h2>Miles</h2><p class="chart-note">High week: {highMileageWeek.miles} miles · {formatWeek(highMileageWeek.weekEnding)}</p><p class="interaction-note">Tap a week for exact value.</p></div><div class="weekly-chart" aria-label={`Weekly running mileage for ${athleteName}`} style={`--week-count:${weeklyMileage.length}`}>{weeklyMileage.map((week) => { const weekRaces = raceByWeek.get(week.weekEnding)||[]; return <div class={`week-column ${weekRaces.length ? "race-week" : ""}`} tabindex="0"><div class="tooltip">{week.miles} MI</div>{weekRaces.length>0 && <div class="race-marker"><span>Race</span></div>}<div class="bar-area"><div class="bar" style={`height:${(week.miles/maxMiles)*100}%`}></div></div><strong>{week.miles}</strong><span>{formatWeek(week.weekEnding)}</span>{weekRaces.length>0 && <small>{weekRaces[0].discipline}</small>}</div>; })}</div></div></section>
<section class="chart-section hours-section"><div class="section-inner chart-grid"><div class="chart-heading"><p class="section-label">Weekly Running Time</p><h2>Hours</h2><p class="chart-note">High week: {highHoursWeek.hours.toFixed(1)} hours · {formatWeek(highHoursWeek.weekEnding)}</p></div><div class="weekly-chart" aria-label={`Weekly running hours for ${athleteName}`} style={`--week-count:${weeklyMileage.length}`}>{weeklyMileage.map((week) => { const weekRaces = raceByWeek.get(week.weekEnding)||[]; return <div class={`week-column ${weekRaces.length ? "race-week" : ""}`} tabindex="0"><div class="tooltip">{week.hours.toFixed(1)} HR</div>{weekRaces.length>0 && <div class="race-marker"><span>Race</span></div>}<div class="bar-area"><div class="bar hours-bar" style={`height:${(week.hours/maxHours)*100}%`}></div></div><strong>{week.hours.toFixed(1)}</strong><span>{formatWeek(week.weekEnding)}</span>{weekRaces.length>0 && <small>{weekRaces[0].discipline}</small>}</div>; })}</div></div></section>
<section class="latest-section"><div class="section-inner latest-grid"><div class="latest-heading"><p class="section-label">Latest Week</p><h2>{latestWeek.label}</h2><div class="latest-meta"><div><strong>{daysRun}</strong><span>Days run</span></div><div><strong>{longestDay[1]}</strong><span>Longest day · {longestDay[0]}</span></div></div></div><div class="daily-grid">{latestWeek.dailyMiles.map(([day,miles]) => <div class="day-row"><span>{day}</span><div class="day-bar-wrap"><div class="day-bar" style={`width:${(miles/Math.max(...latestWeek.dailyMiles.map(([,v])=>v)))*100}%`}></div></div><strong>{miles}</strong></div>)}</div></div></section>
<style>
.analytics-hero{padding:56px 0 48px;border-bottom:1px solid var(--ink)}.hero-grid{display:flex;justify-content:space-between;gap:48px;align-items:flex-end}.analytics-hero h1{margin:14px 0 0;font-size:clamp(58px,7vw,96px);line-height:.92;letter-spacing:-.045em}.hero-meta{display:flex;flex-direction:column;gap:5px;text-align:right;font-family:var(--mono);font-size:9px;text-transform:uppercase}.hero-meta a{text-decoration:none;margin-top:7px}.summary-section{padding:46px 0 52px;background:var(--beige);border-bottom:1px solid var(--ink)}.summary-grid{display:grid;grid-template-columns:220px 1fr;gap:48px}.summary-label h2{margin:14px 0 0;font-size:44px;line-height:.95}.stat-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));border-top:1px solid var(--ink);border-bottom:1px solid var(--ink)}.stat{padding:16px 16px 14px 0}.stat+.stat{padding-left:16px;border-left:1px solid var(--ink)}.stat strong,.stat span{display:block;font-family:var(--mono)}.stat strong{font-size:clamp(24px,3vw,38px);line-height:1}.stat span{margin-top:7px;color:var(--gray);font-size:8px;text-transform:uppercase}.chart-section{padding:58px 0 64px;background:var(--paper)}.hours-section{background:var(--beige);border-top:1px solid var(--ink)}.chart-grid{display:grid;grid-template-columns:220px minmax(0,1fr);gap:48px;align-items:end}.chart-heading h2{margin:14px 0 10px;font-size:clamp(48px,5vw,68px);line-height:.94}.chart-note,.interaction-note{margin:0;color:var(--gray);font-family:var(--mono);font-size:8px;line-height:1.45;text-transform:uppercase}.interaction-note{margin-top:8px;font-size:7px}.weekly-chart{display:grid;grid-template-columns:repeat(var(--week-count),minmax(54px,1fr));gap:12px;align-items:end;overflow-x:auto;padding:26px 2px 4px;scrollbar-width:thin}.week-column{min-width:54px;text-align:center;position:relative;outline:none}.tooltip{position:absolute;top:-5px;left:50%;transform:translate(-50%,-100%);padding:5px 7px;background:var(--ink);color:var(--white);font-family:var(--mono);font-size:8px;white-space:nowrap;opacity:0;pointer-events:none;z-index:3}.week-column:hover .tooltip,.week-column:focus .tooltip{opacity:1}.bar-area{display:flex;align-items:flex-end;justify-content:center;height:230px;border-bottom:1px solid var(--ink)}.bar{width:52%;max-width:30px;min-height:2px;background:var(--mint-dark)}.hours-bar{background:var(--ink)}.week-column strong{display:block;margin-top:7px;font-family:var(--mono);font-size:8px}.week-column>span{display:block;margin-top:3px;color:var(--gray);font-family:var(--mono);font-size:7px;text-transform:uppercase}.week-column small{display:block;min-height:10px;margin-top:4px;font-family:var(--mono);font-size:6px;text-transform:uppercase}.race-marker{position:absolute;left:50%;top:4px;bottom:34px;width:1px;transform:translateX(-50%);background:var(--mint-dark);opacity:.6}.race-marker span{position:absolute;top:-15px;left:50%;transform:translateX(-50%);font-family:var(--mono);font-size:6px;text-transform:uppercase}.latest-section{padding:58px 0 64px;background:var(--ink);color:var(--white)}.latest-grid{display:grid;grid-template-columns:300px 1fr;gap:48px}.latest-grid h2{margin:14px 0 0;font-size:clamp(42px,5.5vw,68px);line-height:.94}.latest-meta{display:grid;grid-template-columns:repeat(2,1fr);margin-top:22px;border-top:1px solid rgba(255,255,255,.28);border-bottom:1px solid rgba(255,255,255,.28)}.latest-meta div{padding:10px}.latest-meta strong,.latest-meta span{display:block;font-family:var(--mono)}.latest-meta span{font-size:7px;color:#aaa;text-transform:uppercase}.daily-grid{border-top:1px solid rgba(255,255,255,.4)}.day-row{display:grid;grid-template-columns:50px 1fr 40px;gap:14px;align-items:center;padding:11px 0;border-bottom:1px solid rgba(255,255,255,.28)}.day-row>span,.day-row>strong{font-family:var(--mono);font-size:9px;text-transform:uppercase}.day-row>strong{text-align:right}.day-bar-wrap{height:7px;background:rgba(255,255,255,.12)}.day-bar{height:100%;background:var(--mint)}
@media(max-width:850px){.analytics-hero{padding:34px 0 30px}.hero-grid{display:block}.analytics-hero h1{font-size:clamp(42px,11vw,58px)}.hero-meta{margin-top:16px;text-align:left;font-size:8px}.summary-section{padding:30px 0 34px}.summary-grid,.chart-grid,.latest-grid{grid-template-columns:1fr;gap:20px}.summary-label{display:flex;justify-content:space-between;align-items:baseline}.summary-label h2{margin:0;font-size:30px}.stat-grid{grid-template-columns:repeat(2,1fr)}.stat{padding:12px 10px 12px 0}.stat+.stat{padding-left:10px}.stat:nth-child(3){border-left:0;border-top:1px solid var(--ink);padding-left:0}.stat:nth-child(4){border-top:1px solid var(--ink)}.stat strong{font-size:26px}.stat span{font-size:7px}.chart-section{padding:38px 0 42px}.chart-heading h2{font-size:46px;margin:10px 0 7px}.interaction-note{display:none}.weekly-chart{grid-template-columns:repeat(var(--week-count),44px);gap:8px;padding:20px 0 2px;margin-right:-20px;padding-right:20px}.week-column{min-width:44px}.bar-area{height:145px}.bar{width:58%;max-width:24px}.week-column strong{font-size:7px}.week-column>span{font-size:6px}.race-marker{bottom:28px}.latest-section{padding:40px 0 46px}.latest-grid h2{font-size:42px}.latest-meta{margin-top:16px}.day-row{padding:9px 0}}
</style>