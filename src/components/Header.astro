---
import { site } from "../../data/site.js";
---

<header class="site-header">
  <div class="nav-wrap">
    <a class="brand" href="/">
      <span class="brand-mark">{site.shortName}</span>
    </a>

    <nav class="desktop-nav">
      {site.nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <details class="mobile-menu">
      <summary><span class="menu-open">Menu</span><span class="menu-close">Close</span></summary>
      <nav class="mobile-links">
        {site.nav.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    width: 100%;
    background: var(--beige-light);
    border-bottom: 1px solid var(--black);
  }

  .nav-wrap {
    width: 100%;
    max-width: var(--max-width);
    min-height: 66px;
    margin: 0 auto;
    padding: 0 var(--page-padding);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .brand {
    color: var(--black);
    text-decoration: none;
  }

  .brand-mark {
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -1px;
    line-height: 1;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .desktop-nav a {
    color: var(--black);
    text-decoration: none;
    text-transform: uppercase;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
  }

  .desktop-nav a:hover { opacity: .48; }

  .mobile-menu { display: none; }
  .mobile-menu summary {
    cursor: pointer;
    list-style: none;
    color: var(--black);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
  }
  .mobile-menu summary::-webkit-details-marker { display: none; }
  .menu-open { display: inline-block; }
  .menu-close { display: none; }
  .mobile-menu[open] .menu-open { display: none; }
  .mobile-menu[open] .menu-close { display: inline-block; }

  @media (max-width: 850px) {
    .desktop-nav { display: none; }
    .mobile-menu { display: block; position: static; }
    .brand-mark { font-size: 22px; }
    .mobile-links {
      position: absolute;
      top: 66px;
      left: 0;
      right: 0;
      z-index: 2000;
      width: 100%;
      display: flex;
      flex-direction: column;
      background: var(--beige-light);
      border-bottom: 1px solid var(--black);
    }
    .mobile-links a {
      display: flex;
      align-items: center;
      min-height: 54px;
      padding: 0 var(--page-padding);
      color: var(--black);
      text-decoration: none;
      text-transform: uppercase;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 1px;
      border-bottom: 1px solid var(--black);
    }
    .mobile-links a:last-child { border-bottom: none; }
    .mobile-links a:hover { background: var(--mint); }
  }
</style>
