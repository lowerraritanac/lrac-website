---
const { transparent = false } = Astro.props;
---

<header class:list={["site-header", { transparent }]}>
  <div class="nav-wrap">
    <a class="brand" href="/">
      <span class="brand-mark">LRAC</span>
      <span class="brand-name">Lower Raritan Athletic Club</span>
    </a>

    <nav class="desktop-nav">
      <a href="/athletes">Athletes</a>
      <a href="/racing">Racing</a>
      <a href="/training">Training</a>
      <a href="/about">About</a>
    </nav>

    <details class="mobile-menu">
      <summary><span class="menu-open">Menu</span><span class="menu-close">Close</span></summary>
      <nav class="mobile-links">
        <a href="/athletes">Athletes</a>
        <a href="/racing">Racing</a>
        <a href="/training">Training</a>
        <a href="/about">About</a>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    width: 100%;
    background: var(--mint);
    border-bottom: 1px solid var(--black);
  }

  .nav-wrap {
    width: 100%;
    max-width: var(--max-width);
    min-height: 66px;
    margin: 0 auto;
    padding: 0 var(--page-padding);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .brand {
    display: flex;
    align-items: baseline;
    gap: 14px;
    color: var(--black);
    text-decoration: none;
  }

  .brand-mark {
    font-size: 29px;
    font-weight: 900;
    letter-spacing: -1.8px;
    line-height: 1;
  }

  .brand-name {
    font-size: 9px;
    font-weight: 900;
    letter-spacing: 1.8px;
    text-transform: uppercase;
  }

  .desktop-nav { display: flex; align-items: center; gap: 28px; }
  .desktop-nav a {
    color: var(--black);
    text-decoration: none;
    text-transform: uppercase;
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 1.25px;
  }
  .desktop-nav a:hover { opacity: .48; }

  .mobile-menu { display: none; }
  .mobile-menu summary {
    cursor: pointer;
    list-style: none;
    color: var(--black);
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 1.25px;
    text-transform: uppercase;
  }
  .mobile-menu summary::-webkit-details-marker { display: none; }
  .menu-open { display: inline-block; }
  .menu-close { display: none; }
  .mobile-menu[open] .menu-open { display: none; }
  .mobile-menu[open] .menu-close { display: inline-block; }

  .site-header.transparent {
    position: absolute;
    top: 0;
    left: 0;
    background: transparent;
    border-bottom: 1px solid rgba(17,17,17,.35);
  }
  .site-header.transparent .brand,
  .site-header.transparent .desktop-nav a { color: var(--black); }

  @media (max-width: 850px) {
    .site-header,
    .site-header.transparent {
      position: sticky;
      top: 0;
      background: var(--mint);
      border-bottom: 1px solid var(--black);
    }
    .brand-name, .desktop-nav { display: none; }
    .mobile-menu { display: block; position: static; }
    .mobile-links {
      position: absolute;
      top: 66px;
      left: 0;
      right: 0;
      z-index: 2000;
      width: 100%;
      display: flex;
      flex-direction: column;
      background: var(--mint);
      border-bottom: 1px solid var(--black);
    }
    .mobile-links a {
      display: flex;
      align-items: center;
      min-height: 54px;
      padding: 0 var(--page-padding);
      color: var(--black);
      text-decoration: none;
      text-transform: uppercase;
      font-size: 11px;
      font-weight: 900;
      letter-spacing: 1.4px;
      border-bottom: 1px solid var(--black);
    }
    .mobile-links a:last-child { border-bottom: none; }
    .mobile-links a:hover { background: var(--beige-light); }
  }
</style>
