---
import { site } from "../../data/site.js";
const links = [
  { label: "Athletes", href: "/athletes" },
  { label: "Race Calendar & Results", href: "/racing" },
  { label: "Training & Writing", href: "/training" },
  { label: "About", href: "/about" },
  { label: "Coaching", href: "/coaching" },
];
const current = (href) => Astro.url.pathname === href || Astro.url.pathname.startsWith(href + '/');
---
<header class="club-header">
<div class="club-nav-wrap">
<a class="club-brand" href="/" aria-label="Lower Raritan Athletic Club home"><img src="/images/lr-charcoal.png" alt="" width="36" height="46" /><span>LOWER RARITAN<br/>ATHLETIC CLUB</span></a>
<nav class="club-desktop" aria-label="Main navigation">{links.map(link => <a class:list={[link.href === '/coaching' && 'club-coaching']} href={link.href} aria-current={current(link.href) ? 'page' : undefined}>{link.label}</a>)}</nav>
<details class="club-mobile"><summary>Menu <span aria-hidden="true">+</span></summary><nav aria-label="Mobile navigation">{links.map(link => <a href={link.href} aria-current={current(link.href) ? 'page' : undefined}>{link.label}<span aria-hidden="true">↗</span></a>)}</nav></details>
</div>
</header>
<style>
.club-header{position:sticky;top:0;z-index:1000;background:#f2f3e9;border-bottom:1px solid #bdc5b8;color:#233d2b;font-family:'DM Sans',Arial,sans-serif}
.club-nav-wrap{max-width:1320px;margin:auto;padding:16px 5%;display:flex;align-items:center;justify-content:space-between;gap:20px;position:relative;box-sizing:border-box}
.club-brand{display:flex;align-items:center;gap:12px;font:700 10px/1.5 'DM Sans',Arial,sans-serif;letter-spacing:.06em;color:inherit;text-decoration:none;flex-shrink:0}.club-brand img{width:36px;height:46px;object-fit:contain}
.club-desktop{display:flex;gap:4px;align-items:center}.club-desktop a{min-height:46px;display:flex;align-items:center;padding:0 13px;color:inherit;text-decoration:none;font-size:12px;font-weight:600;border-bottom:2px solid transparent;box-sizing:border-box}.club-desktop a:hover,.club-desktop a[aria-current=page]{background:#dce9d8;border-bottom-color:#233d2b}.club-desktop .club-coaching{background:#233d2b;color:#f2f3e9;margin-left:8px;padding-inline:20px}.club-desktop .club-coaching:hover,.club-desktop .club-coaching[aria-current=page]{background:#315944;color:#fff}.club-header a:focus-visible,.club-header summary:focus-visible{outline:3px solid #315944;outline-offset:3px}
.club-mobile{display:none}.club-mobile summary{cursor:pointer;list-style:none;min-height:46px;align-items:center;gap:18px;padding:0 16px;border:1px solid #233d2b;font-size:13px;font-weight:600}.club-mobile summary::-webkit-details-marker{display:none}.club-mobile summary span{font-size:22px}.club-mobile[open] summary span{transform:rotate(45deg)}.club-mobile nav{position:absolute;left:0;right:0;top:100%;background:#f2f3e9;border-bottom:1px solid #233d2b;padding:10px 5% 20px;box-shadow:0 12px 20px #233d2b12}.club-mobile nav a{display:flex;align-items:center;justify-content:space-between;gap:20px;min-height:50px;border-bottom:1px solid #bdc5b8;text-decoration:none;color:inherit;font-size:14px;font-weight:600}.club-mobile nav a:hover,.club-mobile nav a[aria-current=page]{background:#a8e6cf}
@media(max-width:1050px){.club-desktop{display:none}.club-mobile{display:block}.club-mobile summary{display:flex}.club-nav-wrap{padding-block:12px}}
</style>
<script>
const menu = document.querySelector<HTMLDetailsElement>('.club-mobile');
if (menu) {
 document.addEventListener('keydown', event => { if(event.key === 'Escape' && menu.open) {menu.open = false; menu.querySelector('summary')?.focus();} });
 document.addEventListener('click', event => { if (!event.composedPath().includes(menu)) menu.open = false; });
 menu.querySelector('nav')?.addEventListener('click', event => {if((event.target as Element).closest('a')) menu.open = false;});
 window.matchMedia('(max-width:1050px)').addEventListener('change', () => {menu.open = false;});
}
</script>
