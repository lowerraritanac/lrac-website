---
import { site } from '../../data/site.js';
---
<section class="club-activity" id="strava" aria-labelledby="strava-title">
<div class="activity-inner">
<div class="activity-copy"><p class="activity-label">06 / Strava club</p><h2 id="strava-title">The miles<br/>between races.</h2><p>Follow the club's training, see the latest activities, and join Lower Raritan on Strava.</p><a class="strava-link" href={site.social.strava} target="_blank" rel="noopener noreferrer">Join the Strava club <span aria-hidden="true">↗</span></a><a class="activity-fallback" href={site.social.strava} target="_blank" rel="noopener noreferrer">View all club activity on Strava ↗</a></div>
<div class="activity-feed"><div class="feed-heading"><span class="activity-dot" aria-hidden="true"></span> Club activity <span>STRAVA</span></div><iframe title="Lower Raritan Athletic Club latest Strava activity" src={site.social.stravaEmbed} width="300" height="454" loading="lazy" scrolling="no"></iframe></div>
</div>
</section>
<style>
.club-activity{background:#e2eddf;border-top:1px solid #adb5a5;padding:56px 0;color:#20382e}.activity-inner{max-width:1480px;margin:auto;padding:0 5%;display:grid;grid-template-columns:1fr 340px;gap:8%;align-items:center}.activity-label{font-size:10px;text-transform:uppercase;letter-spacing:.14em;font-weight:600;margin:0}.activity-copy h2{font:400 clamp(40px,5vw,68px)/1.04 Georgia,serif;letter-spacing:-.045em;margin:22px 0}.activity-copy>p:not(.activity-label){max-width:440px;font-size:16px;line-height:1.7;margin:0 0 26px}.strava-link{display:inline-flex;align-items:center;gap:36px;background:#20382e;color:#fff;padding:16px 22px;min-height:48px;font-size:13px;font-weight:600;text-decoration:none}.strava-link:hover{background:#315944;text-decoration:none}.activity-fallback{display:block;width:fit-content;font-size:12px;text-decoration:underline;text-underline-offset:4px;margin-top:20px}.activity-feed{background:#fff;border:1px solid #adb5a5;width:100%;max-width:340px}.feed-heading{display:flex;align-items:center;gap:9px;font-size:11px;padding:16px;border-bottom:1px solid #d7ded2}.feed-heading>span:last-child{margin-left:auto;font-size:10px;font-weight:700;letter-spacing:.08em}.activity-dot{width:7px;height:7px;background:#fc4c02;border-radius:50%}.activity-feed iframe{display:block;width:300px;max-width:100%;height:454px;margin:auto;border:0}.club-activity a:focus-visible{outline:3px solid #315944;outline-offset:4px}@media(max-width:760px){.club-activity{padding:36px 0}.activity-inner{grid-template-columns:1fr;gap:30px}.activity-feed{max-width:100%}.activity-copy h2{font-size:44px}.activity-copy>p:not(.activity-label){font-size:15px}}
</style>
