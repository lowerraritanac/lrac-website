---
const { athlete, showBackground = false } = Astro.props;
const marks = athlete.featuredMarks ?? athlete.prs.slice(0, 3);
---

<a class="athlete-card" href={`/athletes/${athlete.slug}`}>
  <div class="athlete-image">
    <img src={athlete.image} alt={athlete.name} loading="lazy" />
    <span class="card-cue">View profile →</span>
  </div>

  <div class="athlete-meta">
    <div class="athlete-kicker">
      <span>{athlete.sport}</span>
      <span class="athlete-location">{athlete.location}</span>
    </div>

    <h3>{athlete.name}<span class="name-arrow"> →</span></h3>

    {showBackground && <p class="background">{athlete.background}</p>}

    <div class:list={["mark-row", { single: marks.length === 1 }]}>
      {marks.map(([event, mark]) => (
        <div class="mark-item">
          <strong>{mark}</strong>
          <span>{event}</span>
        </div>
      ))}
    </div>
  </div>
</a>

<style>
  .athlete-card { display: block; min-width: 0; color: var(--ink); text-decoration: none; }
  .athlete-image { position: relative; overflow: hidden; background: #d8d2c5; border-bottom: 1px solid var(--ink); }
  .athlete-image img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; filter: saturate(.76) contrast(1.04); transition: filter .2s ease, transform .25s ease; }
  .card-cue { position: absolute; right: 9px; bottom: 9px; padding: 5px 7px; background: rgba(17,17,15,.88); color: var(--white); font-family: var(--mono); font-size: 7px; font-weight: 600; letter-spacing: .05em; text-transform: uppercase; opacity: 0; transform: translateY(4px); transition: opacity .15s ease, transform .15s ease; }
  .athlete-card:hover .athlete-image img { filter: saturate(.96) contrast(1.03); transform: scale(1.012); }
  .athlete-card:hover .card-cue, .athlete-card:focus-visible .card-cue { opacity: 1; transform: translateY(0); }
  .athlete-meta { min-width: 0; padding-top: 11px; }
  .athlete-kicker { display: flex; justify-content: space-between; gap: 14px; min-width: 0; font-family: var(--mono); font-size: 8px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; }
  .athlete-kicker span { min-width: 0; }
  h3 { margin: 9px 0 0; min-width: 0; font-family: var(--editorial); font-size: clamp(34px, 3.5vw, 50px); font-weight: 600; line-height: .94; letter-spacing: -.035em; overflow-wrap: anywhere; }
  .name-arrow { font-family: var(--mono); font-size: .42em; vertical-align: middle; }
  .background { margin: 12px 0 0; color: var(--gray); font-size: 15px; line-height: 1.45; }
  .mark-row { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: 16px; border-top: 1px solid var(--ink); }
  .mark-row.single { grid-template-columns: 1fr; }
  .mark-item { min-width: 0; padding: 9px 10px 0 0; }
  .mark-item + .mark-item { padding-left: 10px; border-left: 1px solid var(--ink); }
  .mark-item strong, .mark-item span { display: block; font-family: var(--mono); }
  .mark-item strong { font-size: 14px; line-height: 1; }
  .mark-item span { margin-top: 4px; color: var(--gray); font-size: 7px; line-height: 1.2; letter-spacing: .05em; text-transform: uppercase; }

  @media (max-width: 850px) {
    .athlete-card { overflow: hidden; }
    .athlete-meta { padding-top: 8px; }
    .athlete-kicker { display: block; font-size: 6.5px; line-height: 1.3; letter-spacing: .04em; }
    .athlete-location { display: none !important; }
    h3 { margin-top: 5px; max-width: 100%; font-size: clamp(20px, 5.5vw, 28px); line-height: .96; letter-spacing: -.025em; }
    .name-arrow { font-size: .48em; }
    .card-cue { display: none; }
    .mark-row, .background { display: none !important; }
  }
</style>
