---
import { site } from "../../data/site.js";
---

<footer>
  <div class="footer-inner">
    <div>
      <strong>{site.shortName}</strong>
      <p>{site.name}</p>
    </div>

    <div class="footer-links">
      <a href="/">Home</a>
      {site.nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </div>
  </div>
</footer>

<style>
  footer { background: var(--black); color: var(--white); padding: 48px 0; }
  .footer-inner { max-width: var(--max-width); margin: auto; padding: 0 var(--page-padding); display: flex; justify-content: space-between; align-items: flex-end; }
  footer strong { font-size: 34px; }
  footer p { margin: 7px 0 0; color: #999; }
  .footer-links { display: flex; gap: 24px; }
  .footer-links a { color: var(--white); text-decoration: none; font-size: 10px; font-weight: 900; letter-spacing: 1.2px; text-transform: uppercase; }

  @media (max-width: 850px) {
    .footer-inner { flex-direction: column; align-items: flex-start; gap: 30px; }
    .footer-links { flex-wrap: wrap; }
  }
</style>
